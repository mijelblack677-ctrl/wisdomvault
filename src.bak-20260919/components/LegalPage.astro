---
interface Props {
  title: string;
  subtitle: string;
  updated: string;
}
const { title, subtitle, updated } = Astro.props;
---

<section class="legal">
  <header class="legal__header">
    <a href="/" class="legal__brand">
      <svg class="legal__brand-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <span>Wisdom Vault</span>
    </a>
    <nav class="legal__nav">
      <a href="/login" class="legal__nav-link">Login</a>
      <a href="/register" class="legal__nav-cta">Get Started</a>
    </nav>
  </header>

  <main class="legal__main">
    <div class="legal__card">
      <h1 class="legal__title">{title}</h1>
      <p class="legal__subtitle">{subtitle}</p>
      <p class="legal__updated">Last updated: {updated}</p>
      <div class="legal__content">
        <slot />
      </div>
    </div>
  </main>

  <footer class="legal__footer">
    <span>BETTER LEARNERS &nbsp;&bull;&nbsp; BRIGHTER FUTURES</span>
  </footer>
</section>

<style>
  .legal {
    min-height: 100vh;
    min-height: 100dvh;
    background: #f7f1ec;
    font-family: 'Inter', 'Poppins', sans-serif;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-x: hidden;
  }

  .legal::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('/images/warm-books.jpg') center/cover no-repeat;
    filter: blur(6px) brightness(0.35);
    z-index: 0;
  }

  .legal::after {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, rgba(247,241,236,0.78) 0%, rgba(237,228,221,0.68) 50%, rgba(247,241,236,0.78) 100%);
    z-index: 0;
  }

  .legal > * { position: relative; z-index: 1; }

  .legal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
  }

  .legal__brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 800;
    color: #2d2327;
    text-decoration: none;
  }
  .legal__brand-icon { color: #c09a8a; }

  .legal__nav { display: flex; align-items: center; gap: 18px; }
  .legal__nav-link { font-size: 13px; font-weight: 500; color: #5a4a4a; text-decoration: none; }
  .legal__nav-link:hover { color: #2d2327; }
  .legal__nav-cta {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, #d6b8a8, #c09a8a);
    padding: 9px 18px;
    border-radius: 20px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(192, 154, 138, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .legal__nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(192, 154, 138, 0.4); }

  .legal__main {
    flex: 1;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 24px 20px 48px;
  }

  .legal__card {
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 18px;
    padding: 36px 36px 44px;
    box-shadow: 0 8px 32px rgba(45, 35, 39, 0.08);
    backdrop-filter: blur(20px);
  }

  .legal__title {
    font-size: 30px;
    font-weight: 800;
    color: #2d2327;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }

  .legal__subtitle { font-size: 14px; color: #8a7a72; margin: 0 0 10px; }

  .legal__updated {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    color: #c09a8a;
    background: rgba(192, 154, 138, 0.12);
    border-radius: 20px;
    padding: 4px 12px;
    margin: 0 0 24px;
  }

  .legal__content h2 {
    font-size: 17px;
    font-weight: 700;
    color: #2d2327;
    margin: 26px 0 8px;
  }

  .legal__content h2:first-child { margin-top: 0; }

  .legal__content p {
    font-size: 13.5px;
    line-height: 1.7;
    color: #5a4a4a;
    margin: 0 0 12px;
  }

  .legal__content ul, .legal__content ol {
    margin: 0 0 12px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legal__content li {
    font-size: 13.5px;
    line-height: 1.6;
    color: #5a4a4a;
  }

  .legal__content a {
    color: #c09a8a;
    text-decoration: none;
    font-weight: 600;
  }
  .legal__content a:hover { text-decoration: underline; }

  .legal__footer { padding: 24px; text-align: center; }
  .legal__footer span {
    font-size: 8px;
    font-weight: 600;
    color: #b0a098;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .legal__card { padding: 26px 22px 32px; }
    .legal__title { font-size: 24px; }
    .legal__nav-link { display: none; }
  }
</style>