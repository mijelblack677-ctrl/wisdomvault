---
// 3D Carousel Component - Flipping Coins
---

<div class="carousel-container">
  <div class="carousel">
    <div class="carousel__item carousel__item--1"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
    <div class="carousel__item carousel__item--2"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></div>
    <div class="carousel__item carousel__item--3"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg></div>
    <div class="carousel__item carousel__item--4"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div>
    <div class="carousel__item carousel__item--5"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
    <div class="carousel__item carousel__item--6"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
    <div class="carousel__item carousel__item--7"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg></div>
    <div class="carousel__item carousel__item--8"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg></div>
  </div>
</div>

<style>
  .carousel-container {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    max-width: 400px;
    height: 350px;
    margin: 0 auto;
  }

  .carousel {
    position: relative;
    width: 300px;
    height: 300px;
    animation: rotateCarousel 20s linear infinite;
    transform-style: preserve-3d;
  }

  .carousel__item {
    position: absolute;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 215, 0, 0.04);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    animation: flipItem 3s ease-in-out infinite;
    transform-style: preserve-3d;
    backface-visibility: visible;
  }

  .carousel__item--1 { transform: rotateY(0deg) translateZ(150px); animation-delay: 0s; }
  .carousel__item--2 { transform: rotateY(45deg) translateZ(150px); animation-delay: 0.5s; }
  .carousel__item--3 { transform: rotateY(90deg) translateZ(150px); animation-delay: 1s; }
  .carousel__item--4 { transform: rotateY(135deg) translateZ(150px); animation-delay: 1.5s; }
  .carousel__item--5 { transform: rotateY(180deg) translateZ(150px); animation-delay: 2s; }
  .carousel__item--6 { transform: rotateY(225deg) translateZ(150px); animation-delay: 2.5s; }
  .carousel__item--7 { transform: rotateY(270deg) translateZ(150px); animation-delay: 3s; }
  .carousel__item--8 { transform: rotateY(315deg) translateZ(150px); animation-delay: 3.5s; }

  @keyframes rotateCarousel {
    0% { transform: rotateY(0deg); }
    100% { transform: rotateY(360deg); }
  }

  @keyframes flipItem {
    0%, 100% { transform: rotateY(0deg) scale(1); opacity: 0.7; }
    50% { transform: rotateY(180deg) scale(1.15); opacity: 1; }
  }

  /* Glow center */
  .carousel-container::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, rgba(255, 215, 0, 0.04), transparent 70%);
    border-radius: 50%;
    z-index: 0;
    animation: centerPulse 4s ease-in-out infinite;
  }

  @keyframes centerPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
    50% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
  }

  @media (max-width: 768px) {
    .carousel-container { height: 250px; max-width: 300px; }
    .carousel { width: 200px; height: 200px; }
    .carousel__item { width: 55px; height: 55px; font-size: 26px; }
    .carousel__item--1,
    .carousel__item--2,
    .carousel__item--3,
    .carousel__item--4,
    .carousel__item--5,
    .carousel__item--6,
    .carousel__item--7,
    .carousel__item--8 {
      transform: rotateY(var(--angle)) translateZ(100px);
    }
    .carousel-container::before { width: 80px; height: 80px; }
  }

  @media (max-width: 480px) {
    .carousel-container { height: 200px; max-width: 250px; }
    .carousel { width: 160px; height: 160px; }
    .carousel__item { width: 45px; height: 45px; font-size: 20px; }
    .carousel__item--1,
    .carousel__item--2,
    .carousel__item--3,
    .carousel__item--4,
    .carousel__item--5,
    .carousel__item--6,
    .carousel__item--7,
    .carousel__item--8 {
      transform: rotateY(var(--angle)) translateZ(80px);
    }
    .carousel-container::before { width: 60px; height: 60px; }
  }
</style>

<script>
  // Set angle variables for each carousel item
  document.addEventListener('DOMContentLoaded', function() {
    const items = document.querySelectorAll('.carousel__item');
    const angles = [0, 45, 90, 135, 180, 225, 270, 315];
    items.forEach((item, i) => {
      item.style.setProperty('--angle', angles[i] + 'deg');
    });
  });
</script>
