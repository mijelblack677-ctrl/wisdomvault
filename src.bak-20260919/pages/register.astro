---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="register-page">
    <!-- 1. TOP HERO -->
    <section class="hero">
      <div class="hero__left">
        <div class="hero__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#c09a8a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="8.5" cy="7" r="4"/>
            <line x1="20" y1="8" x2="20" y2="14"/>
            <line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
        </div>
        <h1 class="hero__heading">
          <span class="hero__line hero__line--dark">Start</span>
          <span class="hero__line hero__line--dark">Your</span>
          <span class="hero__line hero__line--accent">Journey</span>
        </h1>
        <p class="hero__subtitle">Create your account<br/>and begin learning today.</p>
      </div>

      <div class="hero__right">
        <svg class="hero__scene" viewBox="0 0 200 240" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="140" cy="180" r="120" stroke="rgba(192,154,138,0.12)" stroke-width="2" fill="none"/>
          <circle cx="140" cy="180" r="90" stroke="rgba(192,154,138,0.06)" stroke-width="1.5" fill="none"/>
          <rect x="20" y="180" width="170" height="4" rx="2" fill="rgba(45,35,39,0.08)"/>
          <line x1="165" y1="100" x2="165" y2="180" stroke="rgba(45,35,39,0.12)" stroke-width="2"/>
          <ellipse cx="165" cy="98" rx="18" ry="10" fill="rgba(192,154,138,0.15)"/>
          <ellipse cx="165" cy="98" rx="12" ry="6" fill="rgba(192,154,138,0.25)"/>
          <circle cx="165" cy="105" r="40" fill="rgba(192,154,138,0.04)"/>
          <rect x="30" y="155" width="70" height="45" rx="3" fill="rgba(45,35,39,0.06)" stroke="rgba(45,35,39,0.08)" stroke-width="1"/>
          <rect x="34" y="159" width="62" height="30" rx="1" fill="rgba(192,154,138,0.04)"/>
          <rect x="25" y="200" width="80" height="3" rx="1.5" fill="rgba(45,35,39,0.06)"/>
          <rect x="110" y="148" width="40" height="10" rx="2" fill="rgba(45,35,39,0.1)" stroke="rgba(45,35,39,0.06)" stroke-width="0.5"/>
          <rect x="112" y="149" width="36" height="1" fill="rgba(192,154,138,0.3)"/>
          <rect x="108" y="158" width="44" height="10" rx="2" fill="rgba(45,35,39,0.08)" stroke="rgba(45,35,39,0.06)" stroke-width="0.5"/>
          <rect x="110" y="159" width="40" height="1" fill="rgba(192,154,138,0.2)"/>
          <rect x="112" y="168" width="40" height="10" rx="2" fill="rgba(45,35,39,0.06)" stroke="rgba(45,35,39,0.06)" stroke-width="0.5"/>
          <rect x="114" y="169" width="36" height="1" fill="rgba(192,154,138,0.25)"/>
          <rect x="155" y="168" width="14" height="14" rx="2" fill="rgba(45,35,39,0.08)"/>
          <path d="M162 168 C162 155 150 152 155 145" stroke="rgba(90,130,90,0.35)" stroke-width="1.5" fill="none"/>
          <path d="M162 168 C162 158 172 150 168 142" stroke="rgba(90,130,90,0.28)" stroke-width="1.5" fill="none"/>
          <path d="M162 168 C160 160 168 155 162 148" stroke="rgba(90,140,90,0.22)" stroke-width="1" fill="none"/>
          <circle cx="153" cy="144" r="4" fill="rgba(90,130,90,0.18)"/>
          <circle cx="169" cy="141" r="3.5" fill="rgba(90,130,90,0.14)"/>
        </svg>
      </div>
    </section>

    <!-- 2. REGISTRATION CARD -->
    <section class="card">
      <h2 class="card__title"><span class="card__title--dark">Create</span> <span class="card__title--accent">Account</span></h2>
      <p class="card__subtitle">Join our community of lifelong learners</p>

      <form id="register-form" class="card__form">
        <div class="field">
          <label class="field__label">Full Name</label>
          <div class="field__input">
            <svg class="field__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <input type="text" id="reg-fullname" class="field__control" placeholder="Enter your full name" required autocomplete="name" />
          </div>
        </div>

        <!-- Email field with icon -->
        <div class="field">
          <label class="field__label">Email Address</label>
          <div class="field__input">
            <svg class="field__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <input type="email" id="reg-email" class="field__control" placeholder="Enter your email address" required autocomplete="email" />
          </div>
        </div>

        <!-- Phone field with icon -->
        <div class="field">
          <label class="field__label">Phone Number</label>
          <div class="field__input">
            <svg class="field__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <input type="tel" id="reg-phone" class="field__control" placeholder="Enter your phone number" required autocomplete="tel" />
          </div>
        </div>

        <!-- Password field with toggle -->
        <div class="field">
          <label class="field__label">Password</label>
          <div class="field__input">
            <input type="password" id="reg-password" class="field__control field__control--pw" placeholder="Create a password (min 6 chars)" required minlength="6" autocomplete="new-password" />
            <button type="button" class="field__toggle" data-target="reg-password" aria-label="Toggle password">
              <svg class="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-closed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Confirm Password field with toggle -->
        <div class="field">
          <label class="field__label">Confirm Password</label>
          <div class="field__input">
            <input type="password" id="reg-confirm" class="field__control field__control--pw" placeholder="Confirm your password" required minlength="6" autocomplete="new-password" />
            <button type="button" class="field__toggle" data-target="reg-confirm" aria-label="Toggle password">
              <svg class="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-closed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Referral Code field with icon -->
        <div class="field">
          <label class="field__label">Referral Code <span class="field__optional">(optional)</span></label>
          <div class="field__input">
            <svg class="field__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8a7a72" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0-5 5v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2a5 5 0 0 0-5-5"/>
              <circle cx="12" cy="9" r="3"/>
            </svg>
            <input type="text" id="reg-referral" class="field__control" placeholder="Enter referral code" />
          </div>
        </div>

        <!-- Terms checkbox - styled like login -->
        <label class="terms">
          <input type="checkbox" id="reg-terms" class="terms__check" required />
          <span class="terms__box"></span>
          <span class="terms__text">I agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a></span>
        </label>

        <button type="submit" class="btn-signin" id="reg-submit">
          <span>Create Account</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

        <div id="reg-message" class="card__message" style="display:none;"></div>
      </form>

      <div class="divider">
        <span class="divider__line"></span>
        <span class="divider__text">OR</span>
        <span class="divider__line"></span>
      </div>

      <button type="button" class="btn-google">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <span>Continue with Google</span>
      </button>

      <p class="card__register">Already have an account? <a href="/login" class="card__register-link">Sign in</a></p>
    </section>

    <footer class="footer">
      <span>BETTER LEARNERS &nbsp;&bull;&nbsp; BRIGHTER FUTURES</span>
    </footer>
  </div>

  <!-- 3. CONSENT POPUP -->
  <div class="consent-overlay" id="consent-overlay" hidden>
    <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consent-title" tabindex="-1">
      <div class="consent-modal__header">
        <div class="consent-modal__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c09a8a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="consent-modal__title" id="consent-title">Consent &amp; Terms</h3>
        <p class="consent-modal__subtitle">Please read carefully. You must agree to create an account.</p>
      </div>

      <div class="consent-modal__body">
        <p class="consent-modal__lead">By clicking <strong>I Agree</strong>, you confirm that you have read and understood the following:</p>
        <ol class="consent-modal__list">
          <li><strong>Terms &amp; Privacy:</strong> You agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a> and will use the platform lawfully.</li>
          <li><strong>Personal data:</strong> You consent to the collection, processing and storage of your personal information (name, email, phone number and account activity) for account management, payments, referrals and platform communications.</li>
          <li><strong>Paid membership:</strong> This is a paid membership service. You agree to pay applicable membership or renewal fees, and access to paid content continues only while your membership is active.</li>
          <li><strong>Non-refundable fees:</strong> Membership and other fees are non-refundable once paid. Please be sure you understand what you are paying for before you complete any payment.</li>
          <li><strong>Referrals &amp; earnings:</strong> You understand referral bonuses and rewards depend on program activity and eligibility, and are never guaranteed.</li>
          <li><strong>Communications:</strong> You consent to receiving account-related communications by email and SMS about your membership, payments and platform updates.</li>
          <li><strong>Responsible use:</strong> You agree not to misuse the platform, create fraudulent accounts or harm other users.</li>
          <li><strong>Age:</strong> You confirm you are at least 18 years old, or have the consent of a parent or guardian.</li>
        </ol>
        <p class="consent-modal__foot">If you disagree with any of the above, select <strong>Disagree</strong> — you will not be able to create an account.</p>
      </div>

      <div class="consent-modal__actions">
        <button type="button" class="btn-consent btn-consent--disagree" id="consent-disagree">Disagree</button>
        <button type="button" class="btn-consent btn-consent--agree" id="consent-agree">I Agree</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .register-page {
    min-height: 100vh;
    min-height: 100dvh;
    background: #f7f1ec;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: 'Inter', 'Poppins', sans-serif;
    overflow-x: hidden;
    position: relative;
  }

  .register-page::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('/images/warm-books.jpg') center/cover no-repeat;
    filter: blur(6px) brightness(0.35);
    z-index: 0;
  }

  .register-page::after {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg, rgba(247,241,236,0.75) 0%, rgba(237,228,221,0.65) 50%, rgba(247,241,236,0.75) 100%);
    z-index: 0;
  }

  .register-page > * { position: relative; z-index: 1; }

  .hero {
    width: 100%;
    max-width: 390px;
    min-height: 32vh;
    padding: 70px 24px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
  }

  .hero__left { flex: 1; z-index: 1; }
  .hero__icon { margin-bottom: 20px; }
  .hero__heading { display: flex; flex-direction: column; line-height: 0.95; margin-bottom: 14px; }
  .hero__line { font-size: 44px; font-weight: 900; letter-spacing: -0.02em; }
  .hero__line--dark { color: #2d2327; }
  .hero__line--accent { color: #c09a8a; }
  .hero__subtitle { font-size: 17px; color: #5a4a4a; line-height: 1.5; }
  .hero__right { width: 120px; flex-shrink: 0; margin-top: 10px; opacity: 0.9; }
  .hero__scene { width: 100%; height: auto; }

  .card {
    width: calc(100% - 40px);
    max-width: 350px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 18px;
    padding: 28px;
    box-shadow: 0 8px 32px rgba(45, 35, 39, 0.08);
    backdrop-filter: blur(20px);
    margin-top: auto;
  }

  .card__title { font-size: 26px; font-weight: 800; margin-bottom: 4px; }
  .card__title--dark { color: #2d2327; }
  .card__title--accent { color: #c09a8a; }
  .card__subtitle { font-size: 13px; color: #5a4a4a; margin-bottom: 24px; }

  .field { margin-bottom: 10px; }
  .field__label { display: block; font-size: 10px; font-weight: 600; color: #8a7a72; margin-bottom: 6px; letter-spacing: 0.02em; }
  .field__input { position: relative; display: flex; align-items: center; }
  .field__icon { position: absolute; left: 12px; pointer-events: none; z-index: 1; }
  .field__control {
    width: 100%;
    height: 42px;
    padding: 0 12px 0 38px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(45, 35, 39, 0.08);
    border-radius: 7px;
    font-size: 14px;
    color: #2d2327;
    outline: none;
    font-family: 'Inter', sans-serif;
    transition: border-color 0.2s;
  }
  .field__control::placeholder { color: #b0a098; }
  .field__control:focus { border-color: #c09a8a; }
  .field__control--pw { padding-left: 12px; padding-right: 40px; }
  .field__toggle { 
    position: absolute; 
    right: 10px; 
    background: none; 
    border: none; 
    padding: 4px; 
    cursor: pointer; 
    display: flex; 
    align-items: center; 
    justify-content: center;
    z-index: 1;
  }

  .field__optional { font-weight: 400; color: #b0a098; font-size: 9px; }

  /* Terms checkbox - matching login style */
  .terms { display: flex; align-items: flex-start; gap: 10px; margin: 6px 0 14px; cursor: pointer; }
  .terms__check { position: absolute; opacity: 0; width: 0; height: 0; }
  .terms__box { 
    width: 16px; 
    height: 16px; 
    border: 2px solid rgba(45, 35, 39, 0.2); 
    border-radius: 4px; 
    flex-shrink: 0; 
    margin-top: 1px; 
    transition: all 0.2s ease; 
    position: relative; 
  }
  .terms__check:checked + .terms__box { background: #c09a8a; border-color: #c09a8a; }
  .terms__check:checked + .terms__box::after { 
    content: '✓'; 
    position: absolute; 
    top: 50%; 
    left: 50%; 
    transform: translate(-50%, -50%); 
    color: white; 
    font-size: 11px; 
    font-weight: 700; 
  }
  .terms__text { font-size: 11px; color: #5a4a4a; line-height: 1.4; }
  .terms__text a { color: #c09a8a; text-decoration: none; font-weight: 500; }
  .terms__text a:hover { text-decoration: underline; }

  .btn-signin {
    width: 100%;
    height: 42px;
    background: linear-gradient(135deg, #d6b8a8, #c09a8a);
    border: none;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(192, 154, 138, 0.25);
    margin-top: 4px;
  }
  .btn-signin:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(192, 154, 138, 0.35); }
  .btn-signin:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .card__message { margin-top: 10px; padding: 10px 12px; border-radius: 8px; font-size: 12px; text-align: center; }
  .card__message--success { background: rgba(76,175,80,0.1); color: #2e7d32; }
  .card__message--error { background: rgba(239,68,68,0.1); color: #c62828; }

  .divider { display: flex; align-items: center; gap: 12px; margin: 14px 0; }
  .divider__line { flex: 1; height: 1px; background: rgba(45, 35, 39, 0.1); }
  .divider__text { font-size: 9px; color: #8a7a72; letter-spacing: 0.1em; font-weight: 600; }

  .btn-google {
    width: 100%;
    height: 42px;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(45, 35, 39, 0.12);
    border-radius: 21px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #2d2327;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-google:hover { background: rgba(255, 255, 255, 1); border-color: rgba(45, 35, 39, 0.2); }

  .card__register { text-align: center; margin-top: 16px; font-size: 11px; color: #8a7a72; }
  .card__register-link { color: #c09a8a; text-decoration: none; font-weight: 600; }
  .card__register-link:hover { text-decoration: underline; }

  .footer { padding: 24px; text-align: center; }
  .footer span { font-size: 8px; font-weight: 600; color: #b0a098; letter-spacing: 3px; text-transform: uppercase; }

  /* Consent popup */
  .consent-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(45, 35, 39, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .consent-overlay[hidden] { display: none; }

  .consent-modal {
    width: 100%;
    max-width: 440px;
    max-height: 84vh;
    background: #fffdfb;
    border: 1px solid rgba(192, 154, 138, 0.35);
    border-radius: 18px;
    box-shadow: 0 24px 64px rgba(45, 35, 39, 0.3);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .consent-modal__header {
    padding: 20px 24px 14px;
    text-align: center;
    border-bottom: 1px solid rgba(45, 35, 39, 0.08);
  }
  .consent-modal__icon { margin-bottom: 8px; }
  .consent-modal__title { font-size: 20px; font-weight: 800; color: #2d2327; margin: 0 0 4px; }
  .consent-modal__subtitle { font-size: 12px; color: #8a7a72; margin: 0; }

  .consent-modal__body {
    padding: 18px 24px;
    overflow-y: auto;
    flex: 1;
  }
  .consent-modal__lead { font-size: 13px; color: #5a4a4a; margin: 0 0 10px; }
  .consent-modal__list { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 10px; }
  .consent-modal__list li { font-size: 12.5px; line-height: 1.55; color: #5a4a4a; }
  .consent-modal__list a { color: #c09a8a; text-decoration: none; font-weight: 600; }
  .consent-modal__list a:hover { text-decoration: underline; }
  .consent-modal__foot { font-size: 12.5px; color: #5a4a4a; margin: 14px 0 0; }

  .consent-modal__actions {
    padding: 14px 24px 20px;
    display: flex;
    gap: 12px;
    border-top: 1px solid rgba(45, 35, 39, 0.08);
    background: #fffdfb;
  }
  .btn-consent {
    flex: 1;
    height: 44px;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-consent--agree {
    background: linear-gradient(135deg, #d6b8a8, #c09a8a);
    border: none;
    color: #ffffff;
    box-shadow: 0 4px 16px rgba(192, 154, 138, 0.3);
  }
  .btn-consent--agree:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(192, 154, 138, 0.4); }
  .btn-consent--disagree {
    background: transparent;
    border: 1px solid rgba(45, 35, 39, 0.2);
    color: #5a4a4a;
  }
  .btn-consent--disagree:hover { background: rgba(45, 35, 39, 0.05); }

  @media (min-width: 768px) {
    .register-page { justify-content: center; }
    .hero { min-height: auto; padding: 60px 24px 30px; }
    .card { margin-top: 0; }
  }
</style>

<script>
  // Auto-fill referral code from URL parameter
  const urlParams = new URLSearchParams(window.location.search);
  const refCode = urlParams.get('ref');
  if (refCode) {
    const refInput = document.getElementById('reg-referral');
    if (refInput) refInput.value = refCode;
  }

  // Toggle password visibility
  document.querySelectorAll('.field__toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      const target = document.getElementById(targetId);
      if (!target) return;
      const vis = target.type === 'text';
      target.type = vis ? 'password' : 'text';
      const eyeOpen = btn.querySelector('.eye-open');
      const eyeClosed = btn.querySelector('.eye-closed');
      if (eyeOpen) eyeOpen.style.display = vis ? 'block' : 'none';
      if (eyeClosed) eyeClosed.style.display = vis ? 'none' : 'block';
    });
  });

  const form = document.getElementById('register-form');
  const btn = document.getElementById('reg-submit');
  const msg = document.getElementById('reg-message');

  // --- Consent popup ---
  const consentOverlay = document.getElementById('consent-overlay');
  const consentAgree = document.getElementById('consent-agree');
  const consentDisagree = document.getElementById('consent-disagree');

  function openConsentModal() {
    if (!consentOverlay) return;
    consentOverlay.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeConsentModal() {
    if (!consentOverlay) return;
    consentOverlay.hidden = true;
    document.body.style.overflow = '';
  }

  consentAgree?.addEventListener('click', () => {
    closeConsentModal();
    submitRegistration();
  });

  consentDisagree?.addEventListener('click', () => {
    closeConsentModal();
    if (msg) {
      msg.textContent = 'You must agree to the consent and terms to create an account. If you disagree, you cannot register.';
      msg.className = 'card__message card__message--error';
      msg.style.display = 'block';
    }
  });

  // Clicking the dark backdrop or pressing Escape closes the popup (no consent given yet)
  consentOverlay?.addEventListener('click', (e) => {
    if (e.target === consentOverlay) closeConsentModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && consentOverlay && !consentOverlay.hidden) closeConsentModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (msg) msg.style.display = 'none';

    const fullName = (document.getElementById('reg-fullname') || {}).value?.trim?.() || '';
    const email = (document.getElementById('reg-email') || {}).value?.trim?.() || '';
    const phone = (document.getElementById('reg-phone') || {}).value?.trim?.() || '';
    const password = (document.getElementById('reg-password') || {}).value || '';
    const confirm = (document.getElementById('reg-confirm') || {}).value || '';
    const referral = (document.getElementById('reg-referral') || {}).value?.trim?.() || '';
    const terms = (document.getElementById('reg-terms') || {}).checked || false;

    if (!fullName || !email || !phone || !password || !confirm) {
      if (msg) {
        msg.textContent = 'Please fill in all fields.';
        msg.className = 'card__message card__message--error';
        msg.style.display = 'block';
      }
      return;
    }

    if (password.length < 6) {
      if (msg) {
        msg.textContent = 'Password must be at least 6 characters.';
        msg.className = 'card__message card__message--error';
        msg.style.display = 'block';
      }
      return;
    }

    if (password !== confirm) {
      if (msg) {
        msg.textContent = 'Passwords do not match.';
        msg.className = 'card__message card__message--error';
        msg.style.display = 'block';
      }
      return;
    }

    if (!terms) {
      if (msg) {
        msg.textContent = 'Please agree to the Terms of Service.';
        msg.className = 'card__message card__message--error';
        msg.style.display = 'block';
      }
      return;
    }

    // Show the consent popup — the account is only created after the user agrees
    openConsentModal();
  });

  async function submitRegistration() {
    const fullName = (document.getElementById('reg-fullname') || {}).value?.trim?.() || '';
    const email = (document.getElementById('reg-email') || {}).value?.trim?.() || '';
    const phone = (document.getElementById('reg-phone') || {}).value?.trim?.() || '';
    const password = (document.getElementById('reg-password') || {}).value || '';
    const referral = (document.getElementById('reg-referral') || {}).value?.trim?.() || '';

    btn.disabled = true;
    const span = btn.querySelector('span');
    if (span) span.textContent = 'Creating account...';

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fullName,
          email,
          phone,
          password,
          referralCode: referral || undefined,
          consent: true, // explicit consent given in the popup
        }),
      });

      const data = await res.json();

      if (data.success) {
        if (msg) {
          msg.textContent = `Welcome, ${data.user.fullName}! Redirecting...`;
          msg.className = 'card__message card__message--success';
          msg.style.display = 'block';
        }
        localStorage.setItem('wisdom_vault_user', JSON.stringify(data.user));
        if (data.token) {
          localStorage.setItem('wisdom_vault_session', data.token);
        }
        setTimeout(() => { window.location.href = '/billing'; }, 1000);
      } else {
        if (msg) {
          msg.textContent = data.message || 'Registration failed.';
          msg.className = 'card__message card__message--error';
          msg.style.display = 'block';
        }
      }
    } catch (err) {
      if (msg) {
        msg.textContent = 'Network error. Please try again.';
        msg.className = 'card__message card__message--error';
        msg.style.display = 'block';
      }
    } finally {
      btn.disabled = false;
      if (span) span.textContent = 'Create Account';
    }
  }
</script>
