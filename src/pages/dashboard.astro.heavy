                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </span>
            Earnings
          </button>
          <button class="sidebar__link" data-panel="packs">
            <span class="sidebar__link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </span>
            Premium Packs
            <span class="sidebar__badge">${packs.filter(function(p) { return !p.isOwned; }).length}</span>
          </button>
          <button class="sidebar__link" data-panel="invites">
            <span class="sidebar__link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </span>
            Invites
          </button>
          <div class="sidebar__section">Content</div>
          <button class="sidebar__link" data-panel="earn-watch">
            <span class="sidebar__link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
              </svg>
            </span>
            Earn & Watch
            <span class="sidebar__badge" style="background:var(--green);">Earn</span>
          </button>
          <button class="sidebar__link" data-panel="library">
            <span class="sidebar__link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
            </span>
            My Library
          </button>
        </nav>
        <div class="sidebar__footer">
          <a href="/">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Back to Home
          </a>
        </div>
      </aside>
      <main class="main">
        <header class="topbar">
          <div class="topbar__left">
            <button class="topbar__menu" onclick="window._toggleSidebar()">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
              </svg>
            </button>
            <span class="topbar__title" id="panel-title">Overview <span>·</span> Dashboard</span>
          </div>
          <div class="topbar__right">
            <button class="topbar__bell" id="notif-bell" title="Notifications" onclick="toggleNotifications()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              </svg>
              <span class="topbar__bell-dot" id="notif-dot" style="display:none;"></span>
            </button>
            <div class="notif-dropdown" id="notif-dropdown" style="display:none;">
              <div class="notif-dropdown__header">
                <span>Notifications</span>
                <button class="notif-dropdown__markall" onclick="markAllRead()">Mark all read</button>
              </div>
              <div class="notif-dropdown__list" id="notif-list">
                <div class="notif-dropdown__empty">Loading...</div>
              </div>
            </div>
            <div class="topbar__avatar">${user.fullName.charAt(0)}</div>
            <span class="topbar__name">${user.fullName.split(' ')[0]}</span>
            <button class="topbar__logout" onclick="window._logout()">Sign Out</button>
          </div>
        </header>

        <!-- Greeting Message -->
        <div class="greeting">
          <h2>Welcome back, <span class="greeting__name">${user.fullName.split(" ")[0]}</span> 👋</h2>
          <p class="greeting__sub">Here's what's happening with your Vault today.</p>
        </div>
        <div class="page" id="panel-content"></div>
        <div class="footer">
          <span class="footer__brand">Wisdom Vault</span> &copy; ${new Date().getFullYear()} — Timeless Wisdom. Tangible Rewards.
        </div>
      </main>
    `;
    app.appendChild(shell);

    // Render initial panel
    renderPanel('overview');

    // Sidebar navigation
    document.querySelectorAll('.sidebar__link').forEach(function(link) {
      link.addEventListener('click', function() {
        document.querySelectorAll('.sidebar__link').forEach(function(l) {
          l.classList.remove('sidebar__link--active');
        });
        this.classList.add('sidebar__link--active');
        const panel = this.dataset.panel;
        if (panel) {
          const titleMap = {
            overview: 'Overview',
            earnings: 'Earnings',
            packs: 'Premium Packs',
            invites: 'Invites',
            library: 'My Library',
            uploads: 'Uploads'
          };
          document.getElementById('panel-title').innerHTML = (titleMap[panel] || panel) + ' <span>·</span> Dashboard';
          renderPanel(panel);
          if (window.innerWidth < 1024) window._toggleSidebar();
        }
      });
    });

    function renderPanel(panel) {
      const c = document.getElementById('panel-content');

      switch (panel) {
        case 'overview':
          c.innerHTML = `
            <div class="page__section">
              <div class="hero-balance">
                <div class="hero-balance-bubble-wrapper">
                  <div class="hero-balance-inner">
                    <div class="hero-balance__main">
                      <div class="hero-balance__label">Account Balance:</div>
                      <div class="hero-balance__amount">MWK ${parseFloat(w.balanceAvailable).toLocaleString()} <span style="font-size:12px;color:rgba(255,255,255,0.5);">(~${(parseFloat(w.balanceAvailable)/1800).toFixed(2)} USD)</span> <span style="font-size:14px;color:var(--muted);">(~${(parseFloat(w.balanceAvailable)/1800).toFixed(2)} USD)</span></div>
                    </div>
                    <div class="hero-balance__bottom-half">
                      <div class="hero-balance__bottom-text">
                        <span class="hero-balance__bottom-label">Available for Withdrawal:</span>
                        <span class="hero-balance__bottom-amount">MWK ${parseFloat(w.balanceAvailable).toLocaleString()} <span style="font-size:12px;color:rgba(255,255,255,0.5);">(~${(parseFloat(w.balanceAvailable)/1800).toFixed(2)} USD)</span> <span style="font-size:14px;color:var(--muted);">(~${(parseFloat(w.balanceAvailable)/1800).toFixed(2)} USD)</span></span>
                      </div>
                      <button class="tray-btn tray-btn--dark" onclick="window._withdraw('${user.id}')">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                          <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="page__section">
              <div class="quick-stats">
  <!-- Total Earnings -->
  <div class="quick-stat">
    <div class="quick-stat-wrapper">
      <div class="quick-stat-inner">
        <div class="quick-stat-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
        </div>
        <div class="quick-stat__content">
          <div class="quick-stat__value">MWK ${parseFloat(w.grossEarnings).toLocaleString()} <span style="font-size:11px;color:var(--muted);display:block;">~${(parseFloat(w.grossEarnings)/1800).toFixed(2)} USD</span></div>
          <div class="quick-stat__label">Total Earnings</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Total Withdrawn -->
  <div class="quick-stat">
    <div class="quick-stat-wrapper">
      <div class="quick-stat-inner">
        <div class="quick-stat-icon-wrapper">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
            <line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
        </div>
        <div class="quick-stat__content">
          <div class="quick-stat__value">MWK ${parseFloat(w.totalWithdrawn).toLocaleString()} <span style="font-size:11px;color:var(--muted);display:block;">~${(parseFloat(w.totalWithdrawn)/1800).toFixed(2)} USD</span></div>
          <div class="quick-stat__label">Total Withdrawn</div>
        </div>
      </div>
    </div>
  </div>
            </div>

            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">Premium Content Packs</div>
                  <div class="section-header__sub">${packs.filter(function(p) { return p.isOwned; }).length} of ${packs.length} unlocked</div>
                </div>
                <a class="section-header__action" data-panel="packs">
                  View All →
                </a>
              </div>
              <div class="packs-grid">${packs.slice(0, 3).map(packCard).join('')}</div>
            </div>

            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">Recent Activity</div>
                  <div class="section-header__sub">Your latest transactions</div>
                </div>
              </div>
              <div class="card">
                <div class="card__body card__body--flush">
                  <div class="tx-list">${txHTML}</div>
                </div>
              </div>
            </div>
          `;
          break;

        case 'earnings':
          c.innerHTML = `
            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">Transaction History</div>
                  <div class="section-header__sub">${txs.length} total transactions</div>
                </div>
              </div>
              <div class="card">
                <div class="card__body card__body--flush">
                  <div class="tx-list">${txHTML}</div>
                </div>
              </div>
            </div>

            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">Quick Withdraw</div>
                  <div class="section-header__sub">Minimum withdrawal: 5,200</div>
                </div>
              </div>
              <div class="card">
                <div class="card__body">
                  <div class="form-group">
                    <label style="font-size:12px;color:var(--muted);margin-bottom:4px;display:block;">Full Name (as on card)</label>
                    <input type="text" id="withdraw-name" class="input" placeholder="Enter cardholder name" required style="width:100%;"/>
                  </div>
                  <div class="form-group" style="margin-top:8px;">
                    <label style="font-size:12px;color:var(--muted);margin-bottom:4px;display:block;">Phone Number</label>
                    <input type="tel" id="withdraw-phone" class="input" placeholder="Enter phone number" required style="width:100%;"/>
                  </div>

                  
                  <div class="form-group">
                    <label style="font-size:12px;color:var(--muted);margin-bottom:4px;display:block;">Full Name (as on card)</label>
                    <input type="text" id="withdraw-name" class="input" placeholder="Enter cardholder name" required style="width:100%;"/>
                  </div>
                  <div class="form-group" style="margin-top:8px;">
                    <label style="font-size:12px;color:var(--muted);margin-bottom:4px;display:block;">Phone Number</label>
                    <input type="tel" id="withdraw-phone" class="input" placeholder="Enter phone number" required style="width:100%;"/>
                  </div>
                  <div class="withdraw-row">
                    <input type="number" id="withdraw-amount" class="input" placeholder="Enter amount" min="5200" step="100"/>
                    <button class="btn btn--gold" onclick="window._withdraw('${user.id}')">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <polyline points="19 12 12 19 5 12"/>
                      </svg>
                      Withdraw
                    </button>
                  </div>
                  <div class="fee-note">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="12" y1="8" x2="12" y2="12"/>
                      <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    20% processing fee applies
                  </div>
                  <div id="withdraw-msg" class="msg"></div>
                </div>
              </div>
            </div>
          `;
          break;

        case 'packs':
          c.innerHTML = `
            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">All Premium Packs</div>
                  <div class="section-header__sub">Unlock exclusive knowledge and skills</div>
                </div>
              </div>
              <div class="packs-grid">${packs.map(packCard).join('')}</div>
            </div>
          `;
          break;

        case 'invites':
          c.innerHTML = `
            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">Invite Program</div>
                  <div class="section-header__sub">Share and earn 5,200 per new member</div>
                </div>
              </div>
              <div class="card">
                <div class="card__body">
                  <div class="ref-box">
                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:12px;">
                      <span style="font-size:12px;font-weight:600;color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;">Your Invite Link</span>
                      <span style="font-size:11px;color:var(--green);display:flex;align-items:center;gap:4px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Active
                      </span>
                    </div>
                    <code class="ref-box__code">${user.referralLink}</code>
                    <button class="btn btn--gold" onclick="window._copyRef('${user.referralLink}',this)">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <rect x="9" y="9" width="13" height="13" rx="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                      Copy Link
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
          break;

        case 'earn-watch':
          c.innerHTML = '<div class="page__section"><div class="section-header"><div class="section-header__left"><div class="section-header__title">Earn & Watch</div><div class="section-header__sub">Watch videos & listen to music to earn</div></div></div><div id="earn-content" style="text-align:center;padding:60px;color:var(--muted)"><div style="margin-bottom:16px;opacity:.3;"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A853" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg></div><p>Loading sponsored content...</p></div></div>';
          window.loadEarnWatch();
          break;

        case 'library':
          c.innerHTML = `
            <div class="page__section">
              <div class="section-header">
                <div class="section-header__left">
                  <div class="section-header__title">My Library</div>
                  <div class="section-header__sub">Your Vault shelves</div>
                </div>
              </div>
              <div id="library-content" style="text-align:center;padding:60px;color:var(--muted)">
                <div style="margin-bottom:16px;opacity:.3;">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a10 10 0 0 1 10 10"/>
                  </svg>
                </div>
                <p>Loading your shelves...</p>
              </div>
            </div>
          `;

          fetch('/api/content/library')
            .then(function(r) { return r.json(); })
            .then(function(d) {
              var lc = document.getElementById('library-content');
              if (lc && d.success && d.items && d.items.length > 0) {
                try {
                var shelfImages = {
                  'books-for-the-wise': 'https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=600&h=180&fit=crop',
                  'life-teachings': 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=180&fit=crop',
                  'practical-guides': 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=600&h=180&fit=crop',
                  'wise-sayings': 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=600&h=180&fit=crop',
                  'kitchen-nourishment': 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=180&fit=crop',
                  'foundation-courses': 'https://images.unsplash.com/photo-1513258496099-48168024aec0?w=600&h=180&fit=crop'
                };
                var typeLabels = { 'book': 'Book', 'teaching': 'Teaching', 'guide': 'Guide', 'counsel': 'Wise Counsel', 'recipe': 'Recipe', 'course': 'Course' };
                var cats = {};
                d.items.forEach(function(item) {
                  if (!cats[item.category_slug]) {
                    cats[item.category_slug] = { name: item.category_name, slug: item.category_slug, items: [] };
                  }
                  cats[item.category_slug].items.push(item);
                });
                var html = '';
                Object.keys(cats).forEach(function(slug) {
                  var cat = cats[slug];
                  var img = shelfImages[slug] || 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=600&h=180&fit=crop';
                  var shelfId = 'shelf-' + slug;
                  html += '<div class="page__section"><div class="section-header" style="cursor:pointer;" onclick="var el=document.getElementById(\'' + shelfId + '\');if(el)el.style.display=el.style.display===\'none\'?\'block\':\'none\';var icon=this.querySelector(\'.section-header__toggle\');if(icon)icon.textContent=icon.textContent===\'+\'?\'−\':\'+\';">';
                  html += '<div class="section-header__left"><div class="section-header__title">' + cat.name + ' <span class="section-header__toggle" style="font-size:18px;">+</span></div><div class="section-header__sub">' + cat.items.length + ' items</div></div></div>';
                  html += '<div class="packs-grid" id="' + shelfId + '" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr));display:none;">';
                  cat.items.forEach(function(item) {
                    var label = typeLabels[item.content_type] || item.content_type;
                    html += '<div class="pack-card" style="cursor:default;"><div class="pack-card__cover" style="height:140px;position:relative;overflow:hidden;"><img src="' + img + '" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;" loading="lazy" /><div class="pack-card__cover-gradient"></div><div style="position:absolute;bottom:12px;left:16px;z-index:2;font-size:10px;color:var(--gold);letter-spacing:0.08em;text-transform:uppercase;background:rgba(0,0,0,0.7);padding:4px 10px;border-radius:6px;">' + label + '</div></div><div class="pack-card__body"><div class="pack-card__name" style="font-size:15px;">' + item.title + '</div><div class="pack-card__desc">' + (item.description || '') + '</div><button class="pack-card__btn" style="margin-top:8px;" onclick="window.openContentItem(\'' + item.id + '\')">' + (item.file_url ? 'View Content' : 'No File Yet') + '</button></div></div>';
                  });
                  html += '</div></div>';
                });
                lc.innerHTML = html;
                } catch(renderErr) {
                  console.error('Render error:', renderErr);
                  lc.innerHTML = '<p style="color:var(--red);">Error displaying library. Please refresh.</p>';
                }
              } else if (lc) {
                lc.innerHTML = '<p>Your library is empty. Unlock some premium packs to fill your shelves!</p>';
              }
            })
            .catch(function() {
              var lc = document.getElementById('library-content');
              if (lc) lc.innerHTML = '<p style="color:var(--red);">Failed to load library.</p>';
            });
          break;
      }
    }
  }

  // Pack helper functions
  function getPackImage(slug) {
    var images = {
      'secret-library': 'https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=800&h=400&fit=crop&auto=format',
      'cybersecurity-mastery': 'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&h=400&fit=crop&auto=format',
      'wealth-architecture': 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=800&h=400&fit=crop&auto=format',
      'relationship-mastery': 'https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?w=800&h=400&fit=crop&auto=format',
      'survival-self-reliance': 'https://images.unsplash.com/photo-1535930891776-0c2dfb7fda1a?w=800&h=400&fit=crop&auto=format'
    };
    return images[slug] || 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=800&h=400&fit=crop&auto=format';
  }

  function getPackEmoji(slug) {
    var svgs = {
      'secret-library': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1" opacity="0.6"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/></svg>',
      'cybersecurity-mastery': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1" opacity="0.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>',
      'wealth-architecture': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="1" opacity="0.6"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
      'relationship-mastery': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="1" opacity="0.6"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
      'survival-self-reliance': '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="1" opacity="0.6"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>'
    };
    return svgs[slug] || '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1" opacity="0.6"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>';
  }

  function getPackDetail(slug) {
    var details = {
      'secret-library': 'Rare manuscripts on ancient wisdom, suppressed histories, esoteric philosophy, and spiritual texts unavailable elsewhere.',
      'cybersecurity-mastery': 'Complete pentesting labs, network security blueprints, vulnerability assessment guides, and real-world defense strategies.',
      'wealth-architecture': 'Investment templates, tax optimization frameworks, passive income systems, and the wealth-building playbooks of the financially independent.',
      'relationship-mastery': 'Psychological frameworks for lasting love, conflict resolution systems, and the science of deep human connection.',
      'survival-self-reliance': 'Emergency medicine guides, off-grid living blueprints, food preservation techniques, and complete self-sufficiency training.'
    };
    return details[slug] || 'Premium content pack with exclusive resources.';
  }

  // Notification functions
  var notifCache = null;

  async function fetchNotifications() {
    var user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
    if (!user.id) return;
    try {
      var res = await fetch('/api/notifications?userId=' + user.id);
      var data = await res.json();
      if (data.success) {
        notifCache = data.notifications;
        var dot = document.getElementById('notif-dot');
        if (dot) dot.style.display = data.unreadCount > 0 ? 'block' : 'none';
      }
    } catch (e) {}
  }

  function toggleNotifications() {
    var dd = document.getElementById('notif-dropdown');
    if (!dd) return;
    if (dd.style.display === 'none') {
      dd.style.display = 'block';
      renderNotifications();
    } else {
      dd.style.display = 'none';
    }
  }

  function renderNotifications() {
    var list = document.getElementById('notif-list');
    if (!list) return;
    if (!notifCache || notifCache.length === 0) {
      list.innerHTML = '<div class="notif-dropdown__empty">No notifications yet</div>';
      return;
    }
    var html = '';
    notifCache.forEach(function(n) {
      var timeAgo = getTimeAgo(new Date(n.created_at));
      html += '<div class="notif-item ' + (n.is_read ? '' : 'notif-item--unread') + '" onclick="markRead(\'' + n.id + '\', \'' + (n.link || '') + '\')">';
      html += '<div class="notif-item__dot ' + (n.is_read ? 'notif-item__dot--read' : '') + '"></div>';
      html += '<div class="notif-item__content">';
      html += '<div class="notif-item__title">' + n.title + '</div>';
      html += '<div class="notif-item__msg">' + (n.message || '') + '</div>';
      html += '<div class="notif-item__time">' + timeAgo + '</div>';
      html += '</div></div>';
    });
    list.innerHTML = html;
  }

  function getTimeAgo(date) {
    var seconds = Math.floor((new Date() - date) / 1000);
    if (seconds < 60) return 'Just now';
    var minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + 'm ago';
    var hours = Math.floor(minutes / 60);
    if (hours < 24) return hours + 'h ago';
    var days = Math.floor(hours / 24);
    return days + 'd ago';
  }

  async function markRead(id, link) {
    var user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
    await fetch('/api/notifications', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: user.id, notificationIds: [id] })
    });
    if (link) window.location.href = link;
    document.getElementById('notif-dropdown').style.display = 'none';
    fetchNotifications();
  }

  async function markAllRead() {
    var user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
    await fetch('/api/notifications', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: user.id })
    });
    document.getElementById('notif-dropdown').style.display = 'none';
    fetchNotifications();
  }

  // Close dropdown on outside click
  document.addEventListener('click', function(e) {
    var dd = document.getElementById('notif-dropdown');
    var bell = document.getElementById('notif-bell');
    if (dd && bell && !bell.contains(e.target) && !dd.contains(e.target)) {
      dd.style.display = 'none';
    }
  });

  // Fetch notifications on load
  fetchNotifications();

  // Global functions
  window._toggleSidebar = function() {
    document.getElementById('sidebar')?.classList.toggle('sidebar--open');
    document.getElementById('overlay')?.classList.toggle('overlay--visible');
  };

  window.watchContent = function(contentId, reward) {
    var user = JSON.parse(localStorage.getItem("wisdom_vault_user") || "{}");
    if (!user.id) return;
    if (!confirm("Watch this content to earn " + reward + "? Make sure to watch the full content.")) return;
    fetch("/api/earn/watch", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ userId: user.id, contentId: contentId })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) {
        alert("Earned " + d.reward + "! Your wallet has been credited.");
        location.reload();
      } else {
        alert(d.message || "Already claimed today.");
      }
    });
  };

  window._logout = function() {
    localStorage.removeItem('wisdom_vault_user');
    window.location.href = '/';
  };

  window._copyRef = function(link, btn) {
    navigator.clipboard.writeText(link).then(function() {
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
      btn.style.background = 'var(--green)';
      btn.style.color = '#000';
      setTimeout(function() {
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy Link';
        btn.style.background = '';
        btn.style.color = '';
      }, 2000);
    });
  };

  window._withdraw = async function(userId) {
    var input = document.getElementById('withdraw-amount');
    var nameInput = document.getElementById('withdraw-name');
    var phoneInput = document.getElementById('withdraw-phone');
    var msg = document.getElementById('withdraw-msg');
    var amount = input?.value;
    var cardholderName = nameInput ? nameInput.value : '';
    var phoneNumber = phoneInput ? phoneInput.value : '';

    if (!amount || parseInt(amount) < 5200) {
      if (msg) {
        msg.className = 'msg msg--error msg--show';
        msg.textContent = '⚠️ Minimum withdrawal is 5,200';
      }
      return;
    }

    if (msg) msg.className = 'msg';

    try {
      var res = await fetch('/api/wallet/withdraw', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: userId, amount: amount , cardholderName: document.getElementById('withdraw-name').value, phoneNumber: document.getElementById('withdraw-phone').value })
      });
      var data = await res.json();

      if (msg) {
        if (data.success) {
          msg.className = 'msg msg--success msg--show';
          msg.textContent = '✅ Request submitted! Net payout: MWK ' + data.withdrawal.netPayout.toLocaleString() + ' (~' + (data.withdrawal.netPayout/1800).toFixed(2) + ' USD)';
          if (input) input.value = '';
          setTimeout(function() { location.reload(); }, 2500);
        } else {
          msg.className = 'msg msg--error msg--show';
          msg.textContent = '❌ ' + (data.message || 'Withdrawal failed');
        }
      }
    } catch {
      if (msg) {
        msg.className = 'msg msg--error msg--show';
        msg.textContent = '❌ Network error. Please try again.';
      }
    }
  };

  window._buy = function(packId, name, price) {
    window.location.href = '/pay/' + packId;
  };

  window.openContentItem = function(contentId) {
    window.location.href = '/content/' + contentId;
  };

  window._viewPack = function(packId) {
    window.location.href = '/pack/' + packId;
  };

  // Load earn-watch from external file
  var earnScript = document.createElement('script');
  earnScript.src = '/earn-watch.js';
  // document.head.appendChild(earnScript);

  // ============================================================
  // EARN & WATCH - Built-in function (no external dependency)
  // ============================================================
  window.loadEarnWatch = function() {
    var user = JSON.parse(localStorage.getItem("wisdom_vault_user") || "{}");
    if (!user.id) {
      var ec = document.getElementById("earn-content");
      if (ec) ec.innerHTML = '<p style="color:var(--muted);">Please sign in to earn rewards.</p>';
      return;
    }

    fetch("/api/earn/watch?userId=" + user.id)
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var ec = document.getElementById("earn-content");
        if (!ec) return;

        var items = d.content || [];
        var html = "";

        if (items.length === 0) {
          html = '<div style="text-align:center;padding:60px;color:var(--muted);"><div style="font-size:48px;margin-bottom:16px;">📹</div><p>No content available today. Check back tomorrow!</p></div>';
        } else {
          items.forEach(function(item) {
            var isVideo = item.content_type === "video";
            var isWatched = item.isWatched || false;
            
            html += '<div class="pack-card" style="margin-bottom:16px;opacity:' + (isWatched ? '0.5' : '1') + ';">';
            html += '<div class="pack-card__cover" style="height:120px;background:linear-gradient(135deg,#1a0f1f,#2d1f35);display:flex;align-items:center;justify-content:center;position:relative;">';
            if (isWatched) {
              html += '<div style="position:absolute;top:12px;right:12px;background:var(--green);color:#fff;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;">✓ Earned</div>';
            }
            html += isVideo 
              ? '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A853" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>'
              : '<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A853" stroke-width="1.5"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
            html += '</div>';
            html += '<div class="pack-card__body">';
            html += '<div class="pack-card__name">' + item.title + '</div>';
            html += '<div class="pack-card__desc">' + (item.description || '') + '</div>';
            html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">';
            html += '<span style="font-size:12px;color:var(--muted);">' + (item.sponsor_name || "Wisdom Vault") + ' · ' + item.duration_seconds + 's</span>';
            html += '<span style="font-size:20px;font-weight:800;color:var(--green);">+' + item.reward_amount + '</span>';
            html += '</div>';
            if (isWatched) {
              html += '<button class="pack-card__btn pack-card__btn--owned" style="cursor:default;">✅ Already Earned</button>';
            } else {
              html += '<button class="pack-card__btn" onclick="window._watchContent(\'' + item.id + '\', ' + item.reward_amount + ', \'' + (item.external_link || '') + '\', this)" style="color:var(--green);border-color:var(--green);">Open & Earn +' + item.reward_amount + '</button>';
            }
            html += '</div></div>';
          });
        }
        
        ec.innerHTML = html;
      })
      .catch(function(err) {
        console.error('Earn watch error:', err);
        var ec = document.getElementById("earn-content");
        if (ec) ec.innerHTML = '<p style="color:var(--red);">Failed to load content. Please refresh.</p>';
      });
  };

  window._watchContent = function(contentId, reward, link, btn) {
    var user = JSON.parse(localStorage.getItem("wisdom_vault_user") || "{}");
    if (!user.id) {
      alert("Please sign in first.");
      return;
    }

    if (link) {
      window.open(link, '_blank');
    } else {
      alert("No link provided for this content.");
      return;
    }

    var secondsLeft = 90;
    var originalHTML = btn.innerHTML;
    btn.innerHTML = 'Wait ' + secondsLeft + 's...';
    btn.disabled = true;
    btn.style.opacity = '0.6';

    var countdown = setInterval(function() {
      secondsLeft--;
      btn.innerHTML = 'Wait ' + secondsLeft + 's...';
      if (secondsLeft <= 0) {
        clearInterval(countdown);
        
        fetch("/api/earn/watch", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ userId: user.id, contentId: contentId })
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.success) {
            btn.innerHTML = '✅ Earned ' + d.reward + '!';
            btn.style.color = 'var(--green)';
            btn.style.borderColor = 'var(--green)';
            btn.disabled = true;
            setTimeout(function() { window.loadEarnWatch(); }, 1000);
          } else {
            btn.innerHTML = originalHTML;
            btn.disabled = false;
            btn.style.opacity = '1';
            alert(d.message || 'Failed to claim reward.');
          }
        })
        .catch(function() {
          btn.innerHTML = originalHTML;
          btn.disabled = false;
          btn.style.opacity = '1';
          alert('Network error. Please try again.');
        });
      }
    }, 1000);
  };

</script>
