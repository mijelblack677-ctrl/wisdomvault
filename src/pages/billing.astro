---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout noindex>
  <div id="billing-app">
    <div class="billing-bg"></div>
    <div class="billing-overlay"></div>
    <div id="billing-container"></div>
    <div id="toast">Copied!</div>
  </div>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Georgia,serif&display=swap');

  #billing-app {
    min-height: 100vh;
    min-height: 100dvh;
    background: #f7f1ec;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'Inter', 'Poppins', sans-serif;
    position: relative;
    overflow: hidden;
  }

  /* ============ BACKGROUND ============ */
  .billing-bg {
    position: fixed;
    inset: 0;
    /* JPEG is the always-safe base. The @supports block upgrades modern
       browsers to the WebP (~58% smaller). Wrapping it keeps the fallback:
       Lightning CSS merges consecutive background-image longhands and drops
       the JPEG entirely. */
    background-image: url('/images/warm-books.jpg');
    @supports (background-image: image-set(url('/images/warm-books.webp') 1x)) {
      background-image: image-set(url('/images/warm-books.webp') 1x);
    }
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(0.35);
    z-index: 0;
  }

  .billing-overlay {
    position: fixed;
    inset: 0;
    background: linear-gradient(135deg, rgba(247,241,236,0.75) 0%, rgba(237,228,221,0.65) 50%, rgba(247,241,236,0.75) 100%);
    z-index: 1;
  }

  #billing-container {
    width: 100%;
    max-width: 440px;
    position: relative;
    z-index: 2;
    animation: fadeUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============ CARD ============ */
  .card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 32px;
    padding: 28px 24px 20px;
    box-shadow: 0 20px 80px rgba(139, 94, 52, 0.08), 0 1px 3px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #c09a8a, transparent);
    opacity: 0.6;
  }

  /* ============ HEADER ============ */
  .header-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #FFF1D6;
    border: 1px solid #F5E6C8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    box-shadow: 0 4px 24px rgba(183, 121, 31, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    position: relative;
  }

  .header-icon::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: rgba(183, 121, 31, 0.1);
    filter: blur(18px);
    z-index: -1;
    transform: scale(1.25);
  }

  .header-icon-inner {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    border: 1px solid #F5E6C8;
  }

  .card-title {
    font-size: 28px;
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #1A1A1A;
    text-align: center;
  }

  .card-title span {
    background: linear-gradient(180deg, #B7791F 0%, #8B5E34 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .card-subtitle {
    font-size: 14px;
    line-height: 1.5;
    color: #8C7F6E;
    letter-spacing: -0.01em;
    text-align: center;
    margin-top: 12px;
  }

  /* ============ AMOUNT BOX ============ */
  .amount-box {
    background: #FFF8EB;
    border: 1px solid #F5E9D3;
    border-radius: 20px;
    padding: 24px 24px;
    text-align: center;
    margin: 20px 0 24px;
    position: relative;
    overflow: hidden;
  }

  .amount-box::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: radial-gradient(#8B5E34 1px, transparent 1px);
    background-size: 18px 18px;
    pointer-events: none;
  }

  .amount-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #A89A87;
    margin-bottom: 12px;
    position: relative;
  }

  .amount-value {
    font-family: 'Georgia', Times, serif;
    font-size: 46px;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #8B5E34;
    font-weight: 700;
    position: relative;
  }

  .amount-usd {
    font-size: 13px;
    color: #9C8E7C;
    font-weight: 500;
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    position: relative;
  }

  .amount-usd span {
    color: #7A6D5B;
    font-weight: 600;
  }

  .amount-usd .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #D9CCB8;
  }

  /* ============ PAYMENT METHODS INFO ============ */
  .methods-info {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .method-chip {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 12px;
    border-radius: 12px;
    background: #FFFEFB;
    border: 1px solid #EFE3CF;
    font-size: 11px;
    font-weight: 600;
    color: #5E564B;
  }

  .method-chip svg {
    width: 16px;
    height: 16px;
  }

  .method-chip--airtel { border-color: #FFD4D4; color: #E53935; }
  .method-chip--tnm { border-color: #C9DBFF; color: #1E5BDA; }
  .method-chip--card { border-color: #D4F5D4; color: #2E7D32; }

  /* ============ PAY BUTTON ============ */
  .pay-btn {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 16px;
    background: linear-gradient(135deg, #B7791F, #8B5E34);
    color: white;
    padding: 16px 24px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    box-shadow: 0 8px 32px rgba(139, 94, 52, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    text-decoration: none;
    transition: all 0.25s ease;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }

  .pay-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(139, 94, 52, 0.35);
  }

  .pay-btn:active {
    transform: translateY(0px);
  }

  .pay-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .pay-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    transform: translateX(-100%);
    transition: transform 0.5s ease;
  }

  .pay-btn:hover::after {
    transform: translateX(100%);
  }

  .pay-btn .spinner {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    display: none;
  }

  .pay-btn.loading .spinner { display: block; }
  .pay-btn.loading .btn-text { display: none; }
  .pay-btn.loading .btn-arrow { display: none; }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* ============ STEPS ============ */
  .steps-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #1A1A1A;
    margin-bottom: 16px;
    margin-top: 20px;
  }

  .step {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .step:last-child {
    margin-bottom: 0;
  }

  .step-number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #1A1A1A;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .step-content {
    flex: 1;
    padding-top: 1px;
  }

  .step-text {
    font-size: 13.5px;
    line-height: 1.5;
    color: #5E564B;
    letter-spacing: -0.01em;
  }

  /* ============ DIVIDER ============ */
  .divider {
    height: 1px;
    width: 100%;
    background: linear-gradient(to right, transparent, #EDE0C8, transparent);
    margin: 16px 0;
  }

  /* ============ SECURE BADGE ============ */
  .secure-badge {
    border-radius: 9999px;
    background: #FAF7F1;
    border: 1px solid #F0E6D3;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 20px 0 16px;
  }

  .secure-badge svg {
    width: 14px;
    height: 14px;
    color: #A89A87;
  }

  .secure-badge span {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #8C7F6E;
  }

  /* ============ STATUS MESSAGES ============ */
  .status-msg {
    padding: 14px 16px;
    border-radius: 12px;
    font-size: 13px;
    margin-bottom: 16px;
    display: none;
    line-height: 1.5;
  }

  .status-msg--show { display: block; }
  .status-msg--success {
    background: rgba(76,175,80,0.08);
    border: 1px solid rgba(76,175,80,0.2);
    color: #2E7D32;
  }
  .status-msg--error {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.2);
    color: #C62828;
  }
  .status-msg--info {
    background: rgba(183,121,31,0.08);
    border: 1px solid rgba(183,121,31,0.2);
    color: #8B5E34;
  }

  /* ============ FOOTER ============ */
  .footer-link {
    display: block;
    text-align: center;
    margin-top: 16px;
    font-size: 13px;
    font-weight: 500;
    color: #9A8E7D;
    text-decoration: none;
    transition: color 0.2s ease;
    text-decoration: underline;
    text-decoration-color: #E8DDCA;
    text-underline-offset: 4px;
  }

  .footer-link:hover {
    color: #6B6052;
    text-decoration-color: #C9B99A;
  }

  .footer-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
    opacity: 0.6;
  }

  .footer-divider .line {
    height: 1px;
    width: 32px;
    background: #E9DDC6;
  }

  .footer-divider span {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: #B8AA94;
  }

  .footer-note {
    text-align: center;
    font-size: 11px;
    line-height: 1.5;
    color: #B0A596;
    padding: 0 16px;
    margin-top: 24px;
  }

  /* ============ TOAST ============ */
  #toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: #1A1A1A;
    color: white;
    padding: 10px 18px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    pointer-events: none;
  }

  #toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  /* ============ LOADING ============ */
  .loading {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 32px;
    padding: 50px 30px;
    text-align: center;
    color: #5a4a4a;
    box-shadow: 0 20px 80px rgba(139, 94, 52, 0.08);
  }

  .spin {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(192, 154, 138, 0.15);
    border-top-color: #c09a8a;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 12px;
  }

  /* ============ ALREADY VERIFIED ============ */
  .verified-card {
    text-align: center;
    padding: 40px 24px;
  }

  .verified-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, #4CAF50, #2E7D32);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 8px 32px rgba(76, 175, 80, 0.3);
  }

  .verified-icon svg {
    width: 40px;
    height: 40px;
    color: white;
  }

  .verified-title {
    font-size: 24px;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 8px;
  }

  .verified-text {
    font-size: 14px;
    color: #5E564B;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 480px) {
    .card {
      padding: 20px 16px 16px;
      border-radius: 24px;
    }

    .amount-value {
      font-size: 38px;
    }

    .card-title {
      font-size: 24px;
    }
  }

  /* ============ MAINTENANCE CARD ANIMATIONS ============ */
  .maint-icon-wrap {
    position: relative;
  }

  .maint-ring {
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 2px solid rgba(183, 121, 31, 0.45);
    animation: maintRingB 2.6s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
    pointer-events: none;
  }

  .maint-ring--two {
    animation-delay: 1.3s;
  }

  @keyframes maintRingB {
    0%   { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  .maint-title-billing span {
    background: linear-gradient(90deg, #B7791F 0%, #B7791F 30%, #F5D9A8 50%, #B7791F 70%, #B7791F 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: maintShimmerB 3s linear infinite;
  }

  /* the bouncing dots are nested inside the clipped span — undo the
     text-clip on them so their colored circles stay visible */
  .card-title .maint-dot {
    -webkit-background-clip: border-box;
    background-clip: border-box;
    -webkit-text-fill-color: initial;
  }

  @keyframes maintShimmerB {
    to { background-position: -200% center; }
  }

  .maint-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 1px;
    border-radius: 50%;
    background: #B7791F;
    animation: maintBounceB 1.4s ease-in-out infinite;
    vertical-align: baseline;
  }

  .maint-dot:nth-child(2) { animation-delay: 0.2s; }
  .maint-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes maintBounceB {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30%           { transform: translateY(-6px); opacity: 1; }
  }

  .maint-scan {
    width: 200px;
    height: 5px;
    border-radius: 999px;
    background: rgba(183, 121, 31, 0.18);
    overflow: hidden;
    position: relative;
    margin: 18px auto 0;
  }

  .maint-scan::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -40%;
    width: 40%;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, #B7791F, transparent);
    animation: maintScanB 1.6s ease-in-out infinite;
  }

  @keyframes maintScanB {
    0%   { left: -40%; }
    100% { left: 110%; }
  }

  .maint-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(183, 121, 31, 0.1);
    border: 1px solid rgba(183, 121, 31, 0.35);
    font-size: 12px;
    color: #8B5E34;
    margin-top: 16px;
  }

  .maint-pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #B7791F;
    animation: maintBlinkB 1.2s ease-in-out infinite;
  }

  @keyframes maintBlinkB {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(183, 121, 31, 0.5); }
    50%      { opacity: 0.35; box-shadow: 0 0 0 6px rgba(183, 121, 31, 0); }
  }
</style>

<script>
  import { cacheGet, cacheSet, cacheGetStale } from '../scripts/api-cache.js';

  // JSON headers plus the session token — the API now requires a Bearer
  // token (the ?userId= fallback was removed server-side).
  function billingHeaders(extra = {}) {
    const headers = { 'Content-Type': 'application/json', ...extra };
    const token = localStorage.getItem('wisdom_vault_session');
    if (token) headers['Authorization'] = `Bearer ${token}`;
    return headers;
  }

  const toast = document.getElementById('toast');

  function showToast(t) {
    toast.textContent = t;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
  }

  // Check URL params for status messages
  const urlParams = new URLSearchParams(window.location.search);
  const statusParam = urlParams.get('status');
  const welcomeParam = urlParams.get('welcome');
  const txRefParam = urlParams.get('tx_ref');

  // Auto-reconcile after a PayChangu redirect: mobile-money settlement can lag
  // a few seconds/minutes, so poll the server until the payment confirms or
  // gives a final answer, instead of showing a stale "pending" forever.
  let reconcileTimer = null;
  let reconcileAttempts = 0;
  const MAX_RECONCILE_ATTEMPTS = 12; // ~60s

  async function reconcilePayment(user) {
    try {
      const qs = txRefParam ? `?userId=${encodeURIComponent(user.id)}&tx_ref=${encodeURIComponent(txRefParam)}` : `?userId=${encodeURIComponent(user.id)}`;
      const res = await fetch('/api/paychangu/status' + qs, {
        headers: billingHeaders(),
        credentials: 'include'
      });
      const data = await res.json();
      return data;
    } catch (e) {
      return { verified: false };
    }
  }

  function setPayButtonChecking(checking) {
    const btn = document.getElementById('pay-btn');
    if (!btn) return;
    if (checking) {
      btn.classList.add('loading');
      btn.disabled = true;
    } else {
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  }

  function onVerified() {
    try {
      const stored = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
      stored.paymentStatus = 'verified';
      localStorage.setItem('wisdom_vault_user', JSON.stringify(stored));
    } catch (e) {}
    const container = document.getElementById('billing-container');
    if (container) {
      container.innerHTML = `<div class="card verified-card">
        <div class="verified-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></div>
        <div class="verified-title">Payment Confirmed ✅</div>
        <p class="verified-text">Your payment was verified. Redirecting to your dashboard...</p>
      </div>`;
    }
    setTimeout(() => { window.location.href = '/dashboard'; }, 1500);
  }

  function startReconcile(user) {
    if (!user || !user.id) return;
    if (reconcileTimer) return; // already polling
    // Don't double-charge while we confirm an existing payment
    setPayButtonChecking(true);
    reconcileTimer = setInterval(async () => {
      // Don't keep calling the server from a background tab (free-tier CPU)
      if (document.hidden) return;
      reconcileAttempts++;
      const data = await reconcilePayment(user);
      if (data && data.verified) {
        clearInterval(reconcileTimer);
        reconcileTimer = null;
        setPayButtonChecking(false);
        onVerified();
        return;
      }
      // Stop early if PayChangu says there is no pending checkout or it failed
      if (data && (data.txStatus === 'none' || data.txStatus === 'failed')) {
        clearInterval(reconcileTimer);
        reconcileTimer = null;
        setPayButtonChecking(false);
        return;
      }
      if (reconcileAttempts >= MAX_RECONCILE_ATTEMPTS) {
        clearInterval(reconcileTimer);
        reconcileTimer = null;
        setPayButtonChecking(false);
      }
    }, 5000);
    // Fire immediately so a settled payment activates on this page load
    reconcilePayment(user).then((data) => {
      if (!reconcileTimer) return; // already resolved by first tick
      if (data && data.verified) {
        clearInterval(reconcileTimer);
        reconcileTimer = null;
        setPayButtonChecking(false);
        onVerified();
      } else if (data && (data.txStatus === 'none' || data.txStatus === 'failed')) {
        clearInterval(reconcileTimer);
        reconcileTimer = null;
        setPayButtonChecking(false);
      }
    });
  }

  async function renderBilling() {
    const container = document.getElementById('billing-container');
    const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');

    if (!user.id) {
      container.innerHTML = `
        <div class="card" style="text-align:center;">
          <div class="header-icon">
            <div class="header-icon-inner">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B7791F" stroke-width="2.2">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <polyline points="10 17 15 12 10 7"/>
                <line x1="15" y1="12" x2="3" y2="12"/>
              </svg>
            </div>
          </div>
          <h1 class="card-title">Login <span>Required</span></h1>
          <p class="card-subtitle">Please sign in to complete your payment</p>
          <a href="/login" class="pay-btn" style="display:inline-flex; margin-top:20px; width:auto; padding:14px 32px; border-radius:12px;">
            <span class="btn-text">Sign In</span>
          </a>
        </div>
      `;
      return;
    }

    // Show loading
    container.innerHTML = `
      <div class="loading">
        <div class="spin"></div>
        Loading payment details...
      </div>
    `;

    // Check if already verified (cached up to 30s — saves a serverless
    // invocation on repeat visits; stale cache also covers API hiccups)
    try {
      let balanceData = cacheGet('/wallet/balance', user.id);
      if (balanceData === undefined) {
        const balanceRes = await fetch('/api/wallet/balance?userId=' + user.id, { headers: billingHeaders() });
        balanceData = await balanceRes.json();
        if (balanceRes.ok) cacheSet('/wallet/balance', user.id, balanceData);
      }

      if (balanceData.success && balanceData.wallet?.paymentStatus === 'verified') {
        container.innerHTML = `
          <div class="card verified-card">
            <div class="verified-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div class="verified-title">Account Verified ✅</div>
            <p class="verified-text">Your account is already activated! You have full access to Wisdom Vault.</p>
            <a href="/dashboard" class="pay-btn" style="display:inline-flex; width:auto; padding:14px 32px; border-radius:12px;">
              <span class="btn-text">Go to Dashboard</span>
            </a>
          </div>
        `;
        return;
      }
    } catch (e) {
      // Network failure: honor a cached verified state if we have one,
      // otherwise show a maintenance card instead of a payment form that
      // can't reach the server.
      const stale = cacheGetStale('/wallet/balance', user.id);
      if (stale && stale.success && stale.wallet && stale.wallet.paymentStatus === 'verified') {
        container.innerHTML = `
          <div class="card verified-card">
            <div class="verified-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </div>
            <div class="verified-title">Account Verified ✅</div>
            <p class="verified-text">Your account is already activated! You have full access to Wisdom Vault.</p>
            <a href="/dashboard" class="pay-btn" style="display:inline-flex; width:auto; padding:14px 32px; border-radius:12px;">
              <span class="btn-text">Go to Dashboard</span>
            </a>
          </div>
        `;
        return;
      }
      container.innerHTML = `
        <div class="card" style="text-align:center;">
          <div class="maint-icon-wrap">
            <div class="header-icon" style="margin-bottom:20px;">
              <span class="maint-ring"></span>
              <span class="maint-ring maint-ring--two"></span>
              <div class="header-icon-inner">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B7791F" stroke-width="2.2">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              </div>
            </div>
          </div>
          <h1 class="card-title maint-title-billing">System <span>Under Maintenance<span class="maint-dot"></span><span class="maint-dot"></span><span class="maint-dot"></span></span></h1>
          <p class="card-subtitle">We're experiencing technical difficulties right now. Please try again in a few minutes.</p>
          <div class="maint-scan"></div>
          <div class="maint-pill"><span class="maint-pill-dot"></span><span id="maint-countdown">Auto-retrying in 30s…</span></div>
          <button id="maint-retry" class="pay-btn" style="display:inline-flex; margin-top:20px; width:auto; padding:14px 32px; border-radius:12px; border:none; cursor:pointer;">
            <span class="btn-text">Try Again</span>
          </button>
        </div>
      `;
      document.getElementById('maint-retry')?.addEventListener('click', () => window.location.reload());
      // Auto-retry: reload when the countdown hits zero so the user recovers
      // automatically once the server is reachable again.
      let retryIn = 30;
      const countdownEl = document.getElementById('maint-countdown');
      const countdownTimer = setInterval(() => {
        retryIn -= 1;
        if (countdownEl) countdownEl.textContent = retryIn > 0 ? `Auto-retrying in ${retryIn}s…` : 'Retrying now…';
        if (retryIn <= 0) {
          clearInterval(countdownTimer);
          window.location.reload();
        }
      }, 1000);
      return;
    }

    const fee = '10,800';
    const feeRaw = '10800';

    // Handle return URL status
    let statusHtml = '';
    if (statusParam === 'verified' || welcomeParam === 'true') {
      statusHtml = `<div class="status-msg status-msg--success status-msg--show">🎉 Payment successful! Your account has been activated. Redirecting to dashboard...</div>`;
      setTimeout(() => { window.location.href = '/dashboard'; }, 3000);
    } else if (statusParam === 'failed') {
      statusHtml = `<div class="status-msg status-msg--error status-msg--show">Payment was not completed. Please try again.</div>`;
    } else if (statusParam === 'error') {
      const msg = urlParams.get('message') || 'An error occurred';
      statusHtml = `<div class="status-msg status-msg--error status-msg--show">Error: ${msg}</div>`;
    } else if (statusParam === 'return' || statusParam === 'checking') {
      statusHtml = `<div class="status-msg status-msg--info status-msg--show">We are confirming your payment with PayChangu. Please wait a moment — your account will activate automatically once confirmed.</div>`;
    }

    container.innerHTML = `
      <div class="card">
        ${statusHtml}

        <!-- Header Icon -->
        <div class="header-icon">
          <div class="header-icon-inner">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#B7791F" stroke-width="2.2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
        </div>

        <!-- Title -->
        <h1 class="card-title">Complete <span>Payment</span></h1>
        <p class="card-subtitle">Pay securely online to activate your account</p>

        <!-- Amount Box -->
        <div class="amount-box">
          <div class="amount-label">Registration Fee</div>
          <div class="amount-value">MWK ${fee}</div>
          <div class="amount-usd">
            <span>One-time payment</span>
            <span class="dot"></span>
            <span>Instant activation</span>
          </div>
          <div style="margin-top:10px; font-size:12px; color:#8B5E34; background:rgba(183,121,31,0.08); border:1px solid rgba(183,121,31,0.15); border-radius:10px; padding:10px 14px; line-height:1.5; position:relative;">
            <strong>ℹ️ Fee Breakdown:</strong> MWK 10,000 registration + MWK 800 agent processing fee = <strong>MWK 10,800 total</strong>
          </div>
        </div>

        <!-- Payment Methods -->
        <div class="methods-info">
          <div class="method-chip method-chip--airtel">
            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
            Airtel Money
          </div>
          <div class="method-chip method-chip--tnm">
            <svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
            TNM Mpamba
          </div>
          <div class="method-chip method-chip--card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            Card
          </div>
        </div>

        <!-- Pay Button -->
        <button class="pay-btn" id="pay-btn" onclick="initiatePayment()">
          <div class="spinner"></div>
          <span class="btn-text">Pay MWK 10,800 Now</span>
          <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

        <div class="divider"></div>

        <!-- Steps -->
        <div class="steps-title">How it works</div>

        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <div class="step-text">Click <strong>"Pay Now"</strong> to open the secure payment page</div>
          </div>
        </div>

        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <div class="step-text">Choose <strong>Airtel Money</strong>, <strong>TNM Mpamba</strong>, or <strong>Card</strong> and complete payment</div>
          </div>
        </div>

        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <div class="step-text">Your account is <strong>automatically activated</strong> after successful payment</div>
          </div>
        </div>

        <div class="step">
          <div class="step-number">4</div>
          <div class="step-content">
            <div class="step-text">Start accessing your dashboard and earning immediately</div>
          </div>
        </div>

        <!-- Secure Badge -->
        <div class="secure-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Secured by PayChangu • 256-bit encryption • Instant verification</span>
        </div>

        <!-- Footer -->
        <a href="/dashboard" class="footer-link">Return to Dashboard</a>

        <div class="footer-divider">
          <div class="line"></div>
          <span>Wisdom Vault • Secure Payment</span>
          <div class="line"></div>
        </div>

        <div class="footer-note">
          Payments are processed securely through PayChangu. Once you send exactly <strong>MWK 10,800</strong> (including MWK 800 agent fee), your account is verified instantly — no manual approval needed.
        </div>
      </div>
    `;

    // Auto-reconcile for any unverified account: settlement may lag the
    // browser redirect, or the webhook/callback may have been lost entirely.
    // The status endpoint re-checks pending checkouts directly against
    // PayChangu server-side; if there is no pending payment it returns
    // 'none' quickly and the pay button unlocks immediately.
    const storedUser = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
    if (storedUser && storedUser.id && statusParam !== 'failed' && statusParam !== 'error') {
      startReconcile(storedUser);
    }
  }

  async function initiatePayment() {
    const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
    if (!user.id) {
      window.location.href = '/login';
      return;
    }

    const btn = document.getElementById('pay-btn');
    btn.classList.add('loading');
    btn.disabled = true;

    try {
      const res = await fetch('/api/paychangu/initiate', {
        method: 'POST',
        headers: billingHeaders(),
        body: JSON.stringify({ userId: user.id })
      });

      const data = await res.json();

      if (data.success && data.checkoutUrl) {
        // Redirect to PayChangu checkout
        window.location.href = data.checkoutUrl;
      } else {
        btn.classList.remove('loading');
        btn.disabled = false;

        // Show error message
        const msgEl = document.createElement('div');
        msgEl.className = 'status-msg status-msg--error status-msg--show';
        msgEl.textContent = data.message || 'Failed to start payment. Please try again.';
        const card = btn.closest('.card');
        card.insertBefore(msgEl, btn);
      }
    } catch (err) {
      btn.classList.remove('loading');
      btn.disabled = false;

      const msgEl = document.createElement('div');
      msgEl.className = 'status-msg status-msg--error status-msg--show';
      msgEl.textContent = 'Network error. Please check your connection and try again.';
      const card = btn.closest('.card');
      card.insertBefore(msgEl, btn);
    }
  }

  // Make initiatePayment available globally
  window.initiatePayment = initiatePayment;

  document.addEventListener('DOMContentLoaded', renderBilling);
</script>
