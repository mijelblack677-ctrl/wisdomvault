---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhatInside from '../components/WhatInside.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Testimonials from '../components/Testimonials.astro';
import Support from '../components/Support.astro';
import Footer from '../components/Footer.astro';
import { getPublicStats } from '@lib/publicStats';

// Real counts from the database (cached in-process) so the landing page never
// advertises numbers that do not match the platform. Null when the DB is down.
const stats = await getPublicStats();
---

<BaseLayout>
  <div class="landing">
    <!-- HEADER -->
    <header class="header">
      <div class="header__inner">
        <a href="/" class="header__brand">
          <svg class="header__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="header__logo-text">Wisdom Vault</span>
        </a>
        <nav class="header__nav">
          <a href="/login" class="header__link">Login</a>
          <a href="/register" class="header__cta">Get Started</a>
        </nav>
      </div>
    </header>

    <!-- HERO -->
    <Hero courseCount={stats?.coursePackCount} bookCount={stats?.bookCount} />

    <!-- MARQUEE -->
    <div class="marquee-wrap">
      <div class="marquee-track">
        {['Philosophy', 'Productivity', 'Music Theory', 'AI Mastery', 'Mindfulness', 'Creative Writing', 'Focus Science', 'Stoic Practice'].map((topic, i) => (
          <div class="marquee-item" key={`${i}-a`}>
            <span class="marquee-text">{topic}</span>
            <span class="marquee-dot"></span>
          </div>
        ))}
        {['Philosophy', 'Productivity', 'Music Theory', 'AI Mastery', 'Mindfulness', 'Creative Writing', 'Focus Science', 'Stoic Practice'].map((topic, i) => (
          <div class="marquee-item" key={`${i}-b`}>
            <span class="marquee-text">{topic}</span>
            <span class="marquee-dot"></span>
          </div>
        ))}
      </div>
    </div>

    <!-- SECTIONS -->
    <WhatInside />
    <HowItWorks />
    <Pricing />
    <Testimonials />
    <Support />

    <!-- FOOTER BAR -->
    <div class="footer-bar">
      <span class="footer-bar__copy">&copy; 2024 Wisdom Vault &bull; Crafted for deep work</span>
      <div class="footer-bar__links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="#support">Support</a>
        <a href="mailto:support@vault-of-wisdom.com">Contact</a>
      </div>
    </div>

    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .landing {
    position: relative;
    width: 100%;
    overflow-x: hidden;
    background: #FFFCF5;
  }

  /* HEADER */
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,252,245,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(18,18,18,0.06);
  }

  .header__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #121212;
  }

  .header__icon {
    stroke: #121212;
  }

  .header__logo-text {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #121212;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .header__link:hover { opacity: 1; }

  .header__cta {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border-radius: 40px;
    background: #121212;
    color: #FFFCF5;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .header__cta:hover {
    background: #2a2a2a;
    transform: translateY(-1px);
  }

  /* MARQUEE */
  .marquee-wrap {
    border-top: 1px solid rgba(18,18,18,0.06);
    border-bottom: 1px solid rgba(18,18,18,0.06);
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(8px);
    overflow: hidden;
    padding: 0;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 30s linear infinite;
    align-items: center;
    gap: 0;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 16px 24px 16px 0;
    flex-shrink: 0;
  }

  .marquee-text {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-size: 22px;
    color: #121212;
    opacity: 0.8;
    white-space: nowrap;
  }

  .marquee-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #FFB400;
    flex-shrink: 0;
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* FOOTER BAR */
  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: rgba(18,18,18,0.4);
    letter-spacing: 0.025em;
    border-top: 1px solid rgba(18,18,18,0.06);
  }

  .footer-bar__links {
    display: flex;
    gap: 16px;
  }

  .footer-bar__links a {
    color: rgba(18,18,18,0.4);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-bar__links a:hover {
    color: #121212;
  }

  @media (max-width: 600px) {
    .header__inner {
      padding: 12px 16px;
    }

    .header__link {
      display: none;
    }

    .header__cta {
      padding: 8px 16px;
      font-size: 12px;
    }

    .footer-bar {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
