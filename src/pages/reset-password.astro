---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="pw-page">
    <section class="pw-card">
      <div class="pw-icon">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#c09a8a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="10" rx="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>

      <h1 class="pw-title">Choose a new password</h1>
      <p class="pw-subtitle">Enter a new password for your Wisdom Vault account.</p>

      <form id="reset-form" class="pw-form" novalidate>
        <div class="pw-field">
          <label class="pw-label" for="reset-password">New password</label>
          <input
            type="password"
            id="reset-password"
            class="pw-input"
            placeholder="At least 6 characters"
            autocomplete="new-password"
            required
          />
        </div>

        <div class="pw-field">
          <label class="pw-label" for="reset-confirm">Confirm new password</label>
          <input
            type="password"
            id="reset-confirm"
            class="pw-input"
            placeholder="Re-enter your new password"
            autocomplete="new-password"
            required
          />
        </div>

        <button type="submit" class="pw-btn" id="reset-submit">
          <span>Reset password</span>
        </button>

        <div id="reset-message" class="pw-message" style="display:none;"></div>

        <!-- Shown only when the page was opened without a valid token, so the
             user is never stranded on a dead end with no way to start over. -->
        <a href="/forgot-password" id="reset-retry" class="pw-retry" style="display:none;">Request a new reset link &rarr;</a>
      </form>

      <p class="pw-back">
        <a href="/login" class="pw-back-link">&larr; Back to sign in</a>
      </p>
    </section>
  </div>

  <style>
    .pw-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 18px;
      background: #f5f1ee;
    }
    .pw-card {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border: 1px solid #e7ded8;
      border-radius: 16px;
      padding: 34px 30px;
      box-shadow: 0 18px 50px rgba(45, 35, 39, 0.08);
    }
    .pw-icon {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(192, 154, 138, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }
    .pw-title {
      margin: 0 0 8px;
      font-size: 22px;
      font-weight: 700;
      text-align: center;
      color: #2d2327;
    }
    .pw-subtitle {
      margin: 0 0 24px;
      font-size: 13.5px;
      line-height: 1.6;
      text-align: center;
      color: #8a7a72;
    }
    .pw-form { display: block; }
    .pw-field { margin-bottom: 18px; }
    .pw-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: #4a3f43;
      margin-bottom: 7px;
    }
    .pw-input {
      width: 100%;
      box-sizing: border-box;
      padding: 13px 14px;
      font-size: 14px;
      color: #2d2327;
      background: #faf7f5;
      border: 1px solid #e7ded8;
      border-radius: 10px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .pw-input:focus {
      border-color: #c09a8a;
      box-shadow: 0 0 0 3px rgba(192, 154, 138, 0.15);
    }
    .pw-btn {
      width: 100%;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      background: #2d2327;
      cursor: pointer;
      transition: background 0.15s, opacity 0.15s;
    }
    .pw-btn:hover { background: #443438; }
    .pw-btn:disabled { opacity: 0.6; cursor: default; }
    .pw-message {
      margin-top: 16px;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13px;
      line-height: 1.55;
    }
    .pw-message--success {
      background: #eef6ee;
      color: #2f6b34;
      border: 1px solid #cfe6d0;
    }
    .pw-message--error {
      background: #fbeeee;
      color: #a13c3c;
      border: 1px solid #f0d0d0;
    }
    .pw-retry {
      display: block;
      margin-top: 16px;
      padding: 12px 14px;
      border-radius: 10px;
      text-align: center;
      font-size: 14px;
      font-weight: 700;
      color: #2d2327;
      background: #f0e6e0;
      border: 1px solid #e0d2ca;
      text-decoration: none;
      transition: background 0.15s;
    }
    .pw-retry:hover { background: #e7dcd6; }
    .pw-back {
      margin: 22px 0 0;
      text-align: center;
      font-size: 13px;
    }
    .pw-back-link {
      color: #8a7a72;
      text-decoration: none;
      font-weight: 600;
    }
    .pw-back-link:hover { color: #c09a8a; }
  </style>

  <script>
    const params = new URLSearchParams(window.location.search);
    const token = (params.get('token') || '').trim();

    const form = document.getElementById('reset-form') as HTMLFormElement;
    const btn = document.getElementById('reset-submit') as HTMLButtonElement;
    const msg = document.getElementById('reset-message') as HTMLDivElement;

    function show(text: string, kind: 'success' | 'error') {
      msg.textContent = text;
      msg.className = 'pw-message pw-message--' + kind;
      msg.style.display = 'block';
    }

    const retry = document.getElementById('reset-retry') as HTMLAnchorElement;

    if (!token) {
      show('This reset link is missing its token or has expired. Request a new one below.', 'error');
      form?.querySelectorAll('input, button').forEach((el) => ((el as HTMLInputElement).disabled = true));
      if (retry) retry.style.display = 'block';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.style.display = 'none';

      const password = (document.getElementById('reset-password') as HTMLInputElement)?.value || '';
      const confirm = (document.getElementById('reset-confirm') as HTMLInputElement)?.value || '';

      if (password.length < 6) {
        show('Password must be at least 6 characters long.', 'error');
        return;
      }
      if (password !== confirm) {
        show('The two passwords do not match.', 'error');
        return;
      }

      btn.disabled = true;
      const label = btn.querySelector('span');
      const original = label ? label.textContent : '';
      if (label) label.textContent = 'Resetting...';

      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, password }),
        });
        const data = await res.json();
        show(data.message || 'Done.', data.success ? 'success' : 'error');
        if (data.success) {
          form.reset();
          setTimeout(() => {
            window.location.href = '/login';
          }, 2500);
        }
      } catch {
        show('Network error. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        if (label) label.textContent = original;
      }
    });
  </script>
</BaseLayout>
