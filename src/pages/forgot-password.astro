---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="pw-page">
    <section class="pw-card">
      <div class="pw-icon">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#c09a8a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="10" rx="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>

      <h1 class="pw-title">Forgot your password?</h1>
      <p class="pw-subtitle">
        Enter the email address on your account and we'll send you a link to choose a new password.
      </p>

      <form id="forgot-form" class="pw-form" novalidate>
        <div class="pw-field">
          <label class="pw-label" for="forgot-email">Email address</label>
          <input
            type="email"
            id="forgot-email"
            class="pw-input"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
        </div>

        <button type="submit" class="pw-btn" id="forgot-submit">
          <span>Send reset link</span>
        </button>

        <div id="forgot-message" class="pw-message" style="display:none;"></div>
      </form>

      <p class="pw-back">
        <a href="/login" class="pw-back-link">&larr; Back to sign in</a>
      </p>
    </section>
  </div>

  <style>
    .pw-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 32px 18px;
      background: #f5f1ee;
    }
    .pw-card {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border: 1px solid #e7ded8;
      border-radius: 16px;
      padding: 34px 30px;
      box-shadow: 0 18px 50px rgba(45, 35, 39, 0.08);
    }
    .pw-icon {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(192, 154, 138, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 18px;
    }
    .pw-title {
      margin: 0 0 8px;
      font-size: 22px;
      font-weight: 700;
      text-align: center;
      color: #2d2327;
    }
    .pw-subtitle {
      margin: 0 0 24px;
      font-size: 13.5px;
      line-height: 1.6;
      text-align: center;
      color: #8a7a72;
    }
    .pw-form { display: block; }
    .pw-field { margin-bottom: 18px; }
    .pw-label {
      display: block;
      font-size: 12.5px;
      font-weight: 600;
      color: #4a3f43;
      margin-bottom: 7px;
    }
    .pw-input {
      width: 100%;
      box-sizing: border-box;
      padding: 13px 14px;
      font-size: 14px;
      color: #2d2327;
      background: #faf7f5;
      border: 1px solid #e7ded8;
      border-radius: 10px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .pw-input:focus {
      border-color: #c09a8a;
      box-shadow: 0 0 0 3px rgba(192, 154, 138, 0.15);
    }
    .pw-btn {
      width: 100%;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      background: #2d2327;
      cursor: pointer;
      transition: background 0.15s, opacity 0.15s;
    }
    .pw-btn:hover { background: #443438; }
    .pw-btn:disabled { opacity: 0.6; cursor: default; }
    .pw-message {
      margin-top: 16px;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13px;
      line-height: 1.55;
    }
    .pw-message--success {
      background: #eef6ee;
      color: #2f6b34;
      border: 1px solid #cfe6d0;
    }
    .pw-message--error {
      background: #fbeeee;
      color: #a13c3c;
      border: 1px solid #f0d0d0;
    }
    .pw-back {
      margin: 22px 0 0;
      text-align: center;
      font-size: 13px;
    }
    .pw-back-link {
      color: #8a7a72;
      text-decoration: none;
      font-weight: 600;
    }
    .pw-back-link:hover { color: #c09a8a; }
  </style>

  <script>
    const form = document.getElementById('forgot-form') as HTMLFormElement;
    const btn = document.getElementById('forgot-submit') as HTMLButtonElement;
    const msg = document.getElementById('forgot-message') as HTMLDivElement;

    function show(text: string, kind: 'success' | 'error') {
      msg.textContent = text;
      msg.className = 'pw-message pw-message--' + kind;
      msg.style.display = 'block';
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.style.display = 'none';

      const email = (document.getElementById('forgot-email') as HTMLInputElement)?.value.trim();
      if (!email || !email.includes('@')) {
        show('Please enter a valid email address.', 'error');
        return;
      }

      btn.disabled = true;
      const label = btn.querySelector('span');
      const original = label ? label.textContent : '';
      if (label) label.textContent = 'Sending...';

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        show(data.message || 'If an account exists, a reset link has been sent.', data.success ? 'success' : 'error');
        if (data.success) form.reset();
      } catch {
        show('Network error. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        if (label) label.textContent = original;
      }
    });
  </script>
</BaseLayout>
