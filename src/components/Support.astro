---
// Support & FAQ section for the landing page.
// Contact details + answers to the questions people ask before joining, plus
// downloadable PDF versions of the full documents (served from /public/docs).
const SUPPORT_EMAIL = 'support@vault-of-wisdom.com';

const faqs = [
  {
    q: 'What exactly is Wisdom Vault?',
    a: 'Wisdom Vault is a paid digital learning platform. A membership gives you access to curated learning content — courses, guides, ebooks and videos — across business and finance, technology, personal growth and practical skills. It is not a bank, does not take deposits and does not promise any financial return.',
  },
  {
    q: 'Am I forced or pressured to join and pay?',
    a: 'No. Registration is free and separate from payment. You are shown the full price before you pay, and every payment is authorized by you on your own phone through your mobile-money provider. Nobody can deduct money from you without your own action, and choosing not to join has no consequence.',
  },
  {
    q: 'What do I actually pay for?',
    a: 'Your fee buys access to learning content. It is not an investment and it is not money that gets multiplied for you. The price is always shown on the pricing page, the registration page and again on the payment page before you confirm.',
  },
  {
    q: 'Is this a pyramid scheme? How do referral rewards work?',
    a: 'No. You are buying content, not an opportunity — and no member is ever required to recruit anyone. Members who never invite a single person keep full access to everything they paid for. Referral rewards are a fixed bonus, paid only when someone you invited freely chooses to join and pay. They are never promised as a salary or guaranteed income.',
  },
  {
    q: 'Are fees refundable?',
    a: 'Paid fees are non-refundable once you have paid, which is why you are asked to confirm you understand this is a paid service before your account is created and why the full amount is always shown before you pay. Your earned wallet balance always stays yours: if a withdrawal cannot be paid out, the full amount is returned to your wallet automatically.',
  },
  {
    q: 'Is Wisdom Vault legal?',
    a: 'Yes — selling access to digital learning content is ordinary, lawful commerce, the same as selling online courses, ebooks or a magazine subscription. Malawian law prohibits pyramid and chain schemes; Wisdom Vault has a real product, nobody is required to recruit, no returns are promised, and every payment leaves a verifiable record with the payment gateway.',
  },
];

const documents = [
  {
    title: 'Wisdom Vault — User FAQ',
    description:
      'The full plain-language guide for members and the public: who we are, what you pay for, and why joining is always your own free choice.',
    href: '/docs/Wisdom_Vault_User_FAQ.pdf',
    size: 'PDF · 84 KB',
  },
  {
    title: 'Wisdom Vault — Business Information',
    description:
      'A detailed summary for banks, mobile-money operators and payment partners covering how the platform operates and how payments work.',
    href: '/docs/Wisdom_Vault_Business_Information.pdf',
    size: 'PDF · 102 KB',
  },
];
---

<section class="support" id="support">
  <div class="support__container">
    <div class="support__intro">
      <span class="support__eyebrow">Support</span>
      <h2 class="support__title">Questions, answered honestly</h2>
      <p class="support__subtitle">
        Before you join, or if anything is ever unclear, here are the answers we give most often.
        Still unsure? Email us — we answer openly.
      </p>
    </div>

    <!-- FAQ -->
    <div class="support__faq">
      {faqs.map((item) => (
        <details class="faq">
          <summary class="faq__question">
            <span>{item.q}</span>
            <svg class="faq__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="faq__answer">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Contact + downloads -->
    <div class="support__panel">
      <div class="support__contact">
        <span class="support__panel-label">Talk to us</span>
        <h3 class="support__panel-title">We would rather you ask than wonder.</h3>
        <p class="support__panel-text">
          If you have a question, a complaint, or someone has told you that you must pay or that you
          will get rich through Wisdom Vault, tell us. Most issues are resolved quickly once we can
          look at the account and the payment reference together.
        </p>
        <a class="support__email" href={`mailto:${SUPPORT_EMAIL}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span>{SUPPORT_EMAIL}</span>
        </a>
        <p class="support__meta">Operator: The Vault · independent digital business, Malawi</p>
      </div>

      <div class="support__docs">
        <span class="support__panel-label">Download &amp; keep</span>
        {documents.map((doc) => (
          <a class="doc" href={doc.href} download>
            <span class="doc__icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
            </span>
            <span class="doc__body">
              <span class="doc__title">{doc.title}</span>
              <span class="doc__desc">{doc.description}</span>
              <span class="doc__size">{doc.size}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .support {
    padding: 100px 32px 40px;
    position: relative;
    z-index: 10;
  }

  .support__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .support__intro {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .support__eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FFB400;
    margin-bottom: 14px;
  }

  .support__title {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: 40px;
    line-height: 1.15;
    color: #121212;
    margin-bottom: 16px;
  }

  .support__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #6B6B6B;
  }

  /* FAQ accordion */
  .support__faq {
    max-width: 820px;
    margin: 0 auto;
    border-top: 1px solid rgba(18,18,18,0.08);
  }

  .faq {
    border-bottom: 1px solid rgba(18,18,18,0.08);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #121212;
    transition: color 0.2s ease;
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question:hover { color: #FFB400; }

  .faq__chevron {
    flex-shrink: 0;
    color: #FFB400;
    transition: transform 0.25s ease;
  }

  .faq[open] .faq__chevron { transform: rotate(180deg); }

  .faq__answer {
    padding: 0 40px 24px 4px;
  }

  .faq__answer p {
    font-family: 'Inter', sans-serif;
    font-size: 14.5px;
    line-height: 1.75;
    color: #6B6B6B;
  }

  /* Contact + download panel */
  .support__panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 64px;
  }

  .support__contact,
  .support__docs {
    background: rgba(255,255,255,0.6);
    border: 1px solid rgba(18,18,18,0.07);
    border-radius: 18px;
    padding: 32px;
  }

  .support__panel-label {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #FFB400;
    margin-bottom: 14px;
  }

  .support__panel-title {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
    color: #121212;
    margin-bottom: 12px;
  }

  .support__panel-text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #6B6B6B;
    margin-bottom: 22px;
  }

  .support__email {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    min-height: 48px;
    border-radius: 40px;
    background: #121212;
    color: #FFFCF5;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
    max-width: 100%;
  }

  .support__email svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .support__email span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .support__email:hover {
    background: #2a2a2a;
    transform: translateY(-1px);
  }

  .support__meta {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: rgba(18,18,18,0.4);
    margin-top: 16px;
  }

  .doc {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(18,18,18,0.07);
    background: rgba(255,252,245,0.7);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .doc + .doc { margin-top: 14px; }

  .doc:hover {
    border-color: rgba(255,180,0,0.4);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(18,18,18,0.06);
  }

  .doc__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,180,0,0.12);
    color: #FFB400;
  }

  .doc__body { display: flex; flex-direction: column; gap: 2px; }

  .doc__title {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #121212;
  }

  .doc__desc {
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    line-height: 1.55;
    color: #6B6B6B;
  }

  .doc__size {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #FFB400;
    margin-top: 4px;
  }

  @media (max-width: 860px) {
    .support__panel { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .support { padding: 72px 20px 32px; }
    .support__title { font-size: 30px; }
    .faq__question { font-size: 15px; padding: 18px 2px; }
    .faq__answer { padding: 0 2px 20px; }
    .support__contact, .support__docs { padding: 24px; }
    .support__email {
      width: 100%;
      justify-content: center;
      flex-direction: column;
      border-radius: 18px;
      padding: 14px 20px;
      text-align: center;
    }
  }
</style>
