          <a href="#" class="social-link" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer__links">
        <h4 class="footer__links-title">Platform</h4>
        <a href="/register" class="footer__link">Get Started</a>
        <a href="/login" class="footer__link">Sign In</a>
        <a href="#join" class="footer__link">Pricing</a>
      </div>

      <div class="footer__links">
        <h4 class="footer__links-title">Support</h4>
        <a href="#support" class="footer__link">Help Center</a>
        <a href="mailto:support@vault-of-wisdom.com" class="footer__link">Contact Us</a>
        <a href="/privacy" class="footer__link">Privacy Policy</a>
        <a href="/terms" class="footer__link">Terms of Service</a>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; 2026 Wisdom Vault. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 80px 32px 40px;
    border-top: 1px solid rgba(18,18,18,0.06);
    position: relative;
    z-index: 10;
  }

  .footer__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer__logo {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: 24px;
    color: #121212;
    margin-bottom: 16px;
  }

  .footer__desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #6B6B6B;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 320px;
  }

  .footer__social {
    display: flex;
    gap: 12px;
  }

  .social-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(18,18,18,0.04);
    border: 1px solid rgba(18,18,18,0.08);
    border-radius: 10px;
    color: #6B6B6B;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: rgba(255,180,0,0.1);
    border-color: rgba(255,180,0,0.2);
    color: #121212;
    transform: translateY(-2px);
  }

  .footer__links-title {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #121212;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer__link {
    display: block;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #6B6B6B;
    text-decoration: none;
    margin-bottom: 12px;
    transition: color 0.3s ease;
  }

  .footer__link:hover { color: #FFB400; }

  .footer__bottom {
    padding-top: 32px;
    border-top: 1px solid rgba(18,18,18,0.06);
  }

  .footer__copyright {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #6B6B6B;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .footer__desc { max-width: 100%; }
    .footer__social { justify-content: center; }
  }
</style>
