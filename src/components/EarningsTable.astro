---
---
<section id="earnings" class="section earnings">
  <div class="container">
    
    <!-- Section Header -->
    <div class="earnings__header">
      <p class="earnings__label">Earnings</p>
      <h2 class="earnings__title">Transparent <span class="text-accent">Rewards</span></h2>
      <p class="earnings__subtitle">No hidden fees. No minimum quotas. No complicated tiers. Just honest earnings for sharing what you love.</p>
    </div>

    <!-- Commission Table -->
    <div class="earnings__table-wrapper">
      <table class="earnings__table">
        <thead>
          <tr>
            <th>What</th>
            <th>Amount</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="table__label-cell">
              <span class="table__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </span>
              Registration Fee (Year 1)
            </td>
            <td class="table__amount">13,000</td>
            <td class="table__detail">One-time payment for full access</td>
          </tr>
          <tr>
            <td class="table__label-cell">
              <span class="table__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              </span>
              Your Referral Bonus
            </td>
            <td class="table__amount accent">5,200</td>
            <td class="table__detail">Per new member you bring</td>
          </tr>
          <tr>
            <td class="table__label-cell">
              <span class="table__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              </span>
              Renewal Bonus
            </td>
            <td class="table__amount accent">1,000</td>
            <td class="table__detail">Every year your referral renews</td>
          </tr>
          <tr>
            <td class="table__label-cell">
              <span class="table__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              </span>
              Withdrawal Fee
            </td>
            <td class="table__amount">20%</td>
            <td class="table__detail">Covers payment processing & platform costs</td>
          </tr>
          <tr>
            <td class="table__label-cell">
              <span class="table__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </span>
              Founding Member Bonus
            </td>
            <td class="table__amount accent">6,500</td>
            <td class="table__detail">First 100 members earn extra per referral</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Example Scenarios -->
    <div class="earnings__examples">
      <h3 class="earnings__examples-title">What This Looks Like in Real Terms</h3>
      
      <div class="earnings__examples-grid">
        
        <!-- Example 1 -->
        <div class="example-card">
          <div class="example-card__badge">Example</div>
          <div class="example-card__header">
            <span class="example-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </span>
            <div>
              <h4 class="example-card__name">Casual Sharer</h4>
              <p class="example-card__refs">5 referrals</p>
            </div>
          </div>
          <div class="example-card__calc">
            <div class="calc-row">
              <span>5 × 5,200</span>
              <span class="calc-row__value">26,000</span>
            </div>
            <div class="calc-row">
              <span>Withdrawal fee (20%)</span>
              <span class="calc-row__value deduct">−5,200</span>
            </div>
            <div class="calc-row calc-row--total">
              <span>You receive</span>
              <span class="calc-row__value accent">20,800</span>
            </div>
          </div>
          <p class="example-card__note">Plus: Full access to the entire Wisdom Vault library — worth far more than your registration fee.</p>
        </div>

        <!-- Example 2 -->
        <div class="example-card">
          <div class="example-card__badge">Example</div>
          <div class="example-card__header">
            <span class="example-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </span>
            <div>
              <h4 class="example-card__name">Active Referrer</h4>
              <p class="example-card__refs">20 referrals</p>
            </div>
          </div>
          <div class="example-card__calc">
            <div class="calc-row">
              <span>20 × 5,200</span>
              <span class="calc-row__value">104,000</span>
            </div>
            <div class="calc-row">
              <span>Withdrawal fee (20%)</span>
              <span class="calc-row__value deduct">−20,800</span>
            </div>
            <div class="calc-row calc-row--total">
              <span>You receive</span>
              <span class="calc-row__value accent">83,200</span>
            </div>
          </div>
          <p class="example-card__note">Plus: Renewal bonuses every year your referrals stay. And lifetime access to all Vault content.</p>
        </div>

      </div>
    </div>

    <!-- Founding Members Callout -->
    <div class="earnings__founding">
      <div class="founding-badge">
        <span class="founding-badge__dot"></span>
        <span>Founding Members earn <strong>6,500</strong> per referral — limited to first 100 members</span>
      </div>
    </div>

  </div>
</section>

<style>
  .earnings {
    background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
    position: relative;
    z-index: 10;
  }

  .earnings__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .earnings__label {
    font-family: var(--font-body);
    font-size: clamp(11px, 0.8vw, 14px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #F5A623;
    margin-bottom: 16px;
  }

  .earnings__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .text-accent {
    color: #F5A623;
    text-shadow: 0 0 20px rgba(245, 166, 35, 0.2);
  }

  .earnings__subtitle {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.1vw, 20px);
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .earnings__table-wrapper {
    max-width: 800px;
    margin: 0 auto 72px;
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid var(--card-border);
  }

  .earnings__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--card-bg);
  }

  .earnings__table thead th {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: left;
    padding: 18px 24px;
    border-bottom: 1px solid var(--card-border);
  }

  .earnings__table tbody td {
    padding: 18px 24px;
    border-bottom: 1px solid rgba(26, 26, 26, 0.5);
    font-family: var(--font-body);
    font-size: clamp(14px, 0.9vw, 16px);
    color: var(--text);
    vertical-align: middle;
  }

  .earnings__table tbody tr:last-child td {
    border-bottom: none;
  }

  .earnings__table tbody tr {
    transition: background 0.3s ease;
  }

  .earnings__table tbody tr:hover {
    background: rgba(245, 166, 35, 0.03);
  }

  .table__label-cell {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .table__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: rgba(245, 166, 35, 0.08);
    border-radius: 6px;
    color: #F5A623;
    flex-shrink: 0;
  }

  .table__amount {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(18px, 1.2vw, 22px);
    white-space: nowrap;
  }

  .table__amount.accent {
    color: #F5A623;
    text-shadow: 0 0 15px rgba(245, 166, 35, 0.15);
  }

  .table__detail {
    color: var(--muted);
    font-size: clamp(13px, 0.85vw, 14px);
  }

  @media (max-width: 600px) {
    .earnings__table thead th,
    .earnings__table tbody td {
      padding: 14px 12px;
    }
    .table__label-cell {
      font-size: 13px;
    }
    .table__icon {
      width: 28px;
      height: 28px;
    }
    .table__icon svg {
      width: 14px;
      height: 14px;
    }
    .table__amount {
      font-size: 15px;
    }
    .table__detail {
      font-size: 11px;
    }
    .earnings__table-wrapper {
      margin-bottom: 48px;
    }
  }

  .earnings__examples {
    margin-bottom: 48px;
  }

  .earnings__examples-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 1.5vw, 26px);
    color: var(--text);
    text-align: center;
    margin-bottom: 32px;
  }

  .earnings__examples-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 800px;
    margin: 0 auto;
  }

  @media (max-width: 650px) {
    .earnings__examples-grid {
      grid-template-columns: 1fr;
    }
  }

  .example-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 28px 24px;
    position: relative;
  }

  .example-card__badge {
    position: absolute;
    top: -10px;
    right: 20px;
    background: #F5A623;
    color: #0B0B0B;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .example-card__header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .example-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(245, 166, 35, 0.08);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .example-card__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(16px, 1.1vw, 20px);
    color: var(--text);
    margin-bottom: 2px;
  }

  .example-card__refs {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--muted);
  }

  .example-card__calc {
    border-top: 1px solid var(--card-border);
    padding-top: 16px;
    margin-bottom: 16px;
  }

  .calc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 0;
    font-family: var(--font-body);
    font-size: clamp(13px, 0.85vw, 15px);
    color: var(--muted);
  }

  .calc-row__value {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text);
  }

  .calc-row__value.deduct {
    color: #e05555;
  }

  .calc-row__value.accent {
    color: #F5A623;
    text-shadow: 0 0 15px rgba(245, 166, 35, 0.15);
  }

  .calc-row--total {
    border-top: 1px solid rgba(245, 166, 35, 0.2);
    padding-top: 10px;
    margin-top: 4px;
    font-weight: 600;
  }

  .calc-row--total span:first-child {
    color: var(--text);
  }

  .example-card__note {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
    font-style: italic;
  }

  .earnings__founding {
    text-align: center;
  }

  .founding-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(245, 166, 35, 0.08);
    border: 1px solid rgba(245, 166, 35, 0.25);
    border-radius: 30px;
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: clamp(13px, 0.85vw, 15px);
    color: var(--text);
  }

  .founding-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4CAF50;
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  .founding-badge strong {
    color: #F5A623;
    text-shadow: 0 0 15px rgba(245, 166, 35, 0.15);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; box-shadow: 0 0 4px #4CAF50; }
    50% { opacity: 0.5; box-shadow: 0 0 12px #4CAF50; }
  }
</style>
