---
---

<section class="steps">
  <div class="steps__container">
    <div class="steps__header">
      <span class="steps__label">How It Works</span>
      <h2 class="steps__title">
        Start in
        <em class="steps__title-accent">3 Simple Steps</em>
      </h2>
    </div>

    <div class="steps__grid">
      <div class="step-card">
        <div class="step-card__number">01</div>
        <div class="step-card__line"></div>
        <h3 class="step-card__title">Create Account</h3>
        <p class="step-card__desc">
          Sign up in seconds. No credit card required to get started.
        </p>
      </div>

      <div class="step-card">
        <div class="step-card__number">02</div>
        <div class="step-card__line"></div>
        <h3 class="step-card__title">Explore Content</h3>
        <p class="step-card__desc">
          Browse courses, watch AI videos, and discover curated music.
        </p>
      </div>

      <div class="step-card">
        <div class="step-card__number">03</div>
        <div class="step-card__line"></div>
        <h3 class="step-card__title">Learn & Earn</h3>
        <p class="step-card__desc">
          Complete courses, share with friends, and earn rewards.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    padding: 100px 32px;
    position: relative;
    z-index: 10;
  }

  .steps__container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .steps__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .steps__label {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #FFB400;
    margin-bottom: 16px;
    display: block;
  }

  .steps__title {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: clamp(32px, 4vw, 48px);
    color: #121212;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .steps__title-accent {
    font-style: italic;
    color: #FFB400;
  }

  .steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .step-card {
    text-align: center;
    position: relative;
  }

  .step-card__number {
    font-family: 'Instrument Serif', 'Playfair Display', Georgia, serif;
    font-size: 64px;
    font-weight: 400;
    color: rgba(255,180,0,0.15);
    line-height: 1;
    margin-bottom: 16px;
  }

  .step-card__line {
    width: 40px;
    height: 3px;
    background: linear-gradient(90deg, #FFB400, #FFAA00);
    margin: 0 auto 20px;
    border-radius: 2px;
  }

  .step-card__title {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 20px;
    color: #121212;
    margin-bottom: 12px;
  }

  .step-card__desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #6B6B6B;
    line-height: 1.6;
    max-width: 280px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .steps__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .step-card__number { font-size: 48px; }
  }

  @media (max-width: 600px) {
    .steps { padding: 60px 16px; }
  }
</style>
