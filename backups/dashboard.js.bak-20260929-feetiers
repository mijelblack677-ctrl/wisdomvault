function attachCourseModalEvents(courseId) {
  document.getElementById('course-modal-close').addEventListener('click', e => { e.stopPropagation(); closeCourseDetail(); });
  document.getElementById('course-modal-bg').addEventListener('click', e => { e.stopPropagation(); closeCourseDetail(); });

  document.querySelectorAll('.view-lesson-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      const lessonUrl = this.dataset.lessonUrl;
      const lessonType = this.dataset.lessonType || 'url';
      const lessonTitle = this.dataset.lessonTitle || 'Lesson';
      const isVideo = this.dataset.isVideo === 'true';
      
      if (!lessonUrl || lessonUrl === '') {
        showToast('No content URL available for this lesson');
        return;
      }
      
      // Check if it's a video (supports all platforms)
      const videoPlatforms = ['youtube', 'vimeo', 'tiktok', 'instagram', 'facebook', 'twitter', 'video'];
      const isVideoUrl = videoPlatforms.includes(lessonType) || 
                         lessonUrl.includes('youtube.com') || 
                         lessonUrl.includes('youtu.be') ||
                         lessonUrl.includes('vimeo.com') ||
                         lessonUrl.includes('tiktok.com') ||
                         lessonUrl.includes('instagram.com') ||
                         lessonUrl.includes('facebook.com') ||
                         lessonUrl.includes('fb.watch') ||
                         lessonUrl.includes('twitter.com') ||
                         lessonUrl.includes('x.com') ||
                         lessonUrl.match(/\.(mp4|webm|mov|avi|mkv|m4v|ogv|3gp)$/i);
      
      // If it's a video, use the universal video embed
      if (isVideo || isVideoUrl) {
        // Check if we have the universal video embed function
        if (typeof renderVideoEmbed === 'function') {
          // Open in a modal/player
          openLessonViewer(lessonUrl, lessonType, lessonTitle);
          return;
        }
        
        // Fallback: Open in new tab
        window.open(lessonUrl, '_blank');
        return;
      }
      
      // For non-video content (PDF, audio, etc.)
      if (typeof openLessonViewer === 'function') {
        openLessonViewer(lessonUrl, lessonType, lessonTitle);
      } else {
        showToast('Lesson viewer not available');
      }
    });
  });

  document.querySelectorAll('.mark-lesson-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const lessonId = this.dataset.lessonId;
      if (!lessonId) return;
      const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
      
      fetch('/api/content/course-progress', {
        method: 'POST',
        headers: authHeaders(),
        body: JSON.stringify({ userId: user.id, courseId: courseId, lessonId: lessonId })
      })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          invalidateFor('/content/course-progress');
          showToast('Lesson marked as complete!');
          openCourseDetail(courseId);
          if (data.stats && data.stats.isComplete) {
            if (typeof fireConfetti === 'function') fireConfetti();
            showToast(ICON.graduation + ' Congratulations! You completed the course!');
          }
        } else {
          showToast(data.message || 'Failed to mark lesson as complete');
        }
      })
      .catch(() => showToast('Network error. Please try again.'));
    });
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('course-detail-modal');
      if (modal && modal.style.display === 'flex') closeCourseDetail();
    }
  });
}

function closeCourseDetail() {
  const modal = document.getElementById('course-detail-modal');
  if (modal) modal.style.display = 'none';
  document.body.style.overflow = '';
}

function updateCoursesCount(count) {
  const el = document.getElementById('courses-count');
  if (el) el.textContent = count + ' course' + (count !== 1 ? 's' : '');
}

function showCoursesEmpty() {
  const grid = document.getElementById('courses-grid');
  const empty = document.getElementById('courses-empty');
  if (grid) grid.innerHTML = '';
  if (empty) empty.style.display = 'block';
  updateCoursesCount(0);
}

function setupCoursesListeners() {
  document.querySelectorAll('.courses-tab-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      document.querySelectorAll('.courses-tab-btn').forEach(b => {
        b.classList.remove('active');
        b.style.background = 'rgba(45,35,39,0.05)';
        b.style.color = '#2d2327';
      });
      this.classList.add('active');
      this.style.background = '#2d2327';
      this.style.color = '#ffffff';
      coursesCurrentTab = this.dataset.tab;
      applyCoursesFilters();
    });
  });

  const searchInput = document.getElementById('courses-search');
  if (searchInput) searchInput.addEventListener('input', function() { coursesSearchQuery = this.value; applyCoursesFilters(); });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('course-detail-modal');
      if (modal && modal.style.display === 'flex') closeCourseDetail();
    }
  });
}

