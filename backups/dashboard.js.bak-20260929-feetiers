  }
  
  // ============================================================
  // UNIVERSAL VIDEO EMBED - SUPPORTS ALL PLATFORMS
  // ============================================================
  
  // Check if we have the universal video embed function
  if (typeof renderVideoEmbed === 'function') {
    // Use the universal video embed system
    const videoContainer = document.createElement('div');
    videoContainer.style.cssText = 'width:100%;';
    player.innerHTML = '';
    player.appendChild(videoContainer);
    
    renderVideoEmbed(link, videoContainer, {
      controls: true,
      autoplay: true,
