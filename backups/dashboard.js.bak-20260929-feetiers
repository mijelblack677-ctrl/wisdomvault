}

function stopAllEarnMedia() {
  const player = document.getElementById('earn-modal-player');
  if (!player) return;

  // Stop all iframes (YouTube, Vimeo, TikTok, etc.)
  player.querySelectorAll('iframe').forEach(iframe => {
    try {
      iframe.src = 'about:blank';
      iframe.remove();
    } catch(e) {}
  });

  // Stop all video elements
  player.querySelectorAll('video').forEach(video => {
    try {
      video.pause();
      video.removeAttribute('src');
      video.load();
      video.remove();
    } catch(e) {}
  });

  // Stop all audio elements
  player.querySelectorAll('audio').forEach(audio => {
    try {
      audio.pause();
      audio.removeAttribute('src');
      audio.load();
      audio.remove();
    } catch(e) {}
  });

  // Stop any HTML5 audio via YouTube API (if accessible)
  try {
    document.querySelectorAll('iframe[src*="youtube"], iframe[src*="vimeo"], iframe[src*="tiktok"]').forEach(f => {
      f.src = 'about:blank';
    });
  } catch(e) {}

  // Clear the player container
  player.innerHTML = '';
}

function closeEarnModal() {
  // Stop all media playback immediately
  stopAllEarnMedia();

  // If timer wasn't completed and countdown is active, cancel the reward
  if (earnWatchCountdown && !earnWatchTimerCompleted) {
    clearInterval(earnWatchCountdown);
    earnWatchCountdown = null;
    earnWatchTimerCompleted = false;
    showToast(ICON.alert + ' Reward cancelled - please complete the video to earn');
  }
  if (earnWatchCountdown) { clearInterval(earnWatchCountdown); earnWatchCountdown = null; }
  document.getElementById('earn-modal').style.display = 'none';
  document.body.style.overflow = '';
}

function claimEarnReward(contentId, reward) {
  const user = JSON.parse(localStorage.getItem("wisdom_vault_user") || "{}");
  fetch('/api/earn/watch', {
    method: 'POST',        headers: authHeaders(),
    body: JSON.stringify({ userId: user.id, contentId: contentId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      invalidateFor('/earn/watch'); // watched-state changed — refetch fresh
      earnWatchBalance += reward;
      earnWatchTotalEarned += reward;
      earnWatchWatchedToday++;
      updateEarnStats();
      closeEarnModal();
      fireConfetti();
      showToast(ICON.check + ' Earned MWK ' + reward + '! Added to Learning Wallet');
      
      // Refresh wallet data to update store_credit
      refreshWalletData(user.id);
      
      setTimeout(loadEarnWatchContent, 500);
    } else {
      showToast(data.message || 'Failed to claim');
    }
  })
  .catch(() => showToast('Network error'));
}


function updateEarnStats() {
  const bal = document.getElementById('earn-balance');
  const total = document.getElementById('total-earned');
  const today = document.getElementById('watched-today');
  if (bal) bal.textContent = 'MWK ' + (earnWatchBalance || 0).toFixed(2);
  if (total) total.textContent = 'MWK ' + (earnWatchTotalEarned || 0).toFixed(2);
  if (today) today.textContent = earnWatchWatchedToday || 0;

  // Update the overview quick-action tile with the real reward amount
  const overviewDesc = document.getElementById('overview-earn-desc');
  if (overviewDesc && earnWatchRewardPerItem > 0) {
    overviewDesc.textContent = 'MWK ' + earnWatchRewardPerItem.toLocaleString() + ' / video';
  }
}

