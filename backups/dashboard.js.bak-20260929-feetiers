async function loadAdvertsIntoFeed() {
  // Only touches cards marked data-type="ad" — organic earn cards are untouched.
  const grid = document.getElementById('earn-grid');
  if (!grid) return;

  let adverts = [];
  try {
    const data = await apiFetch('/user/adverts/feed');
    if (data.success) adverts = data.adverts || [];
  } catch (e) {
    return; // ads are decorative — never block the earn feed on failure
  }
  if (adverts.length === 0) return;

  // Remove any previously inserted ad cards (auto-refresh re-runs this)
  grid.querySelectorAll('.advert-feed-card').forEach(el => el.remove());

  const organicCards = Array.from(grid.children).filter(el => !el.classList.contains('advert-feed-card'));
  adverts.forEach((ad, i) => {
    const cardWrap = document.createElement('div');
    cardWrap.innerHTML = createAdvertFeedCard(ad);
    const card = cardWrap.firstElementChild;
    if (!card) return;
    // Insert after every 3rd organic card (after the 3rd, 6th, ...)
    const insertAfterIndex = Math.min((i + 1) * 3, organicCards.length) - 1;
    const anchor = organicCards[insertAfterIndex];
    if (anchor && anchor.nextSibling) grid.insertBefore(card, anchor.nextSibling);
    else if (anchor) grid.appendChild(card);
    else grid.appendChild(card);
  });
}

