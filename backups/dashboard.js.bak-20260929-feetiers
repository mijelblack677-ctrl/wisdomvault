          </div>
          <h4 style="font-size:13px;font-weight:700;margin-bottom:2px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;line-height:1.3;">${courseName}</h4>
          <p style="font-size:11px;color:#5a4a4a;margin-bottom:8px;">${course.instructor || 'Wisdom Vault'}</p>
