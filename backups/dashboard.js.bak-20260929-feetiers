// Helper function to start the timer
let earnWatchTimerCompleted = false; // Track if timer completed

function startEarnTimer(duration) {
  const totalTime = duration || 90;
  let timeLeft = totalTime;
  const circumference = 2 * Math.PI * 27; // r=27
  
  // Reset completion flag
  earnWatchTimerCompleted = false;
  
  if (earnWatchCountdown) clearInterval(earnWatchCountdown);
    
  earnWatchCountdown = setInterval(() => {
    timeLeft--;
    document.getElementById('earn-countdown').textContent = timeLeft;
    
    // Update progress circle
    const progress = timeLeft / totalTime;
    document.getElementById('earn-progress').style.strokeDashoffset = circumference * progress;
    
    if (timeLeft <= 0) {
      clearInterval(earnWatchCountdown);
      earnWatchTimerCompleted = true; // Mark as completed
      document.getElementById('earn-timer-status').innerHTML = ICON.checkCircle + ' Ready!';
      document.getElementById('earn-claim-btn').style.display = 'block';
      document.getElementById('earn-claim-btn').innerHTML = ICON.target + ' Claim Reward';
    }
  }, 1000);
}
function setupEarnModalHandlers() {
