        <h3 style="font-weight:700;font-size:16px;margin-bottom:4px;color:#2d2327;">No books yet</h3>
        <p style="font-size:13px;">Your library is empty. Check back later for new content!</p>
      </div>
    `;
  }
  updateLibraryCount(0);
}

function applyLibraryFilters() {
  libraryFilteredBooks = libraryBooks.filter(book => {
    let matchesSearch = true;
    if (libraryCurrentSearch) {
      const search = libraryCurrentSearch.toLowerCase().trim();
      matchesSearch = (book.title && book.title.toLowerCase().includes(search)) ||
                      (book.author && book.author.toLowerCase().includes(search)) ||
                      (book.description && book.description.toLowerCase().includes(search));
    }
    
    let matchesFilter = true;
    if (libraryCurrentFilter === 'free') matchesFilter = book.category === 'free';
    if (libraryCurrentFilter === 'premium') matchesFilter = book.category === 'premium';
    if (libraryCurrentFilter === 'owned') matchesFilter = book.owned;
    
    return matchesSearch && matchesFilter;
  });

  if (libraryCurrentSort === 'title') {
    libraryFilteredBooks.sort((a, b) => a.title.localeCompare(b.title));
  } else if (libraryCurrentSort === 'author') {
    libraryFilteredBooks.sort((a, b) => (a.author || '').localeCompare(b.author || ''));
  }

  renderLibraryGrid();
  renderContinueReading();
}

