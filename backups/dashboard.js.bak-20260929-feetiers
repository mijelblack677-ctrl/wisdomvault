function handleLibraryClick(e) {
  // Find the closest book card
  const card = e.target.closest('.lib-book-card');
  if (!card) return;
  
  // If clicking the button, handle it separately
  if (e.target.closest('.lib-read-btn')) {
    // Button click handled below
  }
  
  const bookId = card.dataset.bookId;
  const action = card.dataset.action || 'read';
  // Fix: parse premium correctly
  const isPremium = card.dataset.premium === 'true';
  const isOwned = card.dataset.owned === 'true';
  
  // Find the book by ID
  const book = libraryBooks.find(b => b.id == bookId);
  if (!book) {
    console.error('Book not found:', bookId);
    return;
  }
  
  // If clicking the button, process action
  if (e.target.closest('.lib-read-btn')) {
    e.stopPropagation();
    
    // Use isPremium from card
    if (isPremium && !isOwned) {
      buyPremiumBook(book);
    } else {
      openLibraryReader(book);
    }
    return;
  }
  
  // Card click (not on button)
  // Use isPremium from card
  if (isPremium && !isOwned) {
    // Don't open premium books on card click, only on button
    showToast(ICON.lock + ' This is premium content. Click "Unlock" to purchase.');
  } else {
    openLibraryReader(book);
  }
}
