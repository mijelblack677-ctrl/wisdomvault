function applyGuidesFilters() {
  console.log('Applying filters - Current category:', guidesCurrentCategory);
  console.log('Total guides:', guidesData.length);
  
  guidesFiltered = guidesData.filter(guide => {
    const matchesCategory = guidesCurrentCategory === 'all' || guide.category === guidesCurrentCategory;
    const matchesSearch = !guidesSearchQuery || 
      guide.title.toLowerCase().includes(guidesSearchQuery.toLowerCase()) ||
      guide.description.toLowerCase().includes(guidesSearchQuery.toLowerCase());
    return matchesCategory && matchesSearch;
  });
  
  console.log('Filtered guides:', guidesFiltered.length);
  renderGuidesGrid();
}

