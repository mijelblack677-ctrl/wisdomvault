          <button id="reader-prev-btn" style="padding:6px 12px;border-radius:8px;border:none;background:rgba(128,128,128,0.12);font-size:12px;font-weight:600;cursor:pointer;color:inherit;">←</button>
          <button id="reader-next-btn" style="padding:6px 12px;border-radius:8px;border:none;background:rgba(128,128,128,0.12);font-size:12px;font-weight:600;cursor:pointer;color:inherit;">→</button>
        </div>
      </div>
    </div>
  `;

  fetchLibraryBooks();
  setupLibraryListeners(container);
}

function fetchLibraryBooks() {
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  
  apiFetch('/content/library?userId=' + (user.id || ''))
    .then(data => {
      if (data.success && data.items && data.items.length > 0) {
        libraryBooks = data.items.map(item => ({
          id: item.id || '',
          title: item.title || 'Untitled',
          author: item.author || 'Unknown Author',
          description: item.description || '',
          cover: item.thumbnail_url || item.cover || '',
          thumbnail_url: item.thumbnail_url || '',
          category: item.is_premium ? 'premium' : 'free',
          isPremium: item.is_premium || false,
          is_owned: item.is_owned || false,  // Use is_owned from API
          owned: item.is_owned || false,     // Alias for compatibility
          content: item.content || item.description || '',
          fileUrl: item.file_url || '',
          linkType: item.link_type || 'url',
          price: item.price || 0,            // Get price from API
          externalLink: item.external_link || ''
        }));
        
        console.log('Books loaded:', libraryBooks);
        libraryFilteredBooks = libraryBooks.slice();
        applyLibraryFilters();
      } else {
        showLibraryEmpty();
      }
    })
    .catch(() => showLibraryEmpty());
}

function showLibraryEmpty() {
  const grid = document.getElementById('library-grid');
  if (grid) {
    grid.innerHTML = `
      <div style="text-align:center;padding:50px 20px;color:#5a4a4a;grid-column:1/-1;">
