window.submitAdvert = async function() {
  const btn = document.getElementById('adv-submit-btn');
  const errEl = document.getElementById('adv-error');
  if (!btn || !selectedAdvertTemplate) return;

  const showErr = (m) => { if (errEl) { errEl.textContent = m; errEl.style.display = 'block'; } };
  if (errEl) errEl.style.display = 'none';

  const headline = (document.getElementById('adv-headline')?.value || '').trim();
  const businessName = (document.getElementById('adv-business')?.value || '').trim();
  if (!headline) return showErr('Please enter a headline.');
  if (!businessName) return showErr('Please enter your business name.');

  const imgInput = document.getElementById('adv-images');
  const files = Array.from(imgInput?.files || []).slice(0, 3);
  for (const f of files) {
    // Sanity cap only — compressAdvertImage() shrinks real photos before upload.
    if (f.size > 100 * 1024 * 1024) return showErr('That file is too large.');
  }

  const fd = new FormData();
  fd.append('template', selectedAdvertTemplate.id);
  fd.append('headline', headline);
  fd.append('businessName', businessName);
  fd.append('description', (document.getElementById('adv-description')?.value || '').trim());
  fd.append('contactPhone', (document.getElementById('adv-phone')?.value || '').trim());
  fd.append('location', (document.getElementById('adv-location')?.value || '').trim());
  for (const f of files) fd.append('images', await compressAdvertImage(f));

  btn.disabled = true;
  btn.textContent = 'Submitting...';

  try {
    const token = localStorage.getItem('wisdom_vault_session');
    const res = await fetch(CONFIG.API_BASE + '/user/adverts', {
      method: 'POST',
      headers: token ? { 'Authorization': 'Bearer ' + token } : {},
      body: fd,
    });
    const data = await res.json().catch(() => {
      // Non-JSON body (e.g. proxy/CSRF text response) — give a human message.
      throw new Error(res.status === 403
        ? 'Security check failed. Please reload the page and try again.'
        : 'Server error. Please try again in a moment.');
    });
    if (!data.success) throw new Error(data.message || 'Submission failed');

    window.showToast(ICON.checkCircle + ' Advert submitted for review!');
    window.cancelAdvertForm();
    loadAdvertStatus();
  } catch (err) {
    showErr(err.message || 'Failed to submit. Please try again.');
    btn.disabled = false;
    btn.textContent = 'Submit for Review';
  }
};

