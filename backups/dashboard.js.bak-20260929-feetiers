    `;
    
    // Add audio timer update
    setTimeout(() => {
      const audioEl = player.querySelector('audio');
      const timerEl = player.querySelector('#audio-timer');
      if (audioEl && timerEl) {
        audioEl.addEventListener('loadedmetadata', function() {
          const total = formatAudioTime(this.duration);
          timerEl.textContent = `⏱ 0:00 / ${total}`;
        });
        audioEl.addEventListener('timeupdate', function() {
          const current = formatAudioTime(this.currentTime);
          const total = formatAudioTime(this.duration);
          timerEl.textContent = `⏱ ${current} / ${total}`;
        });
      }
    }, 100);
    
    document.getElementById('earn-modal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.getElementById('earn-modal').dataset.contentId = id;
    document.getElementById('earn-timer-status').textContent = 'Listening...';
    startEarnTimer(totalTime);
    return;
