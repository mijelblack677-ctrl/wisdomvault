function fetchCourses() {
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  
  apiFetch('/content/packs?userId=' + (user.id || ''))
    .then(data => {
      const packs = data.packs || [];
      console.log('Courses data:', packs); // Debug log
      
      coursesData = packs.map(pack => ({
        id: pack.id,
        name: pack.name || 'Untitled Course',  // Fix: use name
        title: pack.name || 'Untitled Course', // Alias for title
        instructor: pack.category || 'Wisdom Vault',
        category: pack.category || 'General',
        duration: (pack.itemCount || 0) + ' lessons',
        price: pack.price || 0,
        owned: pack.isOwned || false,
        isOwned: pack.isOwned || false,
        isFree: pack.isFree || false,
        progress: pack.progress || 0,
        thumbnail: pack.thumbnailUrl || getPackImage(pack.slug || pack.id),
        thumbnailUrl: pack.thumbnailUrl || getPackImage(pack.slug || pack.id), // Fix: use thumbnailUrl
        description: pack.description || '',
        longDescription: pack.longDescription || pack.description || '',
        contentCount: pack.itemCount || 0,
        slug: pack.slug || '',
        previewItems: pack.previewItems || []
      }));
      
      console.log('Mapped courses:', coursesData); // Debug log
      
      coursesFilteredData = coursesData.slice();
      buildCategoryFilters();
      applyCoursesFilters();
    })
    .catch(err => {
      console.error('Error fetching courses:', err);
      if (globalPacks && globalPacks.length > 0) {
        coursesData = globalPacks.map(pack => ({
          id: pack.id,
          name: pack.name || 'Untitled Course',
          title: pack.name || 'Untitled Course',
          instructor: pack.category || 'Wisdom Vault',
          category: pack.category || 'General',
          duration: (pack.contentCount || 0) + ' lessons',
          price: pack.price || 0,
          owned: pack.isOwned || false,
          isOwned: pack.isOwned || false,
          isFree: pack.isFree || false,
          progress: pack.progress || 0,
          thumbnail: getPackImage(pack.slug || pack.id),
          thumbnailUrl: getPackImage(pack.slug || pack.id),
          description: pack.description || '',
          longDescription: pack.long_description || pack.description || '',
          contentCount: pack.contentCount || 0,
          slug: pack.slug || '',
          previewItems: []
        }));
        coursesFilteredData = coursesData.slice();
        buildCategoryFilters();
        applyCoursesFilters();
      } else {
        showCoursesEmpty();
      }
    });
}

