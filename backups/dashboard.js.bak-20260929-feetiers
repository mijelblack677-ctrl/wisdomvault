function mapGuideFromAPI(item) {
  console.log('Mapping guide item:', item);
  
  let steps = [];
  let tips = [];
  
  // Parse steps
  if (item.steps) {
    if (typeof item.steps === 'string') {
      try {
        steps = JSON.parse(item.steps);
        console.log('Steps parsed from JSON:', steps);
      } catch (e) {
        // If not valid JSON, try splitting by newlines
        steps = item.steps.split('\n').filter(s => s.trim());
        console.log('Steps parsed from newlines:', steps);
      }
    } else if (Array.isArray(item.steps)) {
      steps = item.steps;
      console.log('Steps are array:', steps);
    }
  }
  
  // Parse tips
  if (item.tips) {
    if (typeof item.tips === 'string') {
      try {
        tips = JSON.parse(item.tips);
        console.log('Tips parsed from JSON:', tips);
      } catch (e) {
        tips = item.tips.split('\n').filter(s => s.trim());
        console.log('Tips parsed from newlines:', tips);
      }
    } else if (Array.isArray(item.tips)) {
      tips = item.tips;
      console.log('Tips are array:', tips);
    }
  }
  
  // If steps is still empty, use a default
  if (steps.length === 0 && item.content) {
    steps = [item.content];
  }
  
  // If steps is still empty, provide default steps
  if (steps.length === 0) {
    steps = [
      'Step 1: Read the guide content',
      'Step 2: Apply what you learn',
      'Step 3: Share your experience'
    ];
  }
  
  return {
    id: item.id,
    title: item.title || 'Untitled Guide',
    description: item.description || '',
    category: item.category_slug || item.category || 'getting-started',
    difficulty: item.difficulty || 'Beginner',
    icon: getGuideIcon(item.category_slug || item.category),
    time: item.estimated_time || '5 min',
    image: item.thumbnail_url || item.cover_url || getGuideImage(item.category_slug || item.category),
    steps: steps,
    tips: tips,
    content: item.content || '',
    fileUrl: item.file_url || '',
    linkType: item.link_type || 'url',
    isPublished: item.is_published !== false,
    author: item.author || 'Wisdom Vault',
    category_name: item.category_name || ''
  };
}
