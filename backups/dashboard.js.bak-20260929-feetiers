/** Word / EPUB: laid out as real text with typography we control. */
async function renderReaderText(book, meta) {
  readerState.mode = 'text';
  const content = document.getElementById('reader-content');
  const progress = document.getElementById('reader-progress');
  const progressBar = document.getElementById('reader-progress-bar');

  let data;
  try {
    data = await readerFetch(book.id, 'text');
  } catch (err) {
    content.innerHTML = readerMessageHTML('This book has no readable text', err.message, ICON.alert);
    return;
  }

  const blocks = data.blocks || [];
  const body = blocks.map(readerBlockHTML).join('');
  content.style.padding = '0';
  content.innerHTML = `<article id="reader-article" style="max-width:680px;margin:0 auto;padding:26px 20px 80px;line-height:1.75;">
      <h1 style="font-size:1.6em;font-weight:800;line-height:1.25;margin:0 0 0.3em;">${readerEscape(book.title || 'Untitled')}</h1>
      ${book.author ? `<p style="font-size:0.85em;opacity:0.6;margin:0 0 2em;">${readerEscape(book.author)}</p>` : '<div style="height:1.5em;"></div>'}
      ${body}
    </article>`;

  applyReaderFontSize();

  // Resume where this reader left off.
  const savedRatio = parseFloat(readerPrefGet('pos_' + book.id, '0')) || 0;
  const scrollable = content.scrollHeight - content.clientHeight;
  if (savedRatio > 0.01 && scrollable > 0) {
    content.scrollTop = Math.round(scrollable * savedRatio);
    showToast('Resuming where you left off');
  }

  // Real progress: measured from the text the reader is actually scrolling.
  const update = () => {
    const max = content.scrollHeight - content.clientHeight;
    const pct = max > 0 ? Math.min(100, Math.round((content.scrollTop / max) * 100)) : 100;
    if (progress) progress.textContent = pct + '% read · ' + blocks.length.toLocaleString() + ' paragraphs';
    if (progressBar) progressBar.style.width = pct + '%';
    readerPrefSet('pos_' + book.id, String(max > 0 ? content.scrollTop / max : 0));
    if (readerState.id) {
      const idx = libraryContinueReading.findIndex(b => b.id == readerState.id);
      if (idx > -1) {
        libraryContinueReading[idx].progress = pct;
        libraryContinueReading[idx].lastRead = Date.now();
        try { localStorage.setItem('wv_continue_reading', JSON.stringify(libraryContinueReading)); } catch (e) {}
      }
    }
  };
  content.addEventListener('scroll', update, { passive: true });
  update();
}

/** Wire the reader's controls once, after the shell is in the DOM. */
function initReaderControls() {
  const modal = document.getElementById('reader-modal');
  if (!modal || modal.dataset.wired === '1') return;
  modal.dataset.wired = '1';

  const content = document.getElementById('reader-content');
  const closeBtn = document.getElementById('reader-close-btn');
  const themeBtn = document.getElementById('reader-theme-btn');
  const fontUp = document.getElementById('reader-font-up');
  const fontDown = document.getElementById('reader-font-down');
  const fsBtn = document.getElementById('reader-fullscreen-btn');
  const prev = document.getElementById('reader-prev-btn');
  const next = document.getElementById('reader-next-btn');

  if (closeBtn) closeBtn.addEventListener('click', e => { e.stopPropagation(); closeLibraryReader(); });

  if (themeBtn) themeBtn.addEventListener('click', e => {
    e.stopPropagation();
    const i = READER_THEME_ORDER.indexOf(readerState.theme);
    const nextTheme = READER_THEME_ORDER[(i + 1) % READER_THEME_ORDER.length];
    readerPrefSet('theme', nextTheme);
    applyReaderTheme(nextTheme);
  });

  const changeFont = delta => {
    // In a PDF the same two buttons zoom the page instead of resizing text.
    if (readerState.mode === 'pdf' && readerState.pdf) {
      if (delta > 0) readerState.pdf.zoomIn();
      else readerState.pdf.zoomOut();
      return;
    }
    readerState.fontSize = Math.max(READER_FONT_MIN, Math.min(READER_FONT_MAX, readerState.fontSize + delta));
    readerPrefSet('font_size', String(readerState.fontSize));
    applyReaderFontSize();
  };
  if (fontUp) fontUp.addEventListener('click', e => { e.stopPropagation(); changeFont(2); });
  if (fontDown) fontDown.addEventListener('click', e => { e.stopPropagation(); changeFont(-2); });

  if (fsBtn) fsBtn.addEventListener('click', e => {
    e.stopPropagation();
    if (document.fullscreenElement) document.exitFullscreen();
    else if (modal.requestFullscreen) modal.requestFullscreen().catch(() => {});
  });

  // Prev/Next: turn a page in a PDF, otherwise scroll about a screenful.
  const jump = dir => {
    if (readerState.mode === 'pdf' && readerState.pdf) {
      if (dir > 0) readerState.pdf.nextPage();
      else readerState.pdf.prevPage();
      return;
    }
    if (!content) return;
    content.scrollBy({ top: dir * Math.round(content.clientHeight * 0.9), behavior: 'smooth' });
  };
  if (prev) prev.addEventListener('click', e => { e.stopPropagation(); jump(-1); });
  if (next) next.addEventListener('click', e => { e.stopPropagation(); jump(1); });

  document.addEventListener('keydown', e => {
    if (modal.style.display !== 'block') return;
    if (e.key === 'Escape') closeLibraryReader();
    else if (e.key === 'ArrowRight' || e.key === 'PageDown') jump(1);
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') jump(-1);
  });
}
