// ESCAPE HTML UTILITY (Add after safeJsonParse)
// ============================================================
function escapeHtml(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// Downscale + re-encode a photo in the browser so it always fits the 5MB
// server limit (phone cameras routinely produce 3-8MB JPEGs). Falls back to
// the original file if the canvas API fails — the server still validates.
async function compressAdvertImage(file) {
  if (!/^image\/(jpeg|png|webp)$/i.test(file.type)) return file;
  const MAX_EDGE = 1920;
  try {
    const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
    const scale = Math.min(1, MAX_EDGE / Math.max(bmp.width, bmp.height));
    const w = Math.round(bmp.width * scale);
    const h = Math.round(bmp.height * scale);
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    canvas.getContext('2d').drawImage(bmp, 0, 0, w, h);
    const blob = await new Promise(res => canvas.toBlob(res, 'image/jpeg', 0.82));
    if (blob && blob.size > 0 && blob.size < file.size) {
      return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' });
    }
    return file;
  } catch (e) {
    return file;
  }
}

// Turn bare URLs / domains / emails in a plain-text description into safe
// clickable links. Input is escaped FIRST, then linkified in staged passes
// where each emitted <a> is swapped for a placeholder so later passes can
// never re-process earlier output. Quotes are excluded from every match so
// an href attribute can never be broken out of, and hrefs are always built
// from http(s)/www./email matches (no javascript: URIs). Bare domains are
// only linkified with a plausible TLD (no "e.g." noise). Anchors carry
// onclick stopPropagation so tapping a link inside a clickable card
// navigates directly instead of opening the card's detail overlay.
function linkifyDescription(text) {
  const escaped = escapeHtml(text || '');
  if (!escaped) return '';

  const style = 'color:#c09a8a;font-weight:600;text-decoration:underline;word-break:break-all;';
  const anchor = (href, label) =>
    '<a href="' + href + '" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" style="' + style + '">' + label + '</a>';

  // Trailing punctuation: always trim . , ; : ! ? and balance ) ] } so
  // "(https://x.com/page)" drops the ")" but "…/Page_(b)" keeps its own.
  const trimTrail = (s) => {
    let out = s;
    for (;;) {
      const last = out.charAt(out.length - 1);
      if (last === ')' || last === ']') {
        const open = last === ')' ? '(' : '[';
        const close = last === ')' ? ')' : ']';
        const opens = (out.match(new RegExp('\\' + open, 'g')) || []).length;
        const closes = (out.match(new RegExp('\\' + close, 'g')) || []).length;
        if (closes > opens) { out = out.slice(0, -1); continue; }
      } else if (last === '.' || last === ',' || last === ';' || last === ':' || last === '!' || last === '?' || last === "'") {
        out = out.slice(0, -1);
        continue;
      }
      break;
    }
    return out;
  };

  // TLD whitelist for bare domains — avoids linkifying "e.g.", "Fig. 3", etc.
  const TLDS = '(?:com|net|org|edu|gov|mw|zw|za|ke|tz|ng|zm|so|co|io|me|biz|info|xyz|online|site|store|tech|app|dev|africa|club|shop|zone|live|news|jobs|careers)';

  const slots = [];
  const stash = (html) => { slots.push(html); return '\uE000' + (slots.length - 1) + '\uE001'; };

  // Pass 1: full URLs (https://… or www.…) — must run before the bare-domain
  // pass so "www.x.com" is never split into a bare-domain match.
  let out = escaped.replace(/(^|[\s(])((?:https?:\/\/|www\.)[^\s<>"']+)/gi, (m, pre, tok) => {
    const linkPart = trimTrail(tok);
    const trail = tok.slice(linkPart.length);
    const href = /^www\./i.test(linkPart) ? 'https://' + linkPart : linkPart;
    return pre + stash(anchor(href, linkPart)) + trail;
  });

  // Pass 2: email addresses (URLs are already stashed, so no false overlap).
  out = out.replace(/(^|[\s(])([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,})/g, (m, pre, tok) => {
    const linkPart = trimTrail(tok);
    const trail = tok.slice(linkPart.length);
    return pre + stash(anchor('mailto:' + linkPart, linkPart)) + trail;
  });

  // Pass 3: bare domains with a whitelisted TLD, optional /path. The negative
  // lookahead stops partial TLD splits ("example.coms" stays plain text).
  const domainRe = new RegExp(
    '(^|[\\s(])((?:[a-z0-9-]+\\.)+' + TLDS + '(?![a-z0-9-])(?:/[^\\s<>"\']*)?)',
    'gi'
  );
  out = out.replace(domainRe, (m, pre, tok) => {
    const linkPart = trimTrail(tok);
    const trail = tok.slice(linkPart.length);
    return pre + stash(anchor('https://' + linkPart, linkPart)) + trail;
  });

  // Restore the anchors, then newlines → <br>.
  out = out.replace(/\uE000(\d+)\uE001/g, (m, i) => slots[+i]);
  return out.replace(/\n/g, '<br>');
}

