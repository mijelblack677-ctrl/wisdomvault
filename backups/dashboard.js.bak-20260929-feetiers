// HANDLE WITHDRAW SUBMIT - WITH FULL VALIDATION
// ============================================================
function handleWithdrawSubmit(e) {
  e.preventDefault();
  e.stopPropagation();
  
  const user = globalUser || {};
  const wallet = globalWallet || { balanceAvailable: 0 };
  
  const name = document.getElementById('wd-name')?.value?.trim() || '';
  const phone = document.getElementById('wd-phone')?.value?.trim() || '';
  const amount = parseFloat(document.getElementById('wd-amount')?.value) || 0;

  // Show errors inside the modal (in addition to the toast) so the user always
  // sees what went wrong — no silent failures.
  function showWithdrawError(msg) {
    const errEl = document.getElementById('wd-error');
    if (errEl) {
      errEl.textContent = msg;
      errEl.style.display = 'block';
    }
    window.showToast(msg);
  }
  function clearWithdrawError() {
    const errEl = document.getElementById('wd-error');
    if (errEl) errEl.style.display = 'none';
  }
  clearWithdrawError();

  // FULL VALIDATION
  // Only the mobile number you want the money sent to is mandatory. The full
  // name is optional — for auto (PayChangu) processing the money goes to the
  // number, not a name, so it must never block a withdrawal.
  
  // 1. Phone validation (mandatory)
  if (!phone) { 
    showWithdrawError('Please enter the mobile number you want the money sent to'); 
    return; 
  }
  const cleanPhone = phone.replace(/[\s\-()]/g, '');
  if (!/^(\+?265|0)[0-9]{9,10}$/.test(cleanPhone)) { 
    showWithdrawError('Please enter a valid Malawian phone number (e.g., 0999123456 or +265999123456)'); 
    return; 
  }
  
  // 2. Amount validation
  if (!amount || isNaN(amount) || amount <= 0) { 
    showWithdrawError('Please enter a valid amount'); 
    return; 
  }
  if (amount < CONFIG.MIN_WITHDRAWAL) { 
    showWithdrawError(`Minimum withdrawal is MWK ${CONFIG.MIN_WITHDRAWAL.toLocaleString()}`); 
    return; 
  }
  if (amount > CONFIG.MAX_WITHDRAWAL) { 
    showWithdrawError(`Maximum withdrawal is MWK ${CONFIG.MAX_WITHDRAWAL.toLocaleString()}`); 
    return; 
  }
  if (amount > wallet.balanceAvailable) { 
    showWithdrawError('Insufficient balance'); 
    return; 
  }

  const fee = calculateTieredFee(amount);
  const net = amount - fee;
  const tier = getFeeTier(amount);

  // Disable the submit button to prevent double submission
  const submitBtn = e.target.querySelector('button[type="submit"]');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = ICON.clock + ' Processing...';
  }

  window.showToast(ICON.clock + ' Processing withdrawal... (Fee: MWK ' + fee.toLocaleString() + ')');

  // retries:0 — money-move POST must never be auto-retried; a retry
  // after a response-lost success could create a second payout.
  apiFetch('/wallet/withdraw', {
    method: 'POST',
    body: JSON.stringify({ 
      userId: user.id, 
      amount, 
      cardholderName: name, 
      phoneNumber: phone 
    })
  }, 0)
  .then(data => {
    if (data.success) {
      if (globalWallet) {
        globalWallet.balanceAvailable -= amount;
        globalWallet.totalWithdrawn += net;
      }
      if (globalTxs) {
        globalTxs.unshift({
          id: 'wd_' + Date.now(),
          transaction_type: 'withdrawal',
          amount: amount,
          description: `Withdrawal to ${phone} (Fee: MWK ${fee})`,
          created_at: new Date().toISOString()
        });
      }
      // Show success modal
      window.closeWithdrawModal();
      showWithdrawSuccessModal(data, amount, fee, net, phone, name, user.id);
    } else if (data.refunded) {
      // PayChangu could not process the payout (rate limit / error) —
      // the money has been automatically refunded. Show an animated
      // 'something went wrong' error so the user clearly sees the
      // refund happened and can safely retry later.
      showWithdrawRefunded(data.message || 'Your money has been fully refunded. Please try again later.', !!data.rateLimited);
    } else {
      showWithdrawError(data.message || 'Withdrawal failed');
      if (data.message && /(unauthorized|sign in|session)/i.test(data.message)) {
        handleSessionExpired();
      }
    }
  })
  .catch(err => {
    const msg = (err && err.message) || 'Network error. Please try again.';
    showWithdrawError(msg);
    if (/401|unauthorized|session/i.test(msg)) handleSessionExpired();
  })
  .finally(() => {
    // Re-enable the submit button
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Confirm Withdrawal';
    }
  });
}

// If the server rejects the session token, the stored user is stale —
// clear it and send the user to the login page.
function handleSessionExpired() {
  try {
    localStorage.removeItem('wisdom_vault_user');
    localStorage.removeItem('wisdom_vault_session');
  } catch(e) {}
  cacheClearAll();
  if (window.showToast) window.showToast('Your session expired. Please sign in again.');
  setTimeout(() => { window.location.href = '/login'; }, 1200);
}

// ── IDLE TIMEOUT: auto-logout after 15 minutes of inactivity ─────
// Resets on any user interaction (mouse, keyboard, scroll, touch).
// Prevents orphaned sessions when the user walks away from the
// dashboard on a shared or public device.
let _idleTimer = null;
let _idleActive = false;
const IDLE_TIMEOUT_MS = 15 * 60 * 1000; // 15 minutes
const IDLE_EVENTS = ['mousemove', 'keydown', 'scroll', 'touchstart', 'click'];

function _idleResetTimer() {
  if (_idleTimer) clearTimeout(_idleTimer);
  _idleTimer = setTimeout(_idleLogout, IDLE_TIMEOUT_MS);
}

function _idleLogout() {
  _idleActive = false;
  // Remove listeners so they don't keep firing after logout
  for (const ev of IDLE_EVENTS) {
    document.removeEventListener(ev, _idleResetTimer, { passive: true });
  }
  if (_idleTimer) { clearTimeout(_idleTimer); _idleTimer = null; }
  // Use the existing session-expiry path (clears storage, shows toast, redirects)
  handleSessionExpired();
}

function startIdleTimeout() {
  if (_idleActive) return; // already running
  _idleActive = true;
  for (const ev of IDLE_EVENTS) {
    document.addEventListener(ev, _idleResetTimer, { passive: true });
  }
  _idleResetTimer(); // start the first countdown
}

function stopIdleTimeout() {
  _idleActive = false;
  if (_idleTimer) { clearTimeout(_idleTimer); _idleTimer = null; }
  for (const ev of IDLE_EVENTS) {
    document.removeEventListener(ev, _idleResetTimer, { passive: true });
  }
}

