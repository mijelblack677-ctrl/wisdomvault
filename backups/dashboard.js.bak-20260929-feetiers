// ============================================================
// UNIVERSAL VIDEO EMBED - SUPPORTS ALL PLATFORMS
// ============================================================
function getVideoEmbed(url) {
    if (!url) return null;
    
    // Clean the URL
    url = url.trim();
    
    // ============================================================
    // YOUTUBE (including Shorts)
    // ============================================================
    // YouTube: https://www.youtube.com/watch?v=VIDEO_ID
    // YouTube Shorts: https://www.youtube.com/shorts/VIDEO_ID
    // YouTube Embed: https://www.youtube.com/embed/VIDEO_ID
    // YouTube Live: https://www.youtube.com/live/VIDEO_ID
    // YouTube Music: https://music.youtube.com/watch?v=VIDEO_ID
    
    let youtubeMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/|live\/)|youtu\.be\/)([^&\n?#]+)/);
    if (youtubeMatch) {
        const videoId = youtubeMatch[1];
        // Check if it's a YouTube Shorts link
        const isShorts = url.includes('/shorts/');
        // Use different embed parameters for shorts vs regular
        const params = isShorts 
            ? '?autoplay=0&rel=0&modestbranding=1&playsinline=1'
            : '?autoplay=0&rel=0&modestbranding=1&playsinline=1';
        return {
            type: 'youtube',
            embed: `https://www.youtube.com/embed/${videoId}${params}`,
            videoId: videoId,
            platform: 'YouTube',
            isShorts: isShorts
        };
    }

    // ============================================================
    // TIKTOK
    // ============================================================
    // TikTok: https://www.tiktok.com/@username/video/VIDEO_ID
    // TikTok: https://vm.tiktok.com/XXXXX (short link)
    
    // Method 1: Standard TikTok URL
    let tiktokMatch = url.match(/tiktok\.com\/@[\w.-]+\/video\/(\d+)/);
    if (tiktokMatch) {
        const videoId = tiktokMatch[1];
        return {
            type: 'tiktok',
            embed: `https://www.tiktok.com/embed/v2/${videoId}`,
            videoId: videoId,
            platform: 'TikTok'
        };
    }
    
    // Method 2: TikTok short link (vm.tiktok.com)
    // Note: For short links, we need to fetch the actual video ID
    // We'll use the TikTok oEmbed API
    if (url.includes('vm.tiktok.com') || url.includes('tiktok.com/t/')) {
        return {
            type: 'tiktok_short',
            embed: null, // Will be fetched dynamically
            platform: 'TikTok',
            url: url
        };
    }

    // ============================================================
    // INSTAGRAM (Reels & Posts)
    // ============================================================
    // Instagram Reel: https://www.instagram.com/reel/VIDEO_ID/
    // Instagram Post: https://www.instagram.com/p/POST_ID/
    // Instagram TV: https://www.instagram.com/tv/VIDEO_ID/
    
    let instagramMatch = url.match(/instagram\.com\/(?:reel|p|tv)\/([^\/?#]+)/);
    if (instagramMatch) {
        const videoId = instagramMatch[1];
        const type = url.includes('/reel/') ? 'reel' : 'post';
        return {
            type: 'instagram',
            embed: `https://www.instagram.com/${type}/${videoId}/embed`,
            videoId: videoId,
            platform: 'Instagram',
            isReel: type === 'reel'
        };
    }

    // ============================================================
    // VIMEO
    // ============================================================
    // Vimeo: https://vimeo.com/VIDEO_ID
    // Vimeo: https://player.vimeo.com/video/VIDEO_ID
    
    let vimeoMatch = url.match(/(?:vimeo\.com\/|player\.vimeo\.com\/video\/)(\d+)/);
    if (vimeoMatch) {
        const videoId = vimeoMatch[1];
        return {
            type: 'vimeo',
            embed: `https://player.vimeo.com/video/${videoId}?autoplay=0&title=0&byline=0&portrait=0`,
            videoId: videoId,
            platform: 'Vimeo'
        };
    }

    // ============================================================
    // FACEBOOK / META
    // ============================================================
    // Facebook Video: https://www.facebook.com/watch/?v=VIDEO_ID
    // Facebook Video: https://www.facebook.com/username/videos/VIDEO_ID
    // Facebook Video: https://fb.watch/XXXXX (short link)
    
    let facebookMatch = url.match(/(?:facebook\.com|fb\.watch)/);
    if (facebookMatch) {
        // For Facebook, we use the oEmbed API
        return {
            type: 'facebook',
            embed: null, // Will be fetched dynamically
            platform: 'Facebook',
            url: url
        };
    }

    // ============================================================
    // TWITTER / X
    // ============================================================
    // Twitter/X: https://twitter.com/user/status/TWEET_ID
    // Twitter/X: https://x.com/user/status/TWEET_ID
    
    let twitterMatch = url.match(/(?:twitter\.com|x\.com)\/\w+\/status\/(\d+)/);
    if (twitterMatch) {
        const tweetId = twitterMatch[1];
        return {
            type: 'twitter',
            embed: `https://twitter.com/i/status/${tweetId}`,
            videoId: tweetId,
            platform: 'Twitter/X'
        };
    }

    // ============================================================
    // RUMBLE
    // ============================================================
    // Rumble: https://rumble.com/vVIDEO_ID.html
    // Rumble: https://rumble.com/embed/VIDEO_ID/
    
    let rumbleMatch = url.match(/rumble\.com\/(?:v|embed\/)([^\/.?#]+)/);
    if (rumbleMatch) {
        const videoId = rumbleMatch[1];
        return {
            type: 'rumble',
            embed: `https://rumble.com/embed/${videoId}/`,
            videoId: videoId,
            platform: 'Rumble'
        };
    }

    // ============================================================
    // DAILYMOTION
    // ============================================================
    // Dailymotion: https://www.dailymotion.com/video/VIDEO_ID
    
    let dailymotionMatch = url.match(/dailymotion\.com\/video\/([^\/?#]+)/);
    if (dailymotionMatch) {
        const videoId = dailymotionMatch[1];
        return {
            type: 'dailymotion',
            embed: `https://www.dailymotion.com/embed/video/${videoId}`,
            videoId: videoId,
            platform: 'Dailymotion'
        };
    }

    // ============================================================
    // TWITCH
    // ============================================================
    // Twitch: https://www.twitch.tv/videos/VIDEO_ID
    // Twitch: https://clips.twitch.tv/CLIP_ID
    
    let twitchMatch = url.match(/twitch\.tv\/(?:videos\/(\d+)|clips\/([^\/?#]+))/);
    if (twitchMatch) {
        const videoId = twitchMatch[1] || twitchMatch[2];
        const isClip = url.includes('/clips/');
        return {
            type: 'twitch',
            embed: isClip 
                ? `https://clips.twitch.tv/embed?clip=${videoId}`
                : `https://player.twitch.tv/?video=${videoId}`,
            videoId: videoId,
            platform: 'Twitch',
            isClip: isClip
        };
    }

    // ============================================================
    // DIRECT VIDEO FILE (MP4, WEBM, MOV, AVI, etc.)
    // ============================================================
    const videoExtensions = ['.mp4', '.webm', '.mov', '.avi', '.mkv', '.m4v', '.ogv', '.3gp'];
    if (videoExtensions.some(ext => url.toLowerCase().includes(ext))) {
        return {
            type: 'direct',
            embed: url,
            platform: 'Direct Video',
            isDirect: true
        };
    }

    // ============================================================
    // FALLBACK: Generic Embed
    // ============================================================
    // If we can't detect the platform, try to embed the URL directly
    return {
        type: 'generic',
        embed: url,
        platform: 'Link',
        isGeneric: true
    };
}

// ============================================================
// VIDEO EMBED
//
// One renderer for every platform the library uses. It fixes three things the
// previous version got wrong:
//   • it appended "&autoplay=1" to embed URLs that already carried
//     "?autoplay=0", so the first value won and autoplay silently did nothing;
//   • it framed every clip at 16:9, so Shorts / Reels / TikToks were squeezed
//     into a letterboxed sliver;
//   • it gave no loading or failure feedback, and no fullscreen of its own for
//     browsers that refuse to fullscreen a nested iframe.
// ============================================================

/** Set or override query params on an embed URL, exactly once each. */
function videoEmbedUrl(baseUrl, params) {
  try {
    const u = new URL(baseUrl, window.location.origin);
    for (const [k, v] of Object.entries(params)) u.searchParams.set(k, String(v));
    return u.toString();
  } catch (e) {
    return baseUrl;
  }
}

/** Portrait for short-form video, square for Instagram posts, else 16:9. */
function videoAspect(info) {
  if (info.isShorts || info.isReel || info.type === 'tiktok') return [9, 16];
  if (info.type === 'instagram') return [1, 1];
  return [16, 9];
}

/** The autoplay/mute parameters each platform's player actually understands. */
function videoPlayerParams(info, autoplay, muted) {
  switch (info.type) {
    case 'youtube':
      return { autoplay: autoplay ? 1 : 0, mute: muted ? 1 : 0, playsinline: 1, rel: 0, modestbranding: 1 };
    case 'vimeo':
      return { autoplay: autoplay ? 1 : 0, muted: muted ? 1 : 0, playsinline: 1, title: 0, byline: 0, portrait: 0, dnt: 1 };
    case 'dailymotion':
      return { autoplay: autoplay ? 1 : 0, mute: muted ? 1 : 0 };
    case 'twitch':
      // Twitch refuses to load a player unless it is told which domain embeds it.
      return { autoplay: autoplay ? 1 : 0, parent: window.location.hostname };
    case 'rumble':
      return { autoplay: autoplay ? 2 : 0 };
    default:
      return {};
  }
}

/** A readable card for links we cannot embed, with a way to still watch them. */
function videoFallbackHTML(title, detail, url) {
  return `<div class="video-error" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:38px 22px;text-align:center;background:rgba(45,35,39,0.04);border-radius:14px;color:#2d2327;">
    <div style="font-size:14px;font-weight:700;">${title}</div>
    <div style="font-size:12px;opacity:0.7;line-height:1.6;">${detail}</div>
    ${url ? `<a href="${url}" target="_blank" rel="noopener" style="margin-top:6px;padding:9px 20px;background:#2d2327;color:#fff;border-radius:9px;text-decoration:none;font-size:12px;font-weight:600;">Open in a new tab</a>` : ''}
  </div>`;
}

function renderVideoEmbed(url, container, options = {}) {
  const {
    autoplay = false,
    controls = true,
    muted = false,
    className = 'video-embed',
    // fill: take the height the caller gives the container instead of the
    // clip's own aspect ratio. The full-screen lesson modal uses this.
    fill = false,
    title = '',
  } = options;

  const info = getVideoEmbed(url);
  if (!info) {
    container.innerHTML = videoFallbackHTML('Could not read this video link', 'The link may be incomplete or from an unsupported site.', url);
    return null;
  }

  // TikTok short links and Facebook need their embed resolved first.
  if (info.type === 'tiktok_short') {
    fetchVideoEmbed(info, container, { ...options, title });
    return info;
  }

  const [aw, ah] = videoAspect(info);
  const portrait = ah > aw;

  // ── media markup ──────────────────────────────────────────────────────
  let media;
  if (info.type === 'direct') {
    media = `<video src="${info.embed}" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#000;" ${controls ? 'controls' : ''} ${autoplay ? 'autoplay' : ''} ${muted ? 'muted playsinline' : 'playsinline'} preload="metadata"></video>`;
  } else if (info.type === 'facebook') {
    const href = encodeURIComponent(info.url || url);
    media = `<iframe src="https://www.facebook.com/plugins/video.php?href=${href}&show_text=false&width=1280&height=720" title="${(title || 'Facebook video').replace(/"/g, '')}" style="position:absolute;inset:0;width:100%;height:100%;border:none;" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen loading="lazy"></iframe>`;
  } else if (info.type === 'twitter') {
    media = `<iframe src="https://platform.twitter.com/embed/Tweet.html?id=${info.videoId}" title="${(title || 'Post on X').replace(/"/g, '')}" style="position:absolute;inset:0;width:100%;height:100%;border:none;" allowfullscreen loading="lazy"></iframe>`;
  } else if (info.embed && !info.isGeneric) {
    const src = videoEmbedUrl(info.embed, videoPlayerParams(info, autoplay, muted));
    media = `<iframe src="${src}" title="${(title || info.platform).replace(/"/g, '')}" style="position:absolute;inset:0;width:100%;height:100%;border:none;" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture; fullscreen" loading="lazy"></iframe>`;
  } else {
    container.innerHTML = videoFallbackHTML('This video can’t be embedded', `${info.platform} does not allow its player to run inside another site. Open it in a new tab instead.`, url);
    return info;
  }

  // ── frame sizing ──────────────────────────────────────────────────────
  // In fill mode we take the caller's box. Otherwise we use the clip's own
  // aspect ratio, and cap portrait clips so they cannot run off the screen.
  const boxStyle = fill
    ? 'position:relative;width:100%;height:100%;min-height:240px;background:#000;overflow:hidden;'
    : `position:relative;width:100%;max-width:${portrait ? Math.round((aw / ah) * 62) + 'vh' : '100%'};aspect-ratio:${aw} / ${ah};max-height:70vh;margin:0 auto;background:#000;border-radius:14px;overflow:hidden;box-shadow:0 6px 24px rgba(0,0,0,0.22);`;

  container.innerHTML = `
    <div class="${className} video-shell" style="position:relative;">
      <div class="video-stage" style="${boxStyle}">
        ${media}
        <div class="video-loading" style="position:absolute;inset:0;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:rgba(0,0,0,0.65);color:#fff;pointer-events:none;">
          <div style="width:28px;height:28px;border:3px solid rgba(255,255,255,0.25);border-top-color:#fff;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
          <div style="font-size:12px;opacity:0.85;">Loading ${info.platform}…</div>
        </div>
        <div style="position:absolute;top:10px;left:10px;z-index:4;background:rgba(0,0,0,0.65);color:#fff;padding:4px 10px;border-radius:100px;font-size:10px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;backdrop-filter:blur(4px);">${info.platform}${info.isShorts ? ' · Shorts' : ''}${info.isReel ? ' · Reel' : ''}</div>
        <button type="button" class="video-fs-btn" title="Fullscreen" aria-label="Fullscreen" style="position:absolute;top:10px;right:10px;z-index:4;width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.65);color:#fff;border:none;border-radius:10px;cursor:pointer;backdrop-filter:blur(4px);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M16 3h3a2 2 0 0 1 2 2v3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/><path d="M8 21H5a2 2 0 0 1-2-2v-3"/></svg>
        </button>
      </div>
      <div style="display:flex;justify-content:center;margin-top:8px;">
        <a href="${url}" target="_blank" rel="noopener" style="font-size:11px;opacity:0.6;">Not playing? Open on ${info.platform}</a>
      </div>
    </div>`;

  const stage = container.querySelector('.video-stage');
  const shell = container.querySelector('.video-shell');
  const loading = container.querySelector('.video-loading');
  const hideLoading = () => { if (loading) loading.style.display = 'none'; };

  const player = container.querySelector('iframe, video');
  if (player) {
    player.addEventListener('load', hideLoading);
    player.addEventListener('loadeddata', hideLoading);
  }
  // Never leave the spinner up forever if the load event never fires.
  setTimeout(hideLoading, 4500);

  const fsBtn = container.querySelector('.video-fs-btn');
  if (fsBtn) {
    const canFullscreen = !!(stage && (stage.requestFullscreen || stage.webkitRequestFullscreen));
    if (!canFullscreen) {
      // iOS Safari cannot fullscreen an arbitrary element — the player's own
      // fullscreen button handles it there.
      fsBtn.style.display = 'none';
    } else {
      fsBtn.addEventListener('click', e => {
        e.stopPropagation();
        if (document.fullscreenElement) { document.exitFullscreen().catch(() => {}); return; }
        const el = stage;
        const request = el.requestFullscreen || el.webkitRequestFullscreen;
        if (request) request.call(el).catch(() => {});
      });
    }
  }
  void shell;

  return info;
}

// ============================================================
// LEGACY RENDER VIDEO EMBED (kept as a fallback path)
// ============================================================
function renderVideoEmbedLegacy(url, container, options = {}) {
    const { 
        autoplay = false,
        controls = true,
        loop = false,
        muted = false,
        className = 'video-embed',
        style = {}
    } = options;

    const videoInfo = getVideoEmbed(url);
    
    if (!videoInfo) {
        container.innerHTML = `<div class="video-error"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align:-0.125em"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Could not load video. Please check the URL.</div>`;
        return;
    }

    // For TikTok short links and Facebook, we need to fetch the embed
    if (videoInfo.type === 'tiktok_short' || videoInfo.type === 'facebook') {
        fetchVideoEmbed(videoInfo, container, options);
        return;
    }

    // Build the embed HTML
    let embedHTML = '';
    
    switch (videoInfo.type) {
        case 'youtube':
        case 'vimeo':
        case 'dailymotion':
        case 'rumble':
        case 'twitch':
            // Standard iframe embed
            const embedUrl = videoInfo.embed + (autoplay ? '&autoplay=1' : '');
            embedHTML = `
                <div class="${className}" style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;background:#000;${style.cssText || ''}">
                    <iframe 
                        src="${embedUrl}"
                        style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
                        allowfullscreen
                        allow="autoplay; encrypted-media; picture-in-picture"
                        loading="lazy"
                        ${controls ? '' : 'controls="0"'}
                    ></iframe>
                </div>
            `;
            break;

        case 'instagram':
            embedHTML = `
                <div class="${className}" style="position:relative;padding-bottom:100%;height:0;overflow:hidden;border-radius:12px;background:#fafafa;">
                    <iframe 
                        src="${videoInfo.embed}"
                        style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
                        loading="lazy"
                        allowfullscreen
                    ></iframe>
                </div>
            `;
            break;

        case 'twitter':
            embedHTML = `
                <div class="${className}" style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;background:#000;">
                    <blockquote class="twitter-tweet" style="position:absolute;top:0;left:0;width:100%;height:100%;">
                        <a href="${videoInfo.embed}"></a>
                    </blockquote>
                    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
                </div>
            `;
            break;

        case 'tiktok':
            embedHTML = `
                <div class="${className}" style="position:relative;padding-bottom:100%;height:0;overflow:hidden;border-radius:12px;background:#000;">
                    <iframe 
                        src="${videoInfo.embed}"
                        style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
                        loading="lazy"
                        allowfullscreen
                    ></iframe>
                </div>
            `;
            break;

        case 'direct':
            embedHTML = `
                <div class="${className}" style="position:relative;border-radius:12px;overflow:hidden;background:#000;">
                    <video 
                        src="${videoInfo.embed}"
                        style="width:100%;display:block;"
                        ${controls ? 'controls' : ''}
                        ${autoplay ? 'autoplay' : ''}
                        ${loop ? 'loop' : ''}
                        ${muted ? 'muted' : ''}
                        playsinline
                        preload="metadata"
                    ></video>
                </div>
            `;
            break;

        default:
            // Generic fallback
            embedHTML = `
                <div class="${className}" style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:12px;background:#000;">
                    <iframe 
                        src="${videoInfo.embed}"
                        style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
                        allowfullscreen
                        loading="lazy"
                    ></iframe>
                </div>
            `;
    }

    // Add platform badge
    const platformBadge = `
        <div style="position:absolute;top:10px;right:10px;z-index:5;background:rgba(0,0,0,0.7);color:white;padding:4px 12px;border-radius:100px;font-size:11px;font-weight:600;backdrop-filter:blur(4px);">
            ${videoInfo.platform} ${videoInfo.isShorts ? '• Shorts' : ''}
        </div>
    `;

    // Combine everything
    container.innerHTML = `
        <div style="position:relative;">
            ${embedHTML}
            ${videoInfo.type !== 'direct' ? platformBadge : ''}
        </div>
    `;

    // For TikTok short links, we need to handle the embed
    if (videoInfo.type === 'tiktok_short' || videoInfo.type === 'facebook') {
        fetchVideoEmbed(videoInfo, container, options);
    }

    return videoInfo;
}

// ============================================================
// FETCH VIDEO EMBED (for TikTok Short & Facebook)
// ============================================================
async function fetchVideoEmbed(videoInfo, container, options) {
    try {
        // Use the oEmbed API for TikTok
        if (videoInfo.type === 'tiktok_short') {
            const response = await fetch(`https://www.tiktok.com/oembed?url=${encodeURIComponent(videoInfo.url)}`);
            const data = await response.json();
            
            if (data.html) {
                container.innerHTML = `
                    <div style="position:relative;border-radius:12px;overflow:hidden;background:#000;">
                        ${data.html}
                    </div>
                `;
                // TikTok's embed script needs to be executed
                const scripts = container.querySelectorAll('script');
                scripts.forEach(script => {
                    const newScript = document.createElement('script');
                    newScript.textContent = script.textContent;
                    script.parentNode.replaceChild(newScript, script);
                });
            } else {
                container.innerHTML = `<div class="video-error"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align:-0.125em"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Failed to load TikTok video. Please try again.</div>`;
            }
        }
    } catch (error) {
        console.error('Error fetching video embed:', error);
        container.innerHTML = `<div class="video-error"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align:-0.125em"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Failed to load video. Please try again.</div>`;
    }
}
