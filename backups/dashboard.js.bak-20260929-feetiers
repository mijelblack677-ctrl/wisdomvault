function attachCoursesCardHandlers() {
  document.querySelectorAll('.courses-card').forEach(card => {
    card.addEventListener('click', function(e) {
      if (e.target.closest('.courses-action-btn')) return;
      const courseId = this.dataset.courseId;
      openCourseDetail(courseId);
    });
  });

  document.querySelectorAll('.courses-action-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const action = this.dataset.action;
      const courseId = this.dataset.courseId;
      if (action === 'continue') openCourseDetail(courseId);
      else if (action === 'enroll') enrollFreeCourse(courseId);
      else if (action === 'buy') buyCourse(courseId);
    });
  });
}

function enrollFreeCourse(courseId) {
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  if (!user.id) { showToast('Please login first'); return; }

  showToast(ICON.clock + ' Enrolling...');
  fetch('/api/courses/purchase', {
    method: 'POST',        headers: authHeaders(),
    body: JSON.stringify({ userId: user.id, packId: courseId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      invalidateFor('/courses/purchase');
      showToast('Free course enrolled!');
      const course = coursesData.find(c => c.id == courseId);
      if (course) course.isOwned = true;
      renderCoursesGrid();
      setTimeout(() => openCourseDetail(courseId), 500);
    } else {
      showToast(data.message || 'Failed to enroll');
    }
  })
  .catch(() => showToast('Network error. Please try again.'));
}
function refreshWalletData(userId) {
  apiFetch('/wallet/balance?userId=' + userId)
    .then(data => {
      if (data.success && data.wallet) {
        // Update globalWallet with all fields including storeCredit
        globalWallet = {
          balanceAvailable: data.wallet.balanceAvailable || 0,
          grossEarnings: data.wallet.grossEarnings || 0,
          totalWithdrawn: data.wallet.totalWithdrawn || 0,
          feesPaid: data.wallet.feesPaid || 0,
          storeCredit: data.wallet.storeCredit || 0 // IMPORTANT
        };
        
        // Refresh the transaction history from the server so completed
        // withdrawals and refunds show up on screen.
        if (Array.isArray(data.recentTransactions)) {
          globalTxs = data.recentTransactions.map(tx => ({
            id: tx.id || ('tx_' + Date.now() + '_' + Math.random()),
            transaction_type: tx.type || tx.transaction_type || '',
            amount: tx.amount,
            fee_deducted: tx.feeDeducted || 0,
            description: tx.description || '',
            created_at: tx.createdAt || tx.created_at || new Date().toISOString()
          }));
        }
        
        // Update the current panel
        const activePanel = document.querySelector('.ni.active');
        if (activePanel) {
          const panel = activePanel.dataset.panel;
          if (panel === 'overview') {
            renderOverview(document.getElementById('panel-content'));
          } else if (panel === 'wallet') {
            renderWallet(document.getElementById('panel-content'));
          }
        }
      }
    })
    .catch(err => console.error('Error refreshing wallet:', err));
}
function buyCourse(courseId) {
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  if (!user.id) { showToast('Please login first'); return; }

  const course = coursesData.find(c => c.id == courseId);
  if (!course) return;
  if (course.isOwned) { showToast('You already have access to this course'); openCourseDetail(courseId); return; }
  if (course.isFree) { enrollFreeCourse(courseId); return; }

  // Show which wallet will be used
  const storeCredit = globalWallet?.storeCredit || 0;
  const balanceAvailable = globalWallet?.balanceAvailable || 0;
  const price = course.price || 0;
  
  let walletMessage = '';
  if (storeCredit >= price) {
    walletMessage = ICON.info + ' This will be deducted from your Learning Wallet (MWK ' + storeCredit.toLocaleString() + ' available)';
  } else if (balanceAvailable >= price) {
    walletMessage = ICON.info + ' This will be deducted from your Cash Wallet (MWK ' + balanceAvailable.toLocaleString() + ' available)';
  } else {
    walletMessage = ICON.alert + ' Insufficient funds. Learning Wallet: MWK ' + storeCredit.toLocaleString() + ', Cash Wallet: MWK ' + balanceAvailable.toLocaleString() + ')';
  }

  if (!confirm(`Purchase "${course.name}" for MWK ${(course.price || 0).toLocaleString()}?\n\n${walletMessage}`)) return;

  showToast('⏳ Processing purchase...');
  
  fetch('/api/courses/purchase', {
    method: 'POST',        headers: authHeaders(),
    body: JSON.stringify({ userId: user.id, packId: courseId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      invalidateFor('/courses/purchase');
      if (data.alreadyPurchased) {
        showToast('You already have access to this course');
      } else if (data.usedStoreCredit) {
        showToast(ICON.checkCircle + ' Course purchased using Learning Wallet! MWK ' + data.price.toLocaleString() + ' deducted.');
        // Update store credit
        if (globalWallet) {
          globalWallet.storeCredit = data.newStoreCredit;
        }
      } else {
        showToast('Course purchased using Cash Wallet!');
        if (data.newBalance !== undefined && globalWallet) {
          globalWallet.balanceAvailable = data.newBalance;
        }
      }
      
      // Update the course in local data
      const course = coursesData.find(c => c.id == courseId);
      if (course) course.isOwned = true;
      
      // Re-fetch packs so the freshly owned course gets its lesson URLs
      // (the API strips file_url for paid packs the user doesn't own yet).
      fetchCourses();
      
      // Refresh wallet data
      refreshWalletData(user.id);
      
      renderCoursesGrid();
      setTimeout(() => openCourseDetail(courseId), 800);
    } else {
      showToast(data.message || 'Failed to purchase');
    }
  })
  .catch(() => showToast('Network error. Please try again.'));
}

function openCourseDetail(courseId) {
  const course = coursesData.find(c => c.id == courseId);
  if (!course) return;

  const modal = document.getElementById('course-detail-modal');
  const content = document.getElementById('course-modal-content');
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  
  if (!course.isOwned && !course.isFree) {
    content.innerHTML = `
      <div style="padding:40px;text-align:center; color:#2d2327;">
        <div style="margin-bottom:16px;">${ICON.lock}</div>
        <h3 style="font-size:20px;font-weight:700;margin-bottom:8px;">${course.name}</h3>
        <p style="color:#5a4a4a;margin-bottom:16px;">${course.description || 'Purchase this course to access all content.'}</p>
        <div style="font-size:24px;font-weight:700;color:#c09a8a;margin-bottom:20px;">MWK ${(course.price || 0).toLocaleString()}</div>
        <button onclick="buyCourse('${courseId}')" style="padding:12px 40px;background:#2d2327;color:#ffffff;border:none;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;">Buy Now</button>
        <button onclick="closeCourseDetail()" style="margin-left:12px;padding:12px 24px;background:rgba(45,35,39,0.05);color:#2d2327;border:none;border-radius:12px;font-size:14px;font-weight:600;cursor:pointer;">Close</button>
      </div>
    `;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    return;
  }

  apiFetch(`/content/course-progress?userId=${user.id}&courseId=${courseId}`)
    .then(data => {
      const progress = data.success ? data.stats : { totalLessons: 0, completedLessons: 0, progressPercentage: 0 };
      const lessons = course.previewItems || [];
      const lessonsCount = course.contentCount || lessons.length;
      const completedLessons = progress.completedLessons || 0;
      const progressPercent = progress.progressPercentage || 0;

