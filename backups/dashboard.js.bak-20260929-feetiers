  if (sortSelect) sortSelect.addEventListener('change', function() { libraryCurrentSort = this.value; applyLibraryFilters(); });

  document.querySelectorAll('.lib-filter-chip').forEach(chip => {
    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      document.querySelectorAll('.lib-filter-chip').forEach(c => {
        c.classList.remove('active');
        c.style.background = 'rgba(45,35,39,0.05)';
        c.style.color = '#2d2327';
      });
      this.classList.add('active');
      this.style.background = '#2d2327';
      this.style.color = '#ffffff';
      libraryCurrentFilter = this.dataset.filter;
      applyLibraryFilters();
    });
  });

  const clearBtn = document.getElementById('clear-history-btn');
  if (clearBtn) clearBtn.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); localStorage.removeItem('wv_continue_reading'); libraryContinueReading = []; renderContinueReading(); showToast('Reading history cleared'); });

  initReaderControls();
}

