function closeGuideDetail() {
  document.getElementById('guide-detail-modal').style.display = 'none';
  document.body.style.overflow = '';
}

function saveGuideHistory(guide) {
  try {
    let history = JSON.parse(localStorage.getItem('wv_guide_history') || '[]');
    const existing = history.findIndex(h => h.id === guide.id);
    if (existing > -1) history.splice(existing, 1);
    history.unshift({ id: guide.id, title: guide.title, icon: guide.icon, lastRead: Date.now() });
    history = history.slice(0, 20);
    localStorage.setItem('wv_guide_history', JSON.stringify(history));
  } catch(e) {}
}

function updateGuidesCount(count) {
  const el = document.getElementById('guides-count');
  if (el) el.textContent = count + ' guide' + (count !== 1 ? 's' : '');
}

function setupGuidesListeners() {
  document.querySelectorAll('.guides-filter-chip').forEach(chip => {
    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      document.querySelectorAll('.guides-filter-chip').forEach(c => {
        c.classList.remove('active');
        c.style.background = 'rgba(45,35,39,0.05)';
        c.style.color = '#2d2327';
      });
      this.classList.add('active');
      this.style.background = '#2d2327';
      this.style.color = '#ffffff';
      guidesCurrentCategory = this.dataset.category;
      applyGuidesFilters();
    });
  });

  const searchInput = document.getElementById('guides-search');
  if (searchInput) searchInput.addEventListener('input', function() { guidesSearchQuery = this.value.toLowerCase(); applyGuidesFilters(); });

  document.getElementById('guide-modal-close').addEventListener('click', e => { e.stopPropagation(); closeGuideDetail(); });
  document.getElementById('guide-modal-bg').addEventListener('click', e => { e.stopPropagation(); closeGuideDetail(); });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('guide-detail-modal');
      if (modal && modal.style.display === 'flex') closeGuideDetail();
    }
  });
}

