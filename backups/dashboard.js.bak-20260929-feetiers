// ============================================================
// SYNC IN-FLIGHT AUTO-WITHDRAWALS
// Asks the server to check PayChangu for any 'processing' payouts and
// reconcile them (mark completed / refund on failure). Called when the
// wallet panel is opened.
// ============================================================
function syncProcessingWithdrawals(userId) {
  if (!userId) return;
  apiFetch(`/wallet/withdrawal-status?userId=${encodeURIComponent(userId)}`)
    .then(res => {
      if (res && res.success && Array.isArray(res.withdrawals)) {
        const needsRefresh = res.withdrawals.some(w => w.status === 'completed' || w.status === 'failed' || w.status === 'rejected');
        if (needsRefresh && typeof refreshWalletData === 'function') {
          refreshWalletData(userId);
        }
      }
    })
    .catch(() => {
      // Best-effort sync; ignore failures so panel navigation never breaks
    });
}

// ============================================================
// AUTO-REFRESH PANEL (Fast Sync)
// ============================================================
function refreshCurrentPanel() {
  // Skip background tabs — no server calls while the user isn't looking
  if (document.hidden) return;

  // Always check for new notifications
  fetchNotifications();

  // Don't refresh panel data if a modal is open (user is interacting)
  const openModal = document.querySelector('[id$="-modal"][style*="flex"]');
  if (openModal) return;

  // Don't refresh if user is on overview (wallet data is expensive)
  if (!currentActivePanel || currentActivePanel === 'overview' || currentActivePanel === 'profile') return;

  const container = document.getElementById('panel-content');
  if (!container) return;

  // Silently refresh the current panel's data without full re-render
  switch (currentActivePanel) {
    case 'earn':
      if (typeof loadEarnWatchContent === 'function') loadEarnWatchContent();
      break;
    case 'library':
      if (typeof fetchLibraryBooks === 'function') fetchLibraryBooks();
      break;
    case 'courses':
      if (typeof fetchCourses === 'function') fetchCourses();
      break;
    case 'guides':
      if (typeof fetchGuides === 'function') fetchGuides();
      break;
    case 'adverts':
      if (typeof loadAdvertStatus === 'function') loadAdvertStatus();
      break;
  }
}

