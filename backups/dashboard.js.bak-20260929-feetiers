}

function addToContinueReading(book) {
  const existing = libraryContinueReading.findIndex(b => b.id === book.id);
  if (existing > -1) libraryContinueReading.splice(existing, 1);
  libraryContinueReading.unshift({
    id: book.id,
    title: book.title,
    author: book.author,
    cover: book.cover,
    progress: 0,
    lastRead: Date.now()
