function updateGreetingAndDate() {
  const h = new Date().getHours();
  let g = 'Good morning';
  if (h >= 12 && h < 17) g = 'Good afternoon';
  if (h >= 17 && h < 20) g = 'Good evening';
  if (h >= 20 || h < 5) g = 'Good night';
  
  const now = new Date();
  const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const ds = `${days[now.getDay()]}, ${months[now.getMonth()]} ${now.getDate()} • ${now.toLocaleTimeString('en-US', {hour:'numeric',minute:'2-digit',hour12:true})}`;
  
  const greetingEl = document.getElementById('greeting');
  const dateEl = document.getElementById('dateText');
  if (greetingEl) greetingEl.textContent = `${g}, ${globalUser?.firstName || globalUser?.fullName || 'User'}`;
  if (dateEl) dateEl.textContent = ds;
}

// ============================================================
// LOAD PANEL - WITH CLEANUP
// ============================================================
function loadPanel(panel) {
  const container = document.getElementById('panel-content');
  if (!container) return;

  // Track current panel for auto-refresh
  currentActivePanel = panel;

  // Clean up any ongoing timers from earn/watch
  if (earnWatchCountdown) {
    clearInterval(earnWatchCountdown);
    earnWatchCountdown = null;
  }

  // Clean up any modals that might be open
  const modals = document.querySelectorAll('[id$="-modal"]');
  modals.forEach(modal => {
    if (modal.style.display === 'flex') {
      modal.style.display = 'none';
    }
  });

  document.querySelectorAll('.ni').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.panel === panel);
  });

  switch (panel) {
    case 'overview':
      if (typeof renderOverview === 'function') renderOverview(container);
      break;
    case 'wallet':
      if (globalUser && globalUser.id && typeof refreshWalletData === 'function') {
        refreshWalletData(globalUser.id);
        // Self-heal: reconcile any in-flight auto-withdrawal against PayChangu
        // so a 'processing' row that finished (or failed) while the user was
        // away gets marked completed/refunded in the DB.
        syncProcessingWithdrawals(globalUser.id);
      }
      if (typeof renderWallet === 'function') renderWallet(container);
      break;
    case 'earn':
      if (typeof renderEarnWatch === 'function') renderEarnWatch(container);
      break;
    case 'invites':
      renderInvites(container);
      break;
    case 'library':
      if (typeof renderLibrary === 'function') renderLibrary(container);
      break;
    case 'courses':
      if (typeof renderCoursesPanel === 'function') renderCoursesPanel(container);
      break;
    case 'guides':
      if (typeof renderGuidesPanel === 'function') renderGuidesPanel(container);
      break;
    case 'profile':
      if (typeof renderProfile === 'function') renderProfile(container);
      break;
    case 'adverts':
      if (typeof renderAdvertsPanel === 'function') renderAdvertsPanel(container);
      break;
    case 'vacancies':
      if (typeof renderVacanciesPanel === 'function') renderVacanciesPanel(container);
      break;
  }

  setTimeout(() => {
    container.querySelectorAll('.reveal').forEach((el, i) => {
      setTimeout(() => el.classList.add('in'), i * 80);
    });
  }, 50);

  window.scrollTo({ top: 0, behavior: 'smooth' });
}
