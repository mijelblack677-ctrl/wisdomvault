// RATE LIMITER
// ============================================================
function rateLimit(fn, delay = CONFIG.RATE_LIMIT_DELAY) {
  let lastCall = 0;
  let timeoutId = null;
  
  return function(...args) {
    const now = Date.now();
    if (now - lastCall < delay) {
      window.showToast(ICON.clock + ' Please wait a moment before trying again');
      if (timeoutId) clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        lastCall = now;
        fn.apply(this, args);
      }, delay - (now - lastCall));
      return;
    }
    lastCall = now;
    fn.apply(this, args);
  };
}
