// Toggle notification dropdown
window.toggleNotif = function() {
  const dropdown = document.getElementById('notifDrop');
  if (!dropdown) return;
  
  const isOpen = dropdown.style.display === 'block';
  dropdown.style.display = isOpen ? 'none' : 'block';
  
  if (!isOpen) {
    // Instantly render cached notifications, then fetch fresh
    if (globalNotifCache && globalNotifCache.length > 0) {
      renderNotifications(globalNotifCache);
    }
    fetchNotifications();
  }
};

// Mark notification as read
window.markNotificationRead = async function(id, link) {
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  if (!user.id) return;
  
  try {
    // Instantly decrement badge count
    const badge = document.getElementById('badge');
    if (badge && badge.style.display !== 'none') {
      const current = parseInt(badge.textContent) || 0;
      if (current > 0) updateBadge(current - 1);
    }
    
    await fetch('/api/notifications', {
      method: 'PUT',
      headers: authHeaders(),
      body: JSON.stringify({ userId: user.id, notificationIds: [id] })
    });
    invalidateFor('/notifications');
    
    fetchNotifications();
    
    const dropdown = document.getElementById('notifDrop');
    if (dropdown) dropdown.style.display = 'none';
    
    if (link && link !== '#') window.location.href = link;
  } catch (err) {
    console.error('Error marking notification read:', err);
  }
};

// Mark all as read
window.markAll = function() {
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  if (!user.id) return;
  
  // Instantly clear the badge
  updateBadge(0);
  
  fetch('/api/notifications', {
    method: 'PUT',        headers: authHeaders(),
    body: JSON.stringify({ userId: user.id, notificationIds: [] })
  })
  .then(() => {
    invalidateFor('/notifications');
    fetchNotifications();
    window.showToast('All notifications marked as read');
  })
  .catch(err => console.error('Error marking all read:', err));
};

// ============================================================
// INIT NOTIFICATIONS - WITH EVENT CLEANUP
// ============================================================
function initNotifications() {
  const bell = document.getElementById('bell');
  if (!bell) return;

  // Remove old listeners to prevent duplicates
  const newBell = bell.cloneNode(true);
  bell.parentNode.replaceChild(newBell, bell);

  newBell.addEventListener('click', function(e) {
    e.stopPropagation();
    window.toggleNotif();
  });

  // Use a named function for the document click handler so we can remove it
  const handleDocumentClick = function(e) {
    const bellEl = document.getElementById('bell');
    const dropdown = document.getElementById('notifDrop');
    if (bellEl && dropdown && !bellEl.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.style.display = 'none';
    }
  };
  
  // Remove old listener if it exists
  document.removeEventListener('click', handleDocumentClick);
  document.addEventListener('click', handleDocumentClick);

  // Initial fetch with delay
  setTimeout(fetchNotifications, 500);
}
