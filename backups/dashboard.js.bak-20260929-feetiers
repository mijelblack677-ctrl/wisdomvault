// Update badge count
function updateBadge(count) {
  const badge = document.getElementById('badge');
  if (!badge) return;
  
  const prevCount = parseInt(badge.textContent) || 0;
  
  if (count > 0) {
    badge.style.display = 'flex';
    badge.textContent = count > 99 ? '99+' : count;
    // Play notification sound and show toast when new notifications arrive
    if (count > prevCount && prevCount >= 0) {
      playNotificationSound();
      showToast(ICON.mail + ' You have ' + (count === 1 ? 'a new notification' : count + ' new notifications'));
    }
  } else {
    badge.style.display = 'none';
  }
}

// Fetch notifications
let isFetchingNotifications = false;

async function fetchNotifications() {
  // Don't hit the server for hidden/background tabs — that was burning free
  // tier CPU. The visibilitychange listener above catches up on tab focus.
  if (document.hidden) return;

  // Prevent multiple simultaneous calls
  if (isFetchingNotifications) {
    return;
  }
  
  const user = JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}');
  if (!user.id) return;
  
  isFetchingNotifications = true;
  
  try {
    const data = await apiFetch('/notifications?userId=' + user.id);
    
    if (data.success) {
      updateBadge(data.unreadCount);
      
      // Always cache notifications for instant dropdown render
      globalNotifCache = data.notifications || [];
      
      const dropdown = document.getElementById('notifDrop');
      if (dropdown && dropdown.style.display === 'block') {
        renderNotifications(data.notifications);
      }
    }
  } catch (err) {
    console.error('Error fetching notifications:', err);
  } finally {
    isFetchingNotifications = false;
  }
}

