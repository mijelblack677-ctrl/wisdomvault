function buildCategoryFilters() {
  const filtersContainer = document.getElementById('courses-filters');
  if (!filtersContainer) return;

  const categories = ['all'];
  coursesData.forEach(c => { if (c.category && categories.indexOf(c.category) === -1) categories.push(c.category); });

  filtersContainer.innerHTML = categories.map((cat, idx) => 
    `<button class="courses-filter-chip${idx === 0 ? ' active' : ''}" data-category="${cat}" style="padding:6px 16px;background:${idx === 0 ? '#2d2327' : 'rgba(45,35,39,0.05)'};color:${idx === 0 ? '#ffffff' : '#2d2327'};border:none;border-radius:100px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;flex-shrink:0;">${cat === 'all' ? 'All Courses' : cat}</button>`
  ).join('');

  filtersContainer.querySelectorAll('.courses-filter-chip').forEach(chip => {
    chip.addEventListener('click', function(e) {
      e.stopPropagation();
      filtersContainer.querySelectorAll('.courses-filter-chip').forEach(c => {
        c.classList.remove('active');
        c.style.background = 'rgba(45,35,39,0.05)';
        c.style.color = '#2d2327';
      });
      this.classList.add('active');
      this.style.background = '#2d2327';
      this.style.color = '#ffffff';
      coursesCurrentFilter = this.dataset.category;
      applyCoursesFilters();
    });
  });
}

function applyCoursesFilters() {
  coursesFilteredData = coursesData.filter(course => {
    if (coursesCurrentTab === 'my-courses') return course.owned;
    return true;
  });

  if (coursesCurrentFilter !== 'all') {
    coursesFilteredData = coursesFilteredData.filter(course => course.category === coursesCurrentFilter);
  }

  if (coursesSearchQuery) {
    const q = coursesSearchQuery.toLowerCase();
    coursesFilteredData = coursesFilteredData.filter(course => 
      course.title.toLowerCase().includes(q) || (course.instructor && course.instructor.toLowerCase().includes(q))
    );
  }

  renderCoursesGrid();
}

