// ------------------------------------------------------------
// BOOK READER
// ------------------------------------------------------------
// Every book is served through /api/content/read/<id>, which streams the file
// from wherever it is hosted. That matters for two reasons: the upstream link
// (usually a Google Drive URL) is never handed to the browser, and Drive's
// /view page refuses to load inside a frame, so pointing an iframe straight at
// it just showed "Access denied".
//
// Google Drive supplies most of the library, and it cannot preview a .docx or
// an .epub at all, so those are turned into text server-side and laid out here —
// which is also why the text size and theme controls actually do something.

const READER_THEMES = {
  light: { bg: '#faf7f4', fg: '#2d2327', bar: '#ffffff' },
  sepia: { bg: '#f3ead7', fg: '#3b2f21', bar: '#ece0c6' },
  dark:  { bg: '#14110f', fg: '#e9e3dc', bar: '#1d1917' },
};
const READER_THEME_ORDER = ['light', 'sepia', 'dark'];
const READER_FONT_MIN = 14;
const READER_FONT_MAX = 26;

const readerState = {
  id: null,
  kind: 'unknown',
  textMode: false,
  theme: 'light',
  fontSize: 18,
  onScroll: null,
  // 'text' | 'pdf' | 'embed' | 'media' — decides what the toolbar controls do.
  mode: null,
  pdf: null,
};

function readerPrefGet(key, fallback) {
  try {
    const v = localStorage.getItem('wv_reader_' + key);
    return v === null ? fallback : v;
  } catch (e) { return fallback; }
}
function readerPrefSet(key, value) {
  try { localStorage.setItem('wv_reader_' + key, value); } catch (e) {}
}

function readerEscape(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/** Apply the current theme to the whole reader shell. */
function applyReaderTheme(name) {
  const theme = READER_THEMES[name] || READER_THEMES.light;
  readerState.theme = READER_THEMES[name] ? name : 'light';
  const modal = document.getElementById('reader-modal');
  const toolbar = document.getElementById('reader-toolbar');
  const footer = document.getElementById('reader-footer');
  const content = document.getElementById('reader-content');
  if (modal) { modal.style.background = theme.bg; modal.style.color = theme.fg; }
  if (toolbar) toolbar.style.background = theme.bar;
  if (footer) footer.style.background = theme.bar;
  if (content) content.style.color = theme.fg;
}

function applyReaderFontSize() {
  const content = document.getElementById('reader-content');
  const article = document.getElementById('reader-article');
  if (article) article.style.fontSize = readerState.fontSize + 'px';
  else if (content) content.style.fontSize = readerState.fontSize + 'px';
}

/** Talk to the book proxy directly. Not apiFetch: a cached GET would skip the
    Set-Cookie that authorises the iframe, and the body is streamed, not JSON. */
async function readerFetch(id, mode) {
  const token = localStorage.getItem('wisdom_vault_session');
  const res = await fetch(`${CONFIG.API_BASE}/content/read/${encodeURIComponent(id)}${mode ? '?mode=' + mode : ''}`, {
    headers: token ? { Authorization: 'Bearer ' + token } : {},
    credentials: 'include',
  });
  let data = null;
  try { data = await res.json(); } catch (e) { /* non-JSON error body */ }
  if (!res.ok || !data || !data.success) {
    const message = (data && data.message) || (res.status === 401
      ? 'Please sign in again to read this book.'
      : 'This book could not be opened.');
    throw new Error(message);
  }
  return data;
}

function readerShellHTML(inner) {
  return `<div style="max-width:760px;margin:0 auto;padding:28px 22px 70px;">${inner}</div>`;
}

function readerMessageHTML(title, detail, icon) {
  return readerShellHTML(`
    <div style="text-align:center;padding:70px 10px;">
      <div style="margin-bottom:14px;opacity:0.5;">${icon || ICON.book}</div>
      <h3 style="font-size:17px;font-weight:700;margin-bottom:6px;">${readerEscape(title)}</h3>
      <p style="font-size:13px;opacity:0.7;line-height:1.6;">${readerEscape(detail || '')}</p>
    </div>`);
}

function readerBlockHTML(block) {
  const text = readerEscape(block.text).replace(/\n/g, '<br>');
  switch (block.type) {
    case 'h1': return `<h1 style="font-size:1.75em;font-weight:800;line-height:1.2;margin:1.7em 0 0.6em;">${text}</h1>`;
    case 'h2': return `<h2 style="font-size:1.38em;font-weight:700;line-height:1.3;margin:1.6em 0 0.5em;">${text}</h2>`;
    case 'h3': return `<h3 style="font-size:1.14em;font-weight:700;line-height:1.35;margin:1.4em 0 0.4em;">${text}</h3>`;
    case 'li': return `<div style="display:flex;gap:10px;margin:0 0 0.55em;padding-left:0.4em;"><span style="opacity:0.45;flex-shrink:0;">•</span><span>${text}</span></div>`;
    case 'quote': return `<blockquote style="margin:1.1em 0;padding-left:16px;border-left:3px solid currentColor;opacity:0.85;font-style:italic;">${text}</blockquote>`;
    default: return `<p style="margin:0 0 1.1em;line-height:1.75;text-align:justify;">${text}</p>`;
  }
}

/** Async entry point: work out the format, then render the right viewer. */
async function openLibraryReader(book) {
  if (!book) return;

  const isPremium = book.is_premium || book.isPremium;
  const isOwned = book.owned || book.is_owned;
  if (isPremium && !isOwned) {
    showToast(ICON.lock + ' This is premium content. Please purchase to access.');
    return;
  }

  const modal = document.getElementById('reader-modal');
  const content = document.getElementById('reader-content');
  const progress = document.getElementById('reader-progress');
  const progressBar = document.getElementById('reader-progress-bar');
  const downloadBtn = document.getElementById('reader-download-btn');
  const footer = document.getElementById('reader-footer');
  if (!modal || !content) return;

  document.getElementById('reader-modal-title').textContent = book.title || 'Untitled';
  document.getElementById('reader-modal-author').textContent = book.author || '';
  document.getElementById('reader-kind-badge').textContent = '';
  if (progress) progress.textContent = 'Loading…';
  if (progressBar) progressBar.style.width = '0%';
  if (downloadBtn) downloadBtn.style.display = 'none';

  // If a PDF was left open, release it before swapping in the next book.
  if (readerState.pdf) {
    try { readerState.pdf.destroy(); } catch (e) {}
    readerState.pdf = null;
  }

  readerState.id = book.id;
  readerState.textMode = false;
  readerState.mode = null;
  readerState.fontSize = parseInt(readerPrefGet('font_size', '18'), 10) || 18;
  applyReaderTheme(readerPrefGet('theme', 'light'));

  content.innerHTML = readerShellHTML(`
    <div style="text-align:center;padding:80px 10px;opacity:0.7;">
      <div style="width:26px;height:26px;border:3px solid rgba(128,128,128,0.25);border-top-color:currentColor;border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 14px;"></div>
      <div style="font-size:13px;">Opening book…</div>
    </div>`);

  modal.style.display = 'block';
  document.body.style.overflow = 'hidden';

  try {
    // mode=meta also installs the media cookie the iframe will need.
    const meta = await readerFetch(book.id, 'meta');
    readerState.kind = meta.kind;
    readerState.textMode = !!meta.textMode;
    document.getElementById('reader-kind-badge').textContent = meta.label || '';

    if (downloadBtn) {
      downloadBtn.style.display = 'flex';
      downloadBtn.href = `${CONFIG.API_BASE}/content/read/${encodeURIComponent(book.id)}`;
      downloadBtn.setAttribute('download', meta.title || book.title || 'book');
    }

    if (meta.textMode) {
      await renderReaderText(book, meta);
    } else if (meta.kind === 'video' || meta.kind === 'audio') {
      readerState.mode = 'media';
      renderReaderMedia(book, meta);
    } else if (meta.kind === 'pdf') {
      // Rendered by pdf.js so it works on mobile; falls back to the browser's
      // own viewer if pdf.js can't be loaded for any reason.
      await renderReaderPdf(book, meta);
    } else {
      readerState.mode = 'embed';
      renderReaderEmbed(book, meta);
    }
    applyReaderNavMode();

    if (footer) footer.style.display = '';
  } catch (err) {
    if (footer) footer.style.display = 'none';
    content.innerHTML = readerMessageHTML('Could not open this book', err.message, ICON.alert);
  }

  addToContinueReading(book);
}

/** PDFs and anything the browser can display natively. */
function renderReaderEmbed(book, meta) {
  const content = document.getElementById('reader-content');
  const progress = document.getElementById('reader-progress');
  const progressBar = document.getElementById('reader-progress-bar');
  const src = `${CONFIG.API_BASE}/content/read/${encodeURIComponent(book.id)}`;

  content.style.padding = '0';
  content.innerHTML = `<iframe src="${src}" title="${readerEscape(book.title || 'Book')}"
      style="width:100%;height:100%;border:none;background:#fff;" allowfullscreen></iframe>`;

  // The document lives inside the frame, so we cannot know its scroll position.
  // Showing a fake "0% complete" would be worse than showing nothing.
  if (progress) progress.textContent = meta.size
    ? (meta.size / 1048576).toFixed(1) + ' MB · ' + (meta.label || '')
    : (meta.label || '');
  if (progressBar) progressBar.style.width = '0%';
}

/**
 * PDFs, drawn page by page with pdf.js.
 *
 * The browser's built-in viewer works on desktop but not on phones — iOS
 * Safari gives an iframe nothing and Android often offers a download instead.
 * Rendering the pages ourselves also gives a real page count, so the reading
 * position can be saved and resumed.
 */
async function renderReaderPdf(book, meta) {
  const content = document.getElementById('reader-content');
  const progress = document.getElementById('reader-progress');
  const progressBar = document.getElementById('reader-progress-bar');
  const src = `${CONFIG.API_BASE}/content/read/${encodeURIComponent(book.id)}`;

  content.style.padding = '0';
  content.innerHTML = readerShellHTML(`
    <div style="text-align:center;padding:70px 10px;opacity:0.7;">
      <div style="width:26px;height:26px;border:3px solid rgba(128,128,128,0.25);border-top-color:currentColor;border-radius:50%;animation:spin 0.8s linear infinite;margin:0 auto 14px;"></div>
      <div style="font-size:13px;">Preparing document…</div>
    </div>`);

  const startPage = parseInt(readerPrefGet('page_' + book.id, '1'), 10) || 1;

  try {
    readerState.pdf = await openPdfViewer({
      container: content,
      url: src,
      startPage,
      onProgress: ({ page, total }) => {
        const pct = total > 0 ? Math.min(100, Math.round((page / total) * 100)) : 0;
        if (progress) progress.textContent = `Page ${page} of ${total} · ${pct}%`;
        if (progressBar) progressBar.style.width = pct + '%';
        readerPrefSet('page_' + book.id, String(page));

        const idx = libraryContinueReading.findIndex(b => b.id == book.id);
        if (idx > -1) {
          libraryContinueReading[idx].progress = pct;
          libraryContinueReading[idx].lastRead = Date.now();
          try { localStorage.setItem('wv_continue_reading', JSON.stringify(libraryContinueReading)); } catch (e) {}
        }
      },
    });
    readerState.mode = 'pdf';
    if (startPage > 1) showToast('Resuming from page ' + startPage);
  } catch (err) {
    // pdf.js unavailable or the file could not be parsed — hand it to the
    // browser's own viewer rather than showing nothing.
    console.warn('pdf.js unavailable, falling back to the browser viewer:', err);
    readerState.mode = 'embed';
    renderReaderEmbed(book, meta);
    return;
  }
}

