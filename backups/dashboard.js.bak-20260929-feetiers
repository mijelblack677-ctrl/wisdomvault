// ============================================================
// API HELPER WITH RETRY
// ============================================================
// JSON headers plus the session token when available — for the few direct
// fetch() calls that don't go through apiFetch.
function authHeaders(extra = {}) {
  const headers = { 'Content-Type': 'application/json', ...extra };
  const token = localStorage.getItem('wisdom_vault_session');
  if (token) headers['Authorization'] = `Bearer ${token}`;
  return headers;
}

async function apiFetch(endpoint, options = {}, retries = CONFIG.MAX_RETRIES) {
  const headers = {
    'Content-Type': 'application/json',
    'Accept': 'application/json',
  };
  // Attach the real session token when available so money endpoints can
  // authenticate the actual logged-in user instead of a client-supplied id.
  const sessionToken = localStorage.getItem('wisdom_vault_session');
  if (sessionToken) headers['Authorization'] = `Bearer ${sessionToken}`;

  const defaultOptions = { headers, credentials: 'include' };
  
  const mergedOptions = { ...defaultOptions, ...options };
  // Always keep the session token + JSON headers even if the caller passed headers
  mergedOptions.headers = { ...headers, ...(options.headers || {}) };

  const method = (options.method || 'GET').toUpperCase();
  // Cache reads only. Writes always hit the server — and invalidate caches.
  const isRead = method === 'GET';
  const userId = (() => { try { return (JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}').id) || ''; } catch (e) { return ''; } })();

  // Serve a fresh cache hit without touching the server.
  if (isRead) {
    const hit = cacheGet(endpoint, userId);
    if (hit !== undefined) return hit;
  }
  
  try {
    const response = await fetch(`${CONFIG.API_BASE}${endpoint}`, mergedOptions);
    
    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}));
      const err = new Error(errorData.message || `HTTP ${response.status}: ${response.statusText}`);
      // 4xx are client errors (rate limit 429, auth 401, validation 400, etc.).
      // Retrying them is pointless — e.g. a 429 rate limit will NOT clear in a
      // few seconds — and for money endpoints it can double-submit. Only retry
      // transient failures: network errors and 5xx server errors.
      err.status = response.status;
      err.isHttpError = true;
      throw err;
    }
    
    const data = await response.json();
    // Reads: remember the payload so the next identical request is a cache hit.
    if (isRead) cacheSet(endpoint, userId, data);
    // Writes: the data just changed — drop every cached read it affects.
    if (!isRead) invalidateFor(endpoint);
    return data;
  } catch (error) {
    // Network failure / 5xx: fall back to any cached copy instead of failing
    // the whole UI for a transient blip (and skip the pointless retry calls).
    if (isRead) {
      const stale = cacheGetStale(endpoint, userId);
      if (stale !== undefined) return stale;
    }
    const isTransient = !error.isHttpError || (error.status >= 500 && error.status <= 599);
    if (retries > 0 && isTransient) {
      console.warn(`Retrying ${endpoint}... (${retries} attempts left)`);
      await new Promise(resolve => setTimeout(resolve, CONFIG.RETRY_DELAY));
      return apiFetch(endpoint, options, retries - 1);
    }
    if (!isTransient) {
      // Rate limit / auth / validation errors surface immediately — no retry spam
      console.warn(`Request failed (${error.status || 'network'}): ${error.message}`);
    } else {
      console.error(`API Error (${endpoint}):`, error);
    }
    throw error;
  }
}

