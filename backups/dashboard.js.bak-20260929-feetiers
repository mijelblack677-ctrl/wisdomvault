        removeOverlay();
        if (window.showToast) window.showToast(toastMsg);
      }, 2600);
    }
  }

  function updateModal(s, isFinal) {
    currentStatus = s;
    const title = document.getElementById('wds-title');
    const msg = document.getElementById('wds-msg');
    const st = document.getElementById('wds-status');
    const iconWrap = document.getElementById('wds-icon-wrap');
    if (title) title.textContent = s === 'completed' ? 'Withdrawal Successful!' : s === 'failed' || s === 'rejected' ? 'Withdrawal Failed' : 'Withdrawal Submitted!';
    if (msg) msg.textContent = statusText(s);
    if (st) { st.textContent = statusText(s); st.style.color = statusColor(s); }
