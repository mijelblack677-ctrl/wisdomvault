  // Count the view (fire-and-forget)
  try {
    const token = localStorage.getItem('wisdom_vault_session');
    fetch(CONFIG.API_BASE + '/user/vacancies', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...(token ? { 'Authorization': 'Bearer ' + token } : {}) },
      body: JSON.stringify({ id }),
    }).catch(() => {});
  } catch (e) { /* ignore */ }
};

window.closeVacancyView = function() {
  const overlay = document.getElementById('vacancy-view-overlay');
  if (overlay) overlay.style.display = 'none';
};

// ============================================================
// WHATSAPP CLASS GROUPS POPUP (admin-managed)
// Shows active 1-on-1 class groups to every signed-in user.
// Re-surfaces when a group is added or edited (updated_at bump);
// dismissal is remembered per user in localStorage.
// ============================================================
(function initWhatsAppGroupsPopup() {
  'use strict';

  const POLL_MS = 60 * 1000;

  function currentUserId() {
    try { return JSON.parse(localStorage.getItem('wisdom_vault_user') || '{}').id || 'anon'; }
    catch (e) { return 'anon'; }
  }
  function seenKey() { return 'wv_group_versions_seen_' + currentUserId(); }

  function getSeen() {
    try { return JSON.parse(localStorage.getItem(seenKey()) || '{}'); }
    catch (e) { return {}; }
  }
  function setSeen(map) {
    try { localStorage.setItem(seenKey(), JSON.stringify(map)); } catch (e) {}
  }

  function popupStyles() {
    if (document.getElementById('wv-groups-style')) return;
    const st = document.createElement('style');
    st.id = 'wv-groups-style';
    st.textContent = `
      #wv-groups-overlay{position:fixed;inset:0;background:rgba(45,35,39,0.85);z-index:900;display:flex;align-items:center;justify-content:center;padding:20px;font-family:'Clash Display',Inter,sans-serif;}
      #wv-groups-card{background:#fffdf9;border:1px solid rgba(45,35,39,0.12);border-radius:20px;max-width:440px;width:100%;max-height:82vh;overflow-y:auto;padding:28px;color:#2d2327;box-shadow:0 24px 64px rgba(0,0,0,0.35);}
      #wv-groups-card h2{font-size:21px;margin:0 0 6px;}
      #wv-groups-card .wv-sub{font-size:13px;color:#5a4a4a;margin-bottom:18px;}
      .wv-group{border:1px solid rgba(45,35,39,0.1);border-radius:14px;padding:14px;margin-bottom:12px;background:#ffffff;}
      .wv-group .wv-gname{font-weight:700;font-size:15px;margin-bottom:2px;}
      .wv-group .wv-gdesc{font-size:12.5px;color:#5a4a4a;margin-bottom:10px;}
      .wv-join{display:inline-block;padding:10px 18px;border-radius:10px;background:#25D366;color:#fff;font-weight:700;font-size:13px;text-decoration:none;}
      #wv-groups-dismiss{display:block;width:100%;margin-top:6px;padding:12px;background:transparent;border:1px solid rgba(45,35,39,0.15);color:#5a4a4a;border-radius:12px;font-size:14px;cursor:pointer;}
    `;
    document.head.appendChild(st);
  }

  function escapeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] || c
    ));
  }

  // Fire-and-forget click tracking — must never break the popup flow.
  function trackClick(groupId) {
    try {
      const token = localStorage.getItem('wisdom_vault_session') || '';
      if (!token) return;
      fetch('/api/whatsapp-groups/click', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ groupId: Number(groupId) }),
        keepalive: true, // survive the tab handing off to WhatsApp
      }).catch(() => {});
    } catch (e) {}
  }

  function showPopup(groups) {
    popupStyles();
    if (document.getElementById('wv-groups-overlay')) return;

    const overlay = document.createElement('div');
    overlay.id = 'wv-groups-overlay';
    overlay.innerHTML = `
      <div id="wv-groups-card" role="dialog" aria-modal="true" aria-label="Class groups">
        <h2>📚 Join Your Class Groups</h2>
        <div class="wv-sub">Your 1-on-1 classes have started. Join the group(s) below to attend.</div>
        ${groups.map((g) => `
          <div class="wv-group">
            <div class="wv-gname">${escapeHtml(g.name)}</div>
            ${g.description ? `<div class="wv-gdesc">${escapeHtml(g.description)}</div>` : ''}
            <a class="wv-join" href="${escapeHtml(g.link)}" target="_blank" rel="noopener noreferrer" data-gid="${g.id}">Join on WhatsApp →</a>
          </div>`).join('')}
        <button id="wv-groups-dismiss">I've joined — don't show again</button>
      </div>`;

    overlay.querySelectorAll('.wv-join[data-gid]').forEach((a) => {
      a.addEventListener('click', () => trackClick(a.getAttribute('data-gid')));
    });

    overlay.querySelector('#wv-groups-dismiss').addEventListener('click', () => {
      const seen = getSeen();
      groups.forEach((g) => { seen[g.id] = g.updated_at; });
      setSeen(seen);
      overlay.remove();
    });

    document.body.appendChild(overlay);
  }

  function unseenGroups(groups) {
    const seen = getSeen();
    return (groups || []).filter((g) => seen[g.id] !== g.updated_at);
  }

  async function checkGroups() {
    if (document.hidden) return; // background tabs stay quiet
    if (!localStorage.getItem('wisdom_vault_user')) return; // signed out
    try {
      const res = await fetch('/api/whatsapp-groups', { headers: { Accept: 'application/json', Authorization: 'Bearer ' + (localStorage.getItem('wisdom_vault_session') || '') } });
      if (res.status === 401 || res.status === 403) return; // signed out or unpaid — stay quiet
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.success && Array.isArray(data.groups) && data.groups.length) {
        const unseen = unseenGroups(data.groups);
        if (unseen.length) showPopup(unseen);
      }
    } catch (e) { /* silent — never break the dashboard */ }
  }

  // Kick off shortly after dashboard boot, then poll.
  setTimeout(checkGroups, 4000);
  setInterval(checkGroups, POLL_MS);
})();
