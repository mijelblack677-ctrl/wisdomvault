// ============================================================
// VERCEL PROTECTION BYPASS - MONKEY PATCH
// ============================================================

const VERCEL_BYPASS_SECRET = import.meta.env.PUBLIC_VERCEL_BYPASS_SECRET || '';

// Save original fetch
const originalFetch = window.fetch;

// Override fetch to always include the bypass header.
//
// `input` is not always a string — libraries may pass a Request or a URL
// object, and calling .includes() on one of those throws a TypeError. That
// broke pdf.js outright (it fetches the book through a Request), and the error
// surfaced inside pdf.js as an unrelated "e.includes is not a function" when
// this file is minified. Only the path test needs a string; the original value
// is handed to the real fetch untouched.
window.fetch = function(input, options = {}) {
    const requestUrl = typeof input === 'string'
        ? input
        : (input && typeof input.url === 'string' ? input.url : String(input));

    // Don't add bypass for login/register/public pages
    const publicPaths = ['/login', '/register', '/', '/api/auth/login', '/api/auth/register', '/api/public/'];
    if (publicPaths.some(path => requestUrl.includes(path))) {
        return originalFetch(input, options);
    }

    // If no bypass secret is configured, skip the header entirely
    if (!VERCEL_BYPASS_SECRET) {
        return originalFetch(input, options);
    }

    // Add bypass header to all other requests
    return originalFetch(input, {
        ...options,
        headers: {
            ...options.headers,
            'Content-Type': 'application/json',
            'x-vercel-protection-bypass': VERCEL_BYPASS_SECRET
        }
    });
};
