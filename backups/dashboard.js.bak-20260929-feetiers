  // 7. Direct Video Files (MP4, WebM, MOV, etc.)
  const videoExtensions = ['.mp4', '.webm', '.mov', '.avi', '.mkv', '.m4v', '.ogv', '.3gp'];
  if (videoExtensions.some(ext => link.toLowerCase().includes(ext))) {
    player.innerHTML = `
