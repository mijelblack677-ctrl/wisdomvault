  // Poll until completed/failed so the screen reflects the real outcome.
  // PayChangu settles these payouts in ~2 seconds, so a handful of quick polls
  // is plenty — the old 20 attempts / ~2 minutes of polling was pure CPU waste
  // on Vercel's free tier (each poll is a full serverless invocation).
  function pollStatus() {
    if (modalState.done || !withdrawalId) return;
    if (document.hidden) { modalState.pollTimer = setTimeout(pollStatus, 8000); return; }
    if (modalState.attempts >= 8) { // ~40 seconds max
      modalState.done = true;
      const st = document.getElementById('wds-status');
      const doneBtnEl = document.getElementById('wds-done');
      if (st) st.textContent = 'Still processing — we will notify you once your money is sent.';
      if (doneBtnEl) doneBtnEl.disabled = false;
      return;
    }
    modalState.attempts++;

    const qs = userId ? `?userId=${encodeURIComponent(userId)}&withdrawalId=${withdrawalId}` : `?withdrawalId=${withdrawalId}`;
    apiFetch(`/wallet/withdrawal-status${qs}`)
      .then(res => {
        if (!res || !res.success || !res.withdrawals || res.withdrawals.length === 0) return;
        const w = res.withdrawals[0];
        if (w.status === 'completed' || w.status === 'failed' || w.status === 'rejected') {
          updateModal(w.status, true);
        } else {
          modalState.pollTimer = setTimeout(pollStatus, 4000);
        }
      })
      .catch(err => {
        const msg = (err && err.message) || '';
        if (/401|unauthorized|session/i.test(msg)) {
          // Auth problem — stop polling, let the user leave the modal
          modalState.done = true;
          const doneBtnEl = document.getElementById('wds-done');
          if (doneBtnEl) doneBtnEl.disabled = false;
          const st = document.getElementById('wds-status');
          if (st) st.textContent = 'Processing — we will notify you once your money is sent.';
          if (typeof handleSessionExpired === 'function') handleSessionExpired();
          return;
        }
        modalState.pollTimer = setTimeout(pollStatus, 4000);
      });
  }

  // Terminal status already known (e.g. PayChangu settled instantly): show the
  // final result, refresh the page behind it and auto-close shortly.
  if (status === 'completed' || status === 'failed' || status === 'rejected') {
    updateModal(status, true);
  } else if ((status === 'processing' || status === 'pending') && isAuto) {
    // Hold the user on this screen until the auto-payout resolves so they
    // actually SEE the success/failure instead of a stale 'processing' state.
    if (doneBtn) doneBtn.disabled = true;
    modalState.pollTimer = setTimeout(pollStatus, 3000);
  }
}
