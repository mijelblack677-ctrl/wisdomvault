      link.includes('mp3.pm') ||
      link.includes('mp3') ||
      link.match(/\.(mp3|wav|ogg|m4a|aac|flac|wma|alac)$/i) ||
      link.match(/download\/.*\.mp3/i)) {
    
    // Extract filename for display
    const filename = link.split('/').pop() || 'audio';
