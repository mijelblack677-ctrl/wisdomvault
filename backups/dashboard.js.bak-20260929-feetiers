  if (link.includes('youtube.com') || link.includes('youtu.be')) {
    const vid = link.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/|live\/)|youtu\.be\/)([^&\n?#]+)/)?.[1];
    if (vid) {
