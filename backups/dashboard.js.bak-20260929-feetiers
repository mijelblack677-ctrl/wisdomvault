  empty.style.display = 'none';
  updateCoursesCount(coursesFilteredData.length);

  grid.innerHTML = coursesFilteredData.map(course => {
    // Use proper field names
    const courseName = course.name || course.title || 'Untitled Course';
    const thumbnail = course.thumbnailUrl || course.thumbnail || getPackImage(course.slug || course.id);
    const isOwned = course.isOwned || course.owned || false;
