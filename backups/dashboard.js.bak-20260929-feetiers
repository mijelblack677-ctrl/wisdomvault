// ============================================================
// GLASS TILT EFFECT (Throttled)
// ============================================================
function initGlassTilt() {
  if ('ontouchstart' in window || navigator.maxTouchPoints > 0) return;
  document.querySelectorAll('.glass:not(.no-tilt)').forEach(card => {
    const throttledTilt = throttle(function(e) {
      let rect = card.getBoundingClientRect();
      let x = e.clientX - rect.left;
      let y = e.clientY - rect.top;
      let cx = rect.width / 2;
      let cy = rect.height / 2;
      let rx = (y - cy) / 15;
      let ry = (cx - x) / 15;
      card.style.transform = `perspective(1000px) rotateX(${rx}deg) rotateY(${ry}deg)`;
    }, 50);

    card.addEventListener('mousemove', throttledTilt);
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';
    });
  });
}

// ============================================================
// ROBOT FOLLOW (Throttled)
// ============================================================
function initRobotFollow() {
  let robot = document.getElementById('robot');
  if (!robot) return;

  const throttledMove = throttle(function(e) {
    let rect = robot.getBoundingClientRect();
    let dx = (e.clientX - (rect.left + 32)) / 18;
    let dy = (e.clientY - (rect.top + 32)) / 18;
    robot.style.transform = `translate(${dx}px,${dy}px) rotate(${dx*0.8}deg)`;
  }, 50);

  document.addEventListener('mousemove', throttledMove);

  robot.addEventListener('click', () => {
    robot.style.animation = 'none';
    robot.offsetHeight;
    robot.style.animation = 'bob 0.2s ease-in-out 3 alternate';
    setTimeout(() => robot.style.animation = 'bob 1.5s ease-in-out infinite alternate', 600);
    window.showToast('Robot vibing • music on');
  });
}

