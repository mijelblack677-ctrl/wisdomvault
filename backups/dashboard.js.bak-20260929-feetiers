  document.getElementById('earn-countdown').textContent = totalTime;
  
  // Update the progress circle max value
  const circle = document.getElementById('earn-progress');
  const circumference = 2 * Math.PI * 27; // r=27
  circle.style.strokeDasharray = circumference;
  circle.style.strokeDashoffset = circumference;
  
  const player = document.getElementById('earn-modal-player');
  
  // If no link or link is empty, show a placeholder
  if (!link || link === '') {
    player.innerHTML = `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#2d2327;color:#ffffff;padding:20px;text-align:center;flex-direction:column;">
